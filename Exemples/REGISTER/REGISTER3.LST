0BF078                   	;---------------------------------------------------------------------------
0BF078                   	;	VERIFICATIONS A L'ASSEMBLAGE
0BF078                   	;
0BF078                   	;	Elles n'emettent aucun octet : elles ne font qu'interrompre
0BF078                   	;	l'assemblage si une hypothese du programme cesse d'etre vraie.
0BF078                   	;---------------------------------------------------------------------------
0BF078                   	;
0BF078                   	; La table contient attr, p0..p62 et le terminateur -1, soit 65 entrees de
0BF078                   	; 3 octets. Si ce total change sans que ce soit voulu, c'est qu'une entree a
0BF078                   	; ete ajoutee ou perdue par megarde.
0BF078                   		assert	modify_end_tbl-modify_table = 65*3,'table de relocation : nombre d entrees inattendu'
0BF078                   	;
0BF078                   	; Chaque point de relocation doit se trouver a l'interieur du pilote : un pN
0BF078                   	; hors bloc serait corrige a tort lors de la copie.
0BF078                   		assert	p0 >= block_top,'p0 hors du bloc pilote'
0BF078                   		assert	p62 < block_bottom,'p62 hors du bloc pilote'
