0BE1B1                   	;-----------------------------------------------------------
0BE1B1                   	;       DESINSTALLATEUR  (CALL &BE000 -u)
0BE1B1                   	;
0BE1B1                   	;  Defait ce que l'installation a fait : delie le device de la chaine et
0BE1B1                   	;  restaure le vecteur clavier depuis la copie sauvegardee dans le pilote.
0BE1B1                   	;  Verifie d'abord etre au SOMMET de la pile de hooks (le vecteur clavier
0BE1B1                   	;  pointe-t-il encore vers NOTRE handler ?) : sinon un pilote a ete charge
0BE1B1                   	;  ensuite et le retrait casserait sa chaine -> refus propre.
0BE1B1                   	;-----------------------------------------------------------
0BE1B1                   	uninstall:
0BE1B1 0C 46 E2 0B       		mv	x,msg_un
0BE1B5 0D 13 00 00       		mv	y,btm_un-msg_un
0BE1B9 30 CC D6 00       		mv	(cl),0
0BE1BD 09 04             		mv	il,4
0BE1BF 05 E4 FF 0F       		callf	fcs_call
0BE1C3                   	;  chercher notre device dans la chaine, en gardant le predecesseur
0BE1C3 0D A2 FC 0B       		mv	y,d_link		; y = emplacement du pointeur vers l'en-tete courant
0BE1C7                   	un_find:
0BE1C7 94 05             		mv	x,[y]
0BE1C9 6C 04             		inc	x
0BE1CB 18 65             		jrz	un_notfound		; -1 : fin de chaine, non trouve
0BE1CD 7C 04             		dec	x
0BE1CF 30 A4 0A          		mv	(10),x			; (10) = en-tete courant
0BE1D2 30 A5 0D          		mv	(13),y			; (13) = predecesseur (emplacement du pointeur)
0BE1D5 09 08             		mv	il,8
0BE1D7 45 41             		add	x,il			; x = en-tete + 8 = nom de device
0BE1D9 0D 98 E2 0B       		mv	y,drv_str
0BE1DD 09 04             		mv	il,4
0BE1DF 05 42 E1 0B       		callf	stricmp
0BE1E3 30 84 0A          		mv	x,(10)
0BE1E6 30 85 0D          		mv	y,(13)
0BE1E9 18 04             		jrz	un_found
0BE1EB FD 54             		mv	y,x			; avancer : predecesseur = en-tete courant
0BE1ED 13 28             		jr	un_find
0BE1EF                   	un_found:
0BE1EF                   	;  x = notre en-tete ; (13) = predecesseur
0BE1EF                   	;  securite : le vecteur clavier pointe-t-il encore vers NOTRE int_entry ?
0BE1EF 0A 52 00          		mv	ba,int_entry-iocs_header
0BE1F2 45 42             		add	x,ba			; x = notre int_entry (dans la copie)
0BE1F4 8D CC FC 0B       		mv	y,[keyvct]
0BE1F8 4D 54             		sub	y,x
0BE1FA 1A 2C             		jrnz	un_notsafe		; non -> un autre pilote a hooke apres nous
0BE1FC                   	;  restaurer le vecteur clavier depuis la copie (save_vct)
0BE1FC 30 84 0A          		mv	x,(10)
0BE1FF 0A 79 04          		mv	ba,save_vct-iocs_header
0BE202 45 42             		add	x,ba			; x = save_vct (dans la copie)
0BE204 94 04             		mv	x,[x]			; x = vecteur clavier d'origine
0BE206 AC CC FC 0B       		mv	[keyvct],x
0BE20A                   	;  delier de la chaine : [predecesseur] = notre lien suivant
0BE20A 30 84 0A          		mv	x,(10)
0BE20D 94 04             		mv	x,[x]			; x = notre lien suivant (3 premiers octets de l'en-tete)
0BE20F 30 85 0D          		mv	y,(13)
0BE212 B4 05             		mv	[y],x
0BE214                   	;  succes
0BE214 0C 59 E2 0B       		mv	x,msg_ok
0BE218 0D 0E 00 00       		mv	y,btm_ok-msg_ok
