0BF085 72 E6 0B 77 E6 0B 	
0BF08B 7B E6 0B          	
0BF08E FF FF 0F          		dp	-1
0BF091                   	modify_end_tbl:
0BF091                   	;
0BF091                   	;---------------------------------------------------------------------------
0BF091                   	;	VERIFICATIONS A L'ASSEMBLAGE
0BF091                   	;
0BF091                   	;	Elles n'emettent aucun octet : elles ne font qu'interrompre
0BF091                   	;	l'assemblage si une hypothese du programme cesse d'etre vraie.
0BF091                   	;---------------------------------------------------------------------------
0BF091                   	;
0BF091                   	; La table contient attr, p0..p62 et le terminateur -1, soit 65 entrees de
0BF091                   	; 3 octets. Si ce total change sans que ce soit voulu, c'est qu'une entree a
0BF091                   	; ete ajoutee ou perdue par megarde.
0BF091                   		assert	modify_end_tbl-modify_table = 65*3,'table de relocation : nombre d entrees inattendu'
0BF091                   	;
0BF091                   	; Chaque point de relocation doit se trouver a l'interieur du pilote : un pN
0BF091                   	; hors bloc serait corrige a tort lors de la copie.
0BF091                   		assert	p0 >= block_top,'p0 hors du bloc pilote'
0BF091                   		assert	p62 < block_bottom,'p62 hors du bloc pilote'
0BF091                   		assert	attr >= block_top,'attr hors du bloc pilote'
0BF091                   	;
0BF091                   	; Le pilote est copie tel quel : sa taille doit rester non nulle et tenir dans
0BF091                   	; ce que l'installeur sait deplacer.
0BF091                   		assert	block_bottom > block_top,'taille du pilote nulle'
0BF091                   	;
0BF091                   		end

