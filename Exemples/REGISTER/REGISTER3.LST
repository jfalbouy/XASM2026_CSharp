000000                   	;===========================================================================
000000                   	;	REGISTER3.ASM - Register checker (modele DRIVER_TEMPLATE) for PC-E500/1480U
000000                   	;	d'apres REGISTER.ASM Ver 1.2, (c)1990,1992 E. Kako (JM2WGN)
000000                   	;
000000                   	;	Reecriture pour xasm2026-4. Le code machine emis est STRICTEMENT
000000                   	;	IDENTIQUE a celui de REGISTER.ASM : seules changent la lisibilite et
000000                   	;	les verifications faites a l'assemblage. Rien n'a ete reordonne, aucune
000000                   	;	instruction n'a ete remplacee.
000000                   	;
000000                   	;---------------------------------------------------------------------------
000000                   	;	COMMENT CE PROGRAMME FONCTIONNE
000000                   	;
000000                   	;	Il installe un pilote de peripherique ("REG:") dans la RAM systeme,
000000                   	;	puis rend la main. Une fois installe, SHIFT+CTRL affiche l'etat des
000000                   	;	registres du CPU par-dessus l'ecran courant.
000000                   	;
000000                   	;	Le pilote est ASSEMBLE ici a l'adresse 0BE000h, mais il est COPIE a
000000                   	;	une adresse determinee a l'execution. Toute instruction du pilote qui
000000                   	;	contient une adresse absolue doit donc etre corrigee apres la copie.
000000                   	;
000000                   	;	C'est le role de la table de relocation en fin de fichier : chaque
000000                   	;	etiquette pN designe une telle instruction, et l'installeur remplace
000000                   	;	les trois octets d'operande situes en pN+1 par l'adresse recalculee.
000000                   	;
000000                   	;	>>> PIEGE A CONNAITRE : ajouter dans le pilote une instruction portant
000000                   	;	>>> une adresse absolue OBLIGE a lui donner une etiquette pN et a
000000                   	;	>>> l'inscrire dans modify_table. L'oublier ne provoque aucune erreur
000000                   	;	>>> d'assemblage : le pilote s'installe et se plante a l'execution.
000000                   	;	>>> Une verification en fin de fichier compte les entrees de la table.
000000                   	;===========================================================================
000000                   	bl:	equ	0d4h
000000                   	bh:	equ	0d5h
000000                   	cl:	equ	0d6h
000000                   	ch:	equ	0d7h
000000                   	dl:	equ	0d8h
000000                   	dh:	equ	0d9h
000000                   	;
000000                   	s2_top:	equ	0bfc0fh		;top  of "S2:"
000000                   	s2_siz:	equ	0bfc12h		;size of "S2:"
000000                   	s1_top:	equ	0bfc15h		;top  of "S1:"
000000                   	s1_siz:	equ	0bfc18h		;size of "S1:"
000000                   	s1_btm:	equ	0bfcdeh		;bottom of "S1:"
000000                   	d_link:	equ	0bfca2h		;device link pointer
000000                   	baswrk:	equ	0bfd0eh		;BASIC WORK Address
000000                   	keyvct:	equ	0bfccch		;key interrupt vector
000000                   	;
000000                   	fcs_call:  equ	0fffe4h
000000                   	iocs_call: equ	0fffe8h
000000                   	;
000000                   	;--- Registres materiels ---------------------------------------------------
000000                   	ko_lo:	equ	0f0h		;sortie de balayage clavier, poids faible
000000                   	ko_hi:	equ	0f1h		;sortie de balayage clavier, poids fort
000000                   	ki_in:	equ	0f2h		;entree clavier
000000                   	imr_p:	equ	0fbh		;masque d'interruption (IMR)
000000                   	bp_p:	equ	0ech		;registre de base BP
000000                   	keym:	equ	04h		;bit KEY du masque d'interruption
000000                   	;
000000                   	;--- Controleur LCD --------------------------------------------------------
000000                   	lcd_cl:	equ	0a004h		;commande, moitie gauche
000000                   	lcd_dl:	equ	0a006h		;donnee,   moitie gauche
000000                   	lcd_cr:	equ	0a008h		;commande, moitie droite
000000                   	lcd_dr:	equ	0a00ah		;donnee,   moitie droite
000000                   	;
000000                   	;--- Emplacements BASIC ----------------------------------------------------
000000                   	text_ad: equ	0cbh		;adresse du bloc TEXT.BAS
000000                   	data_ad: equ	0ceh		;adresse du bloc DATA.BAS
000000                   	menu_vc: equ	0ffffdh		;vecteur de retour au MENU
000000                   	;
000000                   	;--- Marqueurs de bloc memoire ---------------------------------------------
000000                   	blk_id:	equ	0fbh		;identifiant de bloc de fichier
000000                   	;
000000                   	;--- Macros ----------------------------------------------------------------
000000                   	;
000000                   	; Depose un caractere dans le tampon d'ecran pointe par Y.
000000                   	;
000000                   	; Selectionne une colonne du clavier et laisse le resultat lisible en (ki_in).
000000                   	; Le NOP est un delai de stabilisation : ne pas le retirer.
000000                   	;
000000                   	;
0BE000                   		org	0be000h
0BE000                   	;
0BE000                   		pre_on
0BE000                   	;
0BE000                   	;-----------------------------------------------------------
0BE000                   	;       DEVICE-DRIVER INSTALLER
0BE000                   	;-----------------------------------------------------------
0BE000                   	;-----------------------------------------------------------
0BE000                   	;       DEVICE-DRIVER INSTALLER  (modele du template : ajout en fin)
0BE000                   	;-----------------------------------------------------------
0BE000                   	start:
0BE000                   	;  (0) lire l'argument de CALL : "-u" (ou "-U") lance la desinstallation,
0BE000                   	;      sinon on installe. La ligne de commande est en tete de la pile U.
0BE000 3C                		popu	x
0BE001 2C                		pushu	x
0BE002 90 24             	sc_arg:	mv	a,[x++]
0BE004 60 00             		cmp	a,0
0BE006 18 18             		jrz	sc_install
0BE008 60 0D             		cmp	a,0dh
0BE00A 18 14             		jrz	sc_install
0BE00C 60 2D             		cmp	a,'-'
0BE00E 1B 0E             		jrnz	sc_arg
0BE010 90 04             		mv	a,[x]
0BE012 60 75             		cmp	a,'u'
0BE014 18 06             		jrz	sc_uninst
0BE016 60 55             		cmp	a,'U'
0BE018 18 02             		jrz	sc_uninst
0BE01A 13 1A             		jr	sc_arg
0BE01C                   	sc_uninst:
0BE01C 3C                		popu	x
0BE01D 02 B1 E1          		jp	uninstall
0BE020                   	sc_install:
0BE020 3C                		popu	x
0BE021                   	;  (1) banniere
0BE021 0C 5D E1 0B       		mv	x,msg0
0BE025 0D 16 00 00       		mv	y,btm0-msg0
0BE029 30 CC D6 00       		mv	(cl),0
0BE02D 09 04             		mv	il,4
0BE02F 05 E4 FF 0F       		callf	fcs_call
0BE033                   	;  sauver le vecteur clavier et IMR (le pilote les restaure)
0BE033 8C CC FC 0B       		mv	x,[keyvct]
0BE037 AC 37 E7 0B       		mv	[save_vct],x
0BE03B 30 80 FB          		mv	a,(imr_p)
0BE03E A8 3A E7 0B       		mv	[save_imr],a
0BE042                   	;  (2) compacter S1: (regrouper l'espace libre en fin de zone)
0BE042 30 CC D6 06       		mv	(cl),6
0BE046 30 CC D7 00       		mv	(ch),0
0BE04A 0B 47 00          		mv	i,47h
0BE04D 05 E8 FF 0F       		callf	iocs_call
0BE051                   	;  (3) parcourir jusqu'a la FIN des blocs ; detecter un doublon par le nom
0BE051 8C 15 FC 0B       		mv	x,[s1_top]
0BE055 95 84 12          		mv	y,[x+12h]
0BE058 45 45             		add	x,y
0BE05A 90 04             	walk:	mv	a,[x]
0BE05C 60 FB             		cmp	a,blk_id
0BE05E 1A 15             		jrnz	walk_end
0BE060 0D 9C E2 0B       		mv	y,block_top
0BE064 09 0C             		mv	il,12
0BE066 2C                		pushu	x
0BE067 05 42 E1 0B       		callf	stricmp
0BE06B 3C                		popu	x
0BE06C 18 B6             		jrz	exit2
0BE06E 95 84 11          		mv	y,[x+11h]
0BE071 45 45             		add	x,y
0BE073 13 1B             		jr	walk
0BE075                   	walk_end:
0BE075 30 A4 0A          		mv	(10),x			; destination = fin des blocs (ajout en fin)
0BE078                   	;  (4) controle memoire : libre = bas_de_S1 - fin_des_blocs >= taille
0BE078 8D DE FC 0B       		mv	y,[s1_btm]
0BE07C 7C 05             		dec	y
0BE07E 4D 54             		sub	y,x
0BE080 30 A5 10          		mv	(16),y
0BE083 0D D5 0C 00       		mv	y,block_bottom-block_top
0BE087 30 D7 05 10       		cmpp	(16),y
0BE08B 1C A1             		jrc	exit3
0BE08D                   	;  (5) sauver le handler device #11 d'origine (pour le chainage de 'RG3:')
0BE08D 0C A2 FC 0B       		mv	x,d_link
0BE091 08 00             		mv	a,0
0BE093 A8 CB E2 0B       		mv	[iocs_found],a
0BE097 FD 54             	srch:	mv	y,x
0BE099 94 04             		mv	x,[x]
0BE09B 6C 04             		inc	x
0BE09D 18 16             		jrz	srch_end
0BE09F 7C 04             		dec	x
0BE0A1 90 84 03          		mv	a,[x+3]
0BE0A4 60 0B             		cmp	a,11
0BE0A6 1B 11             		jrnz	srch
0BE0A8 94 84 05          		mv	x,[x+5]
0BE0AB AC CC E2 0B       		mv	[iocs_eleven],x
0BE0AF 08 01             		mv	a,1
0BE0B1 A8 CB E2 0B       		mv	[iocs_found],a
0BE0B5                   	srch_end:
0BE0B5                   	;  (6) chainer le nouveau device en tete de la liste IOCS
0BE0B5 8C A2 FC 0B       		mv	x,[d_link]
0BE0B9 AC BE E2 0B       		mv	[header],x
0BE0BD 30 84 0A          		mv	x,(10)
0BE0C0 09 22             		mv	il,iocs_header-block_top
0BE0C2 45 41             		add	x,il
0BE0C4 AC A2 FC 0B       		mv	[d_link],x
0BE0C8                   	;  (7) relocation (mecanisme de REGISTER : site pN, l'installateur lit [pN+1])
0BE0C8 0C 71 EF 0B       		mv	x,modify_table
0BE0CC 95 24             	init_3:	mv	y,[x++]
0BE0CE 6C 05             		inc	y
0BE0D0 18 15             		jrz	modify_end
0BE0D2 2C                		pushu	x
0BE0D3 94 05             		mv	x,[y]
0BE0D5 2D                		pushu	y
0BE0D6 0D 9C E2 0B       		mv	y,block_top
0BE0DA 4D 45             		sub	x,y
0BE0DC 30 85 0A          		mv	y,(10)
0BE0DF 45 45             		add	x,y
0BE0E1 3D                		popu	y
0BE0E2 B4 05             		mv	[y],x
0BE0E4 3C                		popu	x
0BE0E5 13 1B             		jr	init_3
0BE0E7                   	modify_end:
0BE0E7                   	;  (8) copier le pilote en fin de chaine, puis ecrire le terminateur $ff
0BE0E7 0B D5 0C          		mv	i,block_bottom-block_top
0BE0EA 30 85 0A          		mv	y,(10)
0BE0ED 0C 9C E2 0B       		mv	x,block_top
0BE0F1 90 24             	init_5:	mv	a,[x++]
0BE0F3 B0 25             		mv	[y++],a
0BE0F5 7C 03             		dec	i
0BE0F7 1B 08             		jrnz	init_5
0BE0F9 08 FF             		mv	a,0ffh
0BE0FB B0 05             		mv	[y],a
0BE0FD                   	;  (9) accrocher le vecteur clavier au handler du pilote (adresse relocalisee)
0BE0FD 2F                		pushu	imr
0BE0FE 0C 74 00 00       		mv	x,int_entry-block_top
0BE102 30 85 0A          		mv	y,(10)
0BE105 45 45             		add	x,y
0BE107 AC CC FC 0B       		mv	[keyvct],x
0BE10B 38                		popu	a
0BE10C 78 04             		or	a,keym
0BE10E 28                		pushu	a
0BE10F 3F                		popu	imr
0BE110                   	;  succes : aucun fichier decale -> aucun recalage BASIC
0BE110 0C 73 E1 0B       		mv	x,msg1
0BE114 0D 0C 00 00       		mv	y,btm1-msg1
0BE118 30 CC D6 00       		mv	(cl),0
0BE11C 09 04             		mv	il,4
0BE11E 05 E4 FF 0F       		callf	fcs_call
0BE122 9F                		rc
0BE123 07                		retf
0BE124                   	;  erreurs : message + retour (carry), sans toucher a BASIC
0BE124 0C 7F E1 0B       	exit2:	mv	x,msg2
0BE128 0D 17 00 00       		mv	y,btm2-msg2
0BE12C 12 08             		jr	exit_err
0BE12E 0C 96 E1 0B       	exit3:	mv	x,msg3
0BE132 0D 1B 00 00       		mv	y,btm3-msg3
0BE136                   	exit_err:
0BE136 30 CC D6 00       		mv	(cl),0
0BE13A 09 04             		mv	il,4
0BE13C 05 E4 FF 0F       		callf	fcs_call
0BE140 97                		sc
0BE141 07                		retf
0BE142                   	;  helper : comparaison de chaine sur IL octets
0BE142                   	stricmp:
0BE142 30 E0 24 00       		mv	(0),[x++]
0BE146 90 25             		mv	a,[y++]
0BE148 30 61 00 00       		cmp	(0),0
0BE14C 18 0A             		jrz	stricmp1
0BE14E 30 63 00          		cmp	(0),a
0BE151 1A 09             		jrnz	stricmp2
0BE153 7C 01             		dec	il
0BE155 1B 15             		jrnz	stricmp
0BE157 07                		retf
0BE158                   	stricmp1:
0BE158 30 63 00          		cmp	(0),a
0BE15B 07                		retf
0BE15C                   	stricmp2:
0BE15C 07                		retf
