0BE1BA 6D 65 6D 6F 72 79 	
0BE1C0 2E 0D 0A          	
0BE1C3                   	btm3:
0BE1C3                   	
0BE1C3                   	;-----------------------------------------------------------
0BE1C3                   	;       DESINSTALLATEUR  (CALL &BE000 -u)
0BE1C3                   	;
0BE1C3                   	;  Defait ce que l'installation a fait : delie le device de la chaine et
0BE1C3                   	;  restaure le vecteur clavier depuis la copie sauvegardee dans le pilote.
0BE1C3                   	;  Verifie d'abord etre au SOMMET de la pile de hooks (le vecteur clavier
0BE1C3                   	;  pointe-t-il encore vers NOTRE handler ?) : sinon un pilote a ete charge
0BE1C3                   	;  ensuite et le retrait casserait sa chaine -> refus propre.
0BE1C3                   	;-----------------------------------------------------------
0BE1C3                   	uninstall:
0BE1C3 0C 58 E2 0B       		mv	x,msg_un
0BE1C7 0D 13 00 00       		mv	y,btm_un-msg_un
0BE1CB 30 CC D6 00       		mv	(cl),0
0BE1CF 09 04             		mv	il,4
0BE1D1 05 E4 FF 0F       		callf	fcs_call
0BE1D5                   	;  chercher notre device dans la chaine, en gardant le predecesseur
0BE1D5 0D A2 FC 0B       		mv	y,d_link		; y = emplacement du pointeur vers l'en-tete courant
0BE1D9                   	un_find:
0BE1D9 94 05             		mv	x,[y]
0BE1DB 6C 04             		inc	x
0BE1DD 18 65             		jrz	un_notfound		; -1 : fin de chaine, non trouve
0BE1DF 7C 04             		dec	x
0BE1E1 30 A4 0A          		mv	(10),x			; (10) = en-tete courant
0BE1E4 30 A5 0D          		mv	(13),y			; (13) = predecesseur (emplacement du pointeur)
0BE1E7 09 08             		mv	il,8
0BE1E9 45 41             		add	x,il			; x = en-tete + 8 = nom de device
0BE1EB 0D ED E2 0B       		mv	y,drv_str
0BE1EF 09 04             		mv	il,4
0BE1F1 05 54 E1 0B       		callf	stricmp
0BE1F5 30 84 0A          		mv	x,(10)
0BE1F8 30 85 0D          		mv	y,(13)
0BE1FB 18 04             		jrz	un_found
0BE1FD FD 54             		mv	y,x			; avancer : predecesseur = en-tete courant
0BE1FF 13 28             		jr	un_find
0BE201                   	un_found:
0BE201                   	;  x = notre en-tete ; (13) = predecesseur
0BE201                   	;  securite : le vecteur clavier pointe-t-il encore vers NOTRE int_entry ?
0BE201 0A 52 00          		mv	ba,int_entry-iocs_header
0BE204 45 42             		add	x,ba			; x = notre int_entry (dans la copie)
0BE206 8D CC FC 0B       		mv	y,[keyvct]
0BE20A 4D 54             		sub	y,x
0BE20C 1A 2C             		jrnz	un_notsafe		; non -> un autre pilote a hooke apres nous
0BE20E                   	;  restaurer le vecteur clavier depuis la copie (save_vct)
0BE20E 30 84 0A          		mv	x,(10)
0BE211 0A 79 04          		mv	ba,save_vct-iocs_header
0BE214 45 42             		add	x,ba			; x = save_vct (dans la copie)
0BE216 94 04             		mv	x,[x]			; x = vecteur clavier d'origine
0BE218 AC CC FC 0B       		mv	[keyvct],x
0BE21C                   	;  delier de la chaine : [predecesseur] = notre lien suivant
0BE21C 30 84 0A          		mv	x,(10)
0BE21F 94 04             		mv	x,[x]			; x = notre lien suivant (3 premiers octets de l'en-tete)
0BE221 30 85 0D          		mv	y,(13)
0BE224 B4 05             		mv	[y],x
0BE226                   	;  Le pilote n'est plus dans la chaine des devices, mais son bloc reste en
0BE226                   	;  memoire avec l'attribut 'Protected' du systeme de fichiers (que KILL refuse).
0BE226                   	;  Le flag Protected de BASIC n'est PAS le bit 0Ch teste par REGISTER (verifie
0BE226                   	;  sur emulateur : effacer 0Ch ne suffit pas). On laisse donc l'utilisateur
0BE226                   	;  lever la protection puis liberer, via les commandes BASIC affichees ci-apres
0BE226                   	;  (la ROM met alors proprement a jour le repertoire et recompacte) :
0BE226                   	;      SET  "S1:REGIST3.SYS"," "   (oter la protection)
0BE226                   	;      KILL "S1:REGIST3.SYS"       (liberer la memoire)
0BE226                   	;  succes
0BE226 0C 6B E2 0B       		mv	x,msg_ok
0BE22A 0D 51 00 00       		mv	y,btm_ok-msg_ok
0BE22E 30 CC D6 00       		mv	(cl),0
0BE232 09 04             		mv	il,4
0BE234 05 E4 FF 0F       		callf	fcs_call
0BE238 9F                		rc
0BE239 07                		retf
0BE23A                   	un_notsafe:
0BE23A 0C BC E2 0B       		mv	x,msg_ns
0BE23E 0D 1C 00 00       		mv	y,btm_ns-msg_ns
0BE242 12 08             		jr	un_err
0BE244                   	un_notfound:
0BE244 0C D8 E2 0B       		mv	x,msg_nf
0BE248 0D 15 00 00       		mv	y,btm_nf-msg_nf
0BE24C                   	un_err:
0BE24C 30 CC D6 00       		mv	(cl),0
0BE250 09 04             		mv	il,4
0BE252 05 E4 FF 0F       		callf	fcs_call
0BE256 97                		sc
0BE257 07                		retf
