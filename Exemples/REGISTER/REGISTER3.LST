000000                   	;===========================================================================
000000                   	;	REGISTER3.ASM - Register checker (modele DRIVER_TEMPLATE) for PC-E500/1480U
000000                   	;	d'apres REGISTER.ASM Ver 1.2, (c)1990,1992 E. Kako (JM2WGN)
000000                   	;
000000                   	;	Reecriture pour xasm2026-4. Le code machine emis est STRICTEMENT
000000                   	;	IDENTIQUE a celui de REGISTER.ASM : seules changent la lisibilite et
000000                   	;	les verifications faites a l'assemblage. Rien n'a ete reordonne, aucune
000000                   	;	instruction n'a ete remplacee.
000000                   	;
000000                   	;---------------------------------------------------------------------------
000000                   	;	COMMENT CE PROGRAMME FONCTIONNE
000000                   	;
000000                   	;	Il installe un pilote de peripherique ("REG:") dans la RAM systeme,
000000                   	;	puis rend la main. Une fois installe, SHIFT+CTRL affiche l'etat des
000000                   	;	registres du CPU par-dessus l'ecran courant.
000000                   	;
000000                   	;	Le pilote est ASSEMBLE ici a l'adresse 0BE000h, mais il est COPIE a
000000                   	;	une adresse determinee a l'execution. Toute instruction du pilote qui
000000                   	;	contient une adresse absolue doit donc etre corrigee apres la copie.
000000                   	;
000000                   	;	C'est le role de la table de relocation en fin de fichier : chaque
000000                   	;	etiquette pN designe une telle instruction, et l'installeur remplace
000000                   	;	les trois octets d'operande situes en pN+1 par l'adresse recalculee.
000000                   	;
000000                   	;	>>> PIEGE A CONNAITRE : ajouter dans le pilote une instruction portant
000000                   	;	>>> une adresse absolue OBLIGE a lui donner une etiquette pN et a
000000                   	;	>>> l'inscrire dans modify_table. L'oublier ne provoque aucune erreur
000000                   	;	>>> d'assemblage : le pilote s'installe et se plante a l'execution.
000000                   	;	>>> Une verification en fin de fichier compte les entrees de la table.
000000                   	;===========================================================================
000000                   	bl:	equ	0d4h
000000                   	bh:	equ	0d5h
000000                   	cl:	equ	0d6h
000000                   	ch:	equ	0d7h
000000                   	dl:	equ	0d8h
000000                   	dh:	equ	0d9h
000000                   	;
000000                   	s2_top:	equ	0bfc0fh		;top  of "S2:"
000000                   	s2_siz:	equ	0bfc12h		;size of "S2:"
000000                   	s1_top:	equ	0bfc15h		;top  of "S1:"
000000                   	s1_siz:	equ	0bfc18h		;size of "S1:"
000000                   	s1_btm:	equ	0bfcdeh		;bottom of "S1:"
000000                   	d_link:	equ	0bfca2h		;device link pointer
000000                   	baswrk:	equ	0bfd0eh		;BASIC WORK Address
000000                   	keyvct:	equ	0bfccch		;key interrupt vector
000000                   	;
000000                   	fcs_call:  equ	0fffe4h
000000                   	iocs_call: equ	0fffe8h
000000                   	;
000000                   	;--- Registres materiels ---------------------------------------------------
000000                   	ko_lo:	equ	0f0h		;sortie de balayage clavier, poids faible
000000                   	ko_hi:	equ	0f1h		;sortie de balayage clavier, poids fort
000000                   	ki_in:	equ	0f2h		;entree clavier
000000                   	imr_p:	equ	0fbh		;masque d'interruption (IMR)
000000                   	bp_p:	equ	0ech		;registre de base BP
000000                   	keym:	equ	04h		;bit KEY du masque d'interruption
000000                   	;
000000                   	;--- Controleur LCD --------------------------------------------------------
000000                   	lcd_cl:	equ	0a004h		;commande, moitie gauche
000000                   	lcd_dl:	equ	0a006h		;donnee,   moitie gauche
000000                   	lcd_cr:	equ	0a008h		;commande, moitie droite
000000                   	lcd_dr:	equ	0a00ah		;donnee,   moitie droite
000000                   	;
000000                   	;--- Emplacements BASIC ----------------------------------------------------
000000                   	text_ad: equ	0cbh		;adresse du bloc TEXT.BAS
000000                   	data_ad: equ	0ceh		;adresse du bloc DATA.BAS
000000                   	menu_vc: equ	0ffffdh		;vecteur de retour au MENU
000000                   	;
000000                   	;--- Marqueurs de bloc memoire ---------------------------------------------
000000                   	blk_id:	equ	0fbh		;identifiant de bloc de fichier
000000                   	;
000000                   	;--- Macros ----------------------------------------------------------------
000000                   	;
000000                   	; Depose un caractere dans le tampon d'ecran pointe par Y.
000000                   	;
000000                   	; Selectionne une colonne du clavier et laisse le resultat lisible en (ki_in).
000000                   	; Le NOP est un delai de stabilisation : ne pas le retirer.
000000                   	;
000000                   	;
0BE000                   		org	0be000h
0BE000                   	;
0BE000                   		pre_on
0BE000                   	;
0BE000                   	;-----------------------------------------------------------
0BE000                   	;       DEVICE-DRIVER INSTALLER
0BE000                   	;-----------------------------------------------------------
0BE000                   	;-----------------------------------------------------------
0BE000                   	;       DEVICE-DRIVER INSTALLER  (modele du template : ajout en fin)
0BE000                   	;-----------------------------------------------------------
0BE000                   	start:
0BE000                   	;  (1) banniere
0BE000 0C 3C E1 0B       		mv	x,msg0
0BE004 0D 16 00 00       		mv	y,btm0-msg0
0BE008 30 CC D6 00       		mv	(cl),0
0BE00C 09 04             		mv	il,4
0BE00E 05 E4 FF 0F       		callf	fcs_call
0BE012                   	;  sauver le vecteur clavier et IMR (le pilote les restaure)
0BE012 8C CC FC 0B       		mv	x,[keyvct]
0BE016 AC 2B E6 0B       		mv	[save_vct],x
0BE01A 30 80 FB          		mv	a,(imr_p)
0BE01D A8 2E E6 0B       		mv	[save_imr],a
0BE021                   	;  (2) compacter S1: (regrouper l'espace libre en fin de zone)
0BE021 30 CC D6 06       		mv	(cl),6
0BE025 30 CC D7 00       		mv	(ch),0
0BE029 0B 47 00          		mv	i,47h
0BE02C 05 E8 FF 0F       		callf	iocs_call
0BE030                   	;  (3) parcourir jusqu'a la FIN des blocs ; detecter un doublon par le nom
0BE030 8C 15 FC 0B       		mv	x,[s1_top]
0BE034 95 84 12          		mv	y,[x+12h]
0BE037 45 45             		add	x,y
0BE039 90 04             	walk:	mv	a,[x]
0BE03B 60 FB             		cmp	a,blk_id
0BE03D 1A 15             		jrnz	walk_end
0BE03F 0D 90 E1 0B       		mv	y,block_top
0BE043 09 0C             		mv	il,12
0BE045 2C                		pushu	x
0BE046 05 21 E1 0B       		callf	stricmp
0BE04A 3C                		popu	x
0BE04B 18 B6             		jrz	exit2
0BE04D 95 84 11          		mv	y,[x+11h]
0BE050 45 45             		add	x,y
0BE052 13 1B             		jr	walk
0BE054                   	walk_end:
0BE054 30 A4 0A          		mv	(10),x			; destination = fin des blocs (ajout en fin)
0BE057                   	;  (4) controle memoire : libre = bas_de_S1 - fin_des_blocs >= taille
0BE057 8D DE FC 0B       		mv	y,[s1_btm]
0BE05B 7C 05             		dec	y
0BE05D 4D 54             		sub	y,x
0BE05F 30 A5 10          		mv	(16),y
0BE062 0D D5 0C 00       		mv	y,block_bottom-block_top
0BE066 30 D7 05 10       		cmpp	(16),y
0BE06A 1C A1             		jrc	exit3
0BE06C                   	;  (5) sauver le handler device #11 d'origine (pour le chainage de 'RG3:')
0BE06C 0C A2 FC 0B       		mv	x,d_link
0BE070 08 00             		mv	a,0
0BE072 A8 BF E1 0B       		mv	[iocs_found],a
0BE076 FD 54             	srch:	mv	y,x
0BE078 94 04             		mv	x,[x]
0BE07A 6C 04             		inc	x
0BE07C 18 16             		jrz	srch_end
0BE07E 7C 04             		dec	x
0BE080 90 84 03          		mv	a,[x+3]
0BE083 60 0B             		cmp	a,11
0BE085 1B 11             		jrnz	srch
0BE087 94 84 05          		mv	x,[x+5]
0BE08A AC C0 E1 0B       		mv	[iocs_eleven],x
0BE08E 08 01             		mv	a,1
0BE090 A8 BF E1 0B       		mv	[iocs_found],a
0BE094                   	srch_end:
0BE094                   	;  (6) chainer le nouveau device en tete de la liste IOCS
0BE094 8C A2 FC 0B       		mv	x,[d_link]
0BE098 AC B2 E1 0B       		mv	[header],x
0BE09C 30 84 0A          		mv	x,(10)
0BE09F 09 22             		mv	il,iocs_header-block_top
0BE0A1 45 41             		add	x,il
0BE0A3 AC A2 FC 0B       		mv	[d_link],x
0BE0A7                   	;  (7) relocation (mecanisme de REGISTER : site pN, l'installateur lit [pN+1])
0BE0A7 0C 65 EE 0B       		mv	x,modify_table
0BE0AB 95 24             	init_3:	mv	y,[x++]
0BE0AD 6C 05             		inc	y
0BE0AF 18 15             		jrz	modify_end
0BE0B1 2C                		pushu	x
0BE0B2 94 05             		mv	x,[y]
0BE0B4 2D                		pushu	y
0BE0B5 0D 90 E1 0B       		mv	y,block_top
0BE0B9 4D 45             		sub	x,y
0BE0BB 30 85 0A          		mv	y,(10)
0BE0BE 45 45             		add	x,y
0BE0C0 3D                		popu	y
0BE0C1 B4 05             		mv	[y],x
0BE0C3 3C                		popu	x
0BE0C4 13 1B             		jr	init_3
0BE0C6                   	modify_end:
0BE0C6                   	;  (8) copier le pilote en fin de chaine, puis ecrire le terminateur $ff
0BE0C6 0B D5 0C          		mv	i,block_bottom-block_top
0BE0C9 30 85 0A          		mv	y,(10)
0BE0CC 0C 90 E1 0B       		mv	x,block_top
0BE0D0 90 24             	init_5:	mv	a,[x++]
0BE0D2 B0 25             		mv	[y++],a
0BE0D4 7C 03             		dec	i
0BE0D6 1B 08             		jrnz	init_5
0BE0D8 08 FF             		mv	a,0ffh
0BE0DA B0 05             		mv	[y],a
0BE0DC                   	;  (9) accrocher le vecteur clavier au handler du pilote (adresse relocalisee)
0BE0DC 2F                		pushu	imr
0BE0DD 0C 74 00 00       		mv	x,int_entry-block_top
0BE0E1 30 85 0A          		mv	y,(10)
0BE0E4 45 45             		add	x,y
0BE0E6 AC CC FC 0B       		mv	[keyvct],x
0BE0EA 38                		popu	a
0BE0EB 78 04             		or	a,keym
0BE0ED 28                		pushu	a
0BE0EE 3F                		popu	imr
0BE0EF                   	;  succes : aucun fichier decale -> aucun recalage BASIC
0BE0EF 0C 52 E1 0B       		mv	x,msg1
0BE0F3 0D 0C 00 00       		mv	y,btm1-msg1
0BE0F7 30 CC D6 00       		mv	(cl),0
0BE0FB 09 04             		mv	il,4
0BE0FD 05 E4 FF 0F       		callf	fcs_call
0BE101 9F                		rc
0BE102 07                		retf
0BE103                   	;  erreurs : message + retour (carry), sans toucher a BASIC
0BE103 0C 5E E1 0B       	exit2:	mv	x,msg2
0BE107 0D 17 00 00       		mv	y,btm2-msg2
0BE10B 12 08             		jr	exit_err
0BE10D 0C 75 E1 0B       	exit3:	mv	x,msg3
0BE111 0D 1B 00 00       		mv	y,btm3-msg3
0BE115                   	exit_err:
0BE115 30 CC D6 00       		mv	(cl),0
0BE119 09 04             		mv	il,4
0BE11B 05 E4 FF 0F       		callf	fcs_call
0BE11F 97                		sc
0BE120 07                		retf
0BE121                   	;  helper : comparaison de chaine sur IL octets
0BE121                   	stricmp:
0BE121 30 E0 24 00       		mv	(0),[x++]
0BE125 90 25             		mv	a,[y++]
0BE127 30 61 00 00       		cmp	(0),0
0BE12B 18 0A             		jrz	stricmp1
0BE12D 30 63 00          		cmp	(0),a
0BE130 1A 09             		jrnz	stricmp2
0BE132 7C 01             		dec	il
0BE134 1B 15             		jrnz	stricmp
0BE136 07                		retf
0BE137                   	stricmp1:
0BE137 30 63 00          		cmp	(0),a
0BE13A 07                		retf
0BE13B                   	stricmp2:
0BE13B 07                		retf
