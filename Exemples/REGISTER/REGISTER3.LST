0BF034                   	;---------------------------------------------------------------------------
0BF034                   	;	VERIFICATIONS A L'ASSEMBLAGE
0BF034                   	;
0BF034                   	;	Elles n'emettent aucun octet : elles ne font qu'interrompre
0BF034                   	;	l'assemblage si une hypothese du programme cesse d'etre vraie.
0BF034                   	;---------------------------------------------------------------------------
0BF034                   	;
0BF034                   	; La table contient attr, p0..p62 et le terminateur -1, soit 65 entrees de
0BF034                   	; 3 octets. Si ce total change sans que ce soit voulu, c'est qu'une entree a
0BF034                   	; ete ajoutee ou perdue par megarde.
0BF034                   		assert	modify_end_tbl-modify_table = 65*3,'table de relocation : nombre d entrees inattendu'
0BF034                   	;
0BF034                   	; Chaque point de relocation doit se trouver a l'interieur du pilote : un pN
0BF034                   	; hors bloc serait corrige a tort lors de la copie.
0BF034                   		assert	p0 >= block_top,'p0 hors du bloc pilote'
0BF034                   		assert	p62 < block_bottom,'p62 hors du bloc pilote'
0BF034                   		assert	attr >= block_top,'attr hors du bloc pilote'
0BF034                   	;
0BF034                   	; Le pilote est copie tel quel : sa taille doit rester non nulle et tenir dans
0BF034                   	; ce que l'installeur sait deplacer.
0BF034                   		assert	block_bottom > block_top,'taille du pilote nulle'
0BF034                   	;
0BF034                   		end

