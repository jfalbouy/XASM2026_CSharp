0BF089                   	;	l'assemblage si une hypothese du programme cesse d'etre vraie.
0BF089                   	;---------------------------------------------------------------------------
0BF089                   	;
0BF089                   	; La table contient attr, p0..p62 et le terminateur -1, soit 65 entrees de
0BF089                   	; 3 octets. Si ce total change sans que ce soit voulu, c'est qu'une entree a
0BF089                   	; ete ajoutee ou perdue par megarde.
0BF089                   		assert	modify_end_tbl-modify_table = 65*3,'table de relocation : nombre d entrees inattendu'
0BF089                   	;
0BF089                   	; Chaque point de relocation doit se trouver a l'interieur du pilote : un pN
0BF089                   	; hors bloc serait corrige a tort lors de la copie.
0BF089                   		assert	p0 >= block_top,'p0 hors du bloc pilote'
0BF089                   		assert	p62 < block_bottom,'p62 hors du bloc pilote'
0BF089                   		assert	attr >= block_top,'attr hors du bloc pilote'
0BF089                   	;
0BF089                   	; Le pilote est copie tel quel : sa taille doit rester non nulle et tenir dans
0BF089                   	; ce que l'installeur sait deplacer.
0BF089                   		assert	block_bottom > block_top,'taille du pilote nulle'
0BF089                   	;
0BF089                   		end

  No fatal error.  Code: 0BE000h - 0BF088h [     4233 byte(s)]
