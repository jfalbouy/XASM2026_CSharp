000000                   	;===========================================================================
000000                   	;	REGISTER3.ASM - Register checker (modele DRIVER_TEMPLATE) for PC-E500/1480U
000000                   	;	d'apres REGISTER.ASM Ver 1.2, (c)1990,1992 E. Kako (JM2WGN)
000000                   	;
000000                   	;	Reecriture pour xasm2026-4. Le code machine emis est STRICTEMENT
000000                   	;	IDENTIQUE a celui de REGISTER.ASM : seules changent la lisibilite et
000000                   	;	les verifications faites a l'assemblage. Rien n'a ete reordonne, aucune
000000                   	;	instruction n'a ete remplacee.
000000                   	;
000000                   	;---------------------------------------------------------------------------
000000                   	;	COMMENT CE PROGRAMME FONCTIONNE
000000                   	;
000000                   	;	Il installe un pilote de peripherique ("REG:") dans la RAM systeme,
000000                   	;	puis rend la main. Une fois installe, SHIFT+CTRL affiche l'etat des
000000                   	;	registres du CPU par-dessus l'ecran courant.
000000                   	;
000000                   	;	Le pilote est ASSEMBLE ici a l'adresse 0BE000h, mais il est COPIE a
000000                   	;	une adresse determinee a l'execution. Toute instruction du pilote qui
000000                   	;	contient une adresse absolue doit donc etre corrigee apres la copie.
000000                   	;
000000                   	;	C'est le role de la table de relocation en fin de fichier : chaque
000000                   	;	etiquette pN designe une telle instruction, et l'installeur remplace
000000                   	;	les trois octets d'operande situes en pN+1 par l'adresse recalculee.
000000                   	;
000000                   	;	>>> PIEGE A CONNAITRE : ajouter dans le pilote une instruction portant
000000                   	;	>>> une adresse absolue OBLIGE a lui donner une etiquette pN et a
000000                   	;	>>> l'inscrire dans modify_table. L'oublier ne provoque aucune erreur
000000                   	;	>>> d'assemblage : le pilote s'installe et se plante a l'execution.
000000                   	;	>>> Une verification en fin de fichier compte les entrees de la table.
000000                   	;===========================================================================
000000                   	bl:	equ	0d4h
000000                   	bh:	equ	0d5h
000000                   	cl:	equ	0d6h
000000                   	ch:	equ	0d7h
000000                   	dl:	equ	0d8h
000000                   	dh:	equ	0d9h
000000                   	;
000000                   	s2_top:	equ	0bfc0fh		;top  of "S2:"
000000                   	s2_siz:	equ	0bfc12h		;size of "S2:"
000000                   	s1_top:	equ	0bfc15h		;top  of "S1:"
000000                   	s1_siz:	equ	0bfc18h		;size of "S1:"
000000                   	s1_btm:	equ	0bfcdeh		;bottom of "S1:"
000000                   	d_link:	equ	0bfca2h		;device link pointer
000000                   	baswrk:	equ	0bfd0eh		;BASIC WORK Address
000000                   	keyvct:	equ	0bfccch		;key interrupt vector
000000                   	;
000000                   	fcs_call:  equ	0fffe4h
000000                   	iocs_call: equ	0fffe8h
000000                   	;
000000                   	;--- Registres materiels ---------------------------------------------------
000000                   	ko_lo:	equ	0f0h		;sortie de balayage clavier, poids faible
000000                   	ko_hi:	equ	0f1h		;sortie de balayage clavier, poids fort
000000                   	ki_in:	equ	0f2h		;entree clavier
000000                   	imr_p:	equ	0fbh		;masque d'interruption (IMR)
000000                   	bp_p:	equ	0ech		;registre de base BP
000000                   	keym:	equ	04h		;bit KEY du masque d'interruption
000000                   	;
000000                   	;--- Controleur LCD --------------------------------------------------------
000000                   	lcd_cl:	equ	0a004h		;commande, moitie gauche
000000                   	lcd_dl:	equ	0a006h		;donnee,   moitie gauche
000000                   	lcd_cr:	equ	0a008h		;commande, moitie droite
000000                   	lcd_dr:	equ	0a00ah		;donnee,   moitie droite
000000                   	;
000000                   	;--- Emplacements BASIC ----------------------------------------------------
000000                   	text_ad: equ	0cbh		;adresse du bloc TEXT.BAS
000000                   	data_ad: equ	0ceh		;adresse du bloc DATA.BAS
000000                   	menu_vc: equ	0ffffdh		;vecteur de retour au MENU
000000                   	;
000000                   	;--- Marqueurs de bloc memoire ---------------------------------------------
000000                   	blk_id:	equ	0fbh		;identifiant de bloc de fichier
000000                   	;
000000                   	;--- Macros ----------------------------------------------------------------
000000                   	;
000000                   	; Depose un caractere dans le tampon d'ecran pointe par Y.
000000                   	;
000000                   	; Selectionne une colonne du clavier et laisse le resultat lisible en (ki_in).
000000                   	; Le NOP est un delai de stabilisation : ne pas le retirer.
000000                   	;
000000                   	; Nom du pilote defini UNE SEULE FOIS ici (base + extension). Deux macros le
000000                   	; formatent : 'name83' pour l'en-tete de bloc (8 car. completes d'espaces, sans
000000                   	; point) et 'namedot' pour les messages (base.ext). Pour renommer le pilote, ne
000000                   	; changer que 'drvbase' et 'drvext'.
000000                   	;
000000                   	;
0BE000                   		org	0be000h
0BE000                   	;
0BE000                   		pre_on
0BE000                   	;
0BE000                   	;-----------------------------------------------------------
0BE000                   	;       DEVICE-DRIVER INSTALLER
0BE000                   	;-----------------------------------------------------------
0BE000                   	;-----------------------------------------------------------
0BE000                   	;       DEVICE-DRIVER INSTALLER  (modele du template : ajout en fin)
0BE000                   	;-----------------------------------------------------------
0BE000                   	start:
0BE000                   	;  (0) lire l'argument de CALL : la chaine "-u" (ou "-U") lance la
0BE000                   	;      desinstallation, sinon on installe. L'argument doit etre entre
0BE000                   	;      GUILLEMETS (syntaxe BASIC), comme pour UUENCODE :
0BE000                   	;          CALL &BE000          -> installe
0BE000                   	;          CALL &BE000 "-u"     -> desinstalle
0BE000                   	;      La ligne de commande (avec ses guillemets) est en tete de la pile U ;
0BE000                   	;      le scan saute le guillemet ouvrant et cherche "-u".
0BE000 3C                		popu	x			; x = pointeur de ligne (empile par CALL)
0BE001 30 CC 00 00       		mv	(0),0			; (0) = 0 : installer ; sinon : desinstaller
0BE005 90 24             	sc_arg:	mv	a,[x++]
0BE007 60 00             		cmp	a,0
0BE009 18 23             		jrz	sc_done
0BE00B 60 0D             		cmp	a,0dh			; CR
0BE00D 18 1F             		jrz	sc_done
0BE00F 60 1A             		cmp	a,1ah			; fin de chaine BASIC (comme UUENCODE argskp)
0BE011 18 1B             		jrz	sc_done
0BE013 60 FF             		cmp	a,0ffh			; fin de chaine BASIC
0BE015 18 17             		jrz	sc_done
0BE017 60 2D             		cmp	a,'-'
0BE019 1B 16             		jrnz	sc_arg
0BE01B 90 04             		mv	a,[x]
0BE01D 60 75             		cmp	a,'u'
0BE01F 18 06             		jrz	sc_setu
0BE021 60 55             		cmp	a,'U'
0BE023 18 02             		jrz	sc_setu
0BE025 13 22             		jr	sc_arg
0BE027                   	sc_setu:
0BE027 08 01             		mv	a,1
0BE029 30 A0 00          		mv	(0),a
0BE02C 13 29             		jr	sc_arg
0BE02E                   	sc_done:
0BE02E                   	;      RESTITUER a BASIC le pointeur de ligne AVANCE au-dela de l'argument
0BE02E                   	;      (protocole UUENCODE : popu a l'entree, pushu du pointeur avance a la
0BE02E                   	;      sortie). Sans ce pushu, BASIC ne retrouve pas ou reprendre -> 'Syntax
0BE02E                   	;      error' au retour d'un CALL suivi d'un argument.
0BE02E 7C 04             		dec	x			; revenir sur le terminateur de l'argument
0BE030 2C                		pushu	x
0BE031 30 80 00          		mv	a,(0)
0BE034 60 00             		cmp	a,0
0BE036 18 03             		jrz	sc_install
0BE038 02 CB E1          		jp	uninstall
0BE03B                   	sc_install:
0BE03B                   	;  (1) banniere
0BE03B 0C 77 E1 0B       		mv	x,msg0
0BE03F 0D 16 00 00       		mv	y,btm0-msg0
0BE043 30 CC D6 00       		mv	(cl),0
0BE047 09 04             		mv	il,4
0BE049 05 E4 FF 0F       		callf	fcs_call
0BE04D                   	;  sauver le vecteur clavier et IMR (le pilote les restaure)
0BE04D 8C CC FC 0B       		mv	x,[keyvct]
0BE051 AC 94 E7 0B       		mv	[save_vct],x
0BE055 30 80 FB          		mv	a,(imr_p)
0BE058 A8 97 E7 0B       		mv	[save_imr],a
0BE05C                   	;  (2) compacter S1: (regrouper l'espace libre en fin de zone)
0BE05C 30 CC D6 06       		mv	(cl),6
0BE060 30 CC D7 00       		mv	(ch),0
0BE064 0B 47 00          		mv	i,47h
0BE067 05 E8 FF 0F       		callf	iocs_call
0BE06B                   	;  (3) parcourir jusqu'a la FIN des blocs ; detecter un doublon par le nom
0BE06B 8C 15 FC 0B       		mv	x,[s1_top]
0BE06F 95 84 12          		mv	y,[x+12h]
0BE072 45 45             		add	x,y
0BE074 90 04             	walk:	mv	a,[x]
0BE076 60 FB             		cmp	a,blk_id
0BE078 1A 15             		jrnz	walk_end
0BE07A 0D F9 E2 0B       		mv	y,block_top
0BE07E 09 0C             		mv	il,12
0BE080 2C                		pushu	x
0BE081 05 5C E1 0B       		callf	stricmp
0BE085 3C                		popu	x
0BE086 18 B6             		jrz	exit2
0BE088 95 84 11          		mv	y,[x+11h]
0BE08B 45 45             		add	x,y
0BE08D 13 1B             		jr	walk
0BE08F                   	walk_end:
0BE08F 30 A4 0A          		mv	(10),x			; destination = fin des blocs (ajout en fin)
0BE092                   	;  (4) controle memoire : libre = bas_de_S1 - fin_des_blocs >= taille
0BE092 8D DE FC 0B       		mv	y,[s1_btm]
0BE096 7C 05             		dec	y
0BE098 4D 54             		sub	y,x
0BE09A 30 A5 10          		mv	(16),y
0BE09D 0D D5 0C 00       		mv	y,block_bottom-block_top
0BE0A1 30 D7 05 10       		cmpp	(16),y
0BE0A5 1C A1             		jrc	exit3
0BE0A7                   	;  (5) sauver le handler device #11 d'origine (pour le chainage de 'RG3:')
0BE0A7 0C A2 FC 0B       		mv	x,d_link
0BE0AB 08 00             		mv	a,0
0BE0AD A8 28 E3 0B       		mv	[iocs_found],a
0BE0B1 FD 54             	srch:	mv	y,x
0BE0B3 94 04             		mv	x,[x]
0BE0B5 6C 04             		inc	x
0BE0B7 18 16             		jrz	srch_end
0BE0B9 7C 04             		dec	x
0BE0BB 90 84 03          		mv	a,[x+3]
0BE0BE 60 0B             		cmp	a,11
0BE0C0 1B 11             		jrnz	srch
0BE0C2 94 84 05          		mv	x,[x+5]
0BE0C5 AC 29 E3 0B       		mv	[iocs_eleven],x
0BE0C9 08 01             		mv	a,1
0BE0CB A8 28 E3 0B       		mv	[iocs_found],a
0BE0CF                   	srch_end:
0BE0CF                   	;  (6) chainer le nouveau device en tete de la liste IOCS
0BE0CF 8C A2 FC 0B       		mv	x,[d_link]
0BE0D3 AC 1B E3 0B       		mv	[header],x
0BE0D7 30 84 0A          		mv	x,(10)
0BE0DA 09 22             		mv	il,iocs_header-block_top
0BE0DC 45 41             		add	x,il
0BE0DE AC A2 FC 0B       		mv	[d_link],x
0BE0E2                   	;  (7) relocation (mecanisme de REGISTER : site pN, l'installateur lit [pN+1])
0BE0E2 0C CE EF 0B       		mv	x,modify_table
0BE0E6 95 24             	init_3:	mv	y,[x++]
0BE0E8 6C 05             		inc	y
0BE0EA 18 15             		jrz	modify_end
0BE0EC 2C                		pushu	x
0BE0ED 94 05             		mv	x,[y]
0BE0EF 2D                		pushu	y
0BE0F0 0D F9 E2 0B       		mv	y,block_top
0BE0F4 4D 45             		sub	x,y
0BE0F6 30 85 0A          		mv	y,(10)
0BE0F9 45 45             		add	x,y
0BE0FB 3D                		popu	y
0BE0FC B4 05             		mv	[y],x
0BE0FE 3C                		popu	x
0BE0FF 13 1B             		jr	init_3
0BE101                   	modify_end:
0BE101                   	;  (8) copier le pilote en fin de chaine, puis ecrire le terminateur $ff
0BE101 0B D5 0C          		mv	i,block_bottom-block_top
0BE104 30 85 0A          		mv	y,(10)
0BE107 0C F9 E2 0B       		mv	x,block_top
0BE10B 90 24             	init_5:	mv	a,[x++]
0BE10D B0 25             		mv	[y++],a
0BE10F 7C 03             		dec	i
0BE111 1B 08             		jrnz	init_5
0BE113 08 FF             		mv	a,0ffh
0BE115 B0 05             		mv	[y],a
0BE117                   	;  (9) accrocher le vecteur clavier au handler du pilote (adresse relocalisee)
0BE117 2F                		pushu	imr
0BE118 0C 74 00 00       		mv	x,int_entry-block_top
0BE11C 30 85 0A          		mv	y,(10)
0BE11F 45 45             		add	x,y
0BE121 AC CC FC 0B       		mv	[keyvct],x
0BE125 38                		popu	a
0BE126 78 04             		or	a,keym
0BE128 28                		pushu	a
0BE129 3F                		popu	imr
0BE12A                   	;  succes : aucun fichier decale -> aucun recalage BASIC
0BE12A 0C 8D E1 0B       		mv	x,msg1
0BE12E 0D 0C 00 00       		mv	y,btm1-msg1
0BE132 30 CC D6 00       		mv	(cl),0
0BE136 09 04             		mv	il,4
0BE138 05 E4 FF 0F       		callf	fcs_call
0BE13C 9F                		rc
0BE13D 07                		retf
0BE13E                   	;  erreurs : message + retour (carry), sans toucher a BASIC
0BE13E 0C 99 E1 0B       	exit2:	mv	x,msg2
0BE142 0D 17 00 00       		mv	y,btm2-msg2
0BE146 12 08             		jr	exit_err
0BE148 0C B0 E1 0B       	exit3:	mv	x,msg3
0BE14C 0D 1B 00 00       		mv	y,btm3-msg3
0BE150                   	exit_err:
0BE150 30 CC D6 00       		mv	(cl),0
0BE154 09 04             		mv	il,4
0BE156 05 E4 FF 0F       		callf	fcs_call
0BE15A 9F                		rc				; carry CLAIR (carry arme -> Syntax error BASIC au retour)
0BE15B 07                		retf
0BE15C                   	;  helper : comparaison de chaine sur IL octets
0BE15C                   	stricmp:
0BE15C 30 E0 24 00       		mv	(0),[x++]
0BE160 90 25             		mv	a,[y++]
0BE162 30 61 00 00       		cmp	(0),0
0BE166 18 0A             		jrz	stricmp1
0BE168 30 63 00          		cmp	(0),a
0BE16B 1A 09             		jrnz	stricmp2
0BE16D 7C 01             		dec	il
0BE16F 1B 15             		jrnz	stricmp
0BE171 07                		retf
0BE172                   	stricmp1:
0BE172 30 63 00          		cmp	(0),a
0BE175 07                		retf
0BE176                   	stricmp2:
0BE176 07                		retf
0BE177                   	;  messages
0BE177 52 45 47 49 53 54 	msg0:	db	'REGISTER3 (template)',13,10
0BE17D 45 52 33 20 28 74 	
0BE183 65 6D 70 6C 61 74 	
0BE189 65 29 0D 0A       	
0BE18D                   	btm0:
0BE18D 49 6E 73 74 61 6C 	msg1:	db	'Installed.',13,10
0BE193 6C 65 64 2E 0D 0A 	
0BE199                   	btm1:
0BE199 45 72 72 6F 72 3A 	msg2:	db	'Error: already exist.',13,10
0BE19F 20 61 6C 72 65 61 	
0BE1A5 64 79 20 65 78 69 	
0BE1AB 73 74 2E 0D 0A    	
0BE1B0                   	btm2:
0BE1B0 45 72 72 6F 72 3A 	msg3:	db	'Error: not enough memory.',13,10
0BE1B6 20 6E 6F 74 20 65 	
0BE1BC 6E 6F 75 67 68 20 	
0BE1C2 6D 65 6D 6F 72 79 	
0BE1C8 2E 0D 0A          	
0BE1CB                   	btm3:
0BE1CB                   	
0BE1CB                   	;-----------------------------------------------------------
0BE1CB                   	;       DESINSTALLATEUR  (CALL &BE000 -u)
0BE1CB                   	;
0BE1CB                   	;  Defait ce que l'installation a fait : delie le device de la chaine et
0BE1CB                   	;  restaure le vecteur clavier depuis la copie sauvegardee dans le pilote.
0BE1CB                   	;  Verifie d'abord etre au SOMMET de la pile de hooks (le vecteur clavier
0BE1CB                   	;  pointe-t-il encore vers NOTRE handler ?) : sinon un pilote a ete charge
0BE1CB                   	;  ensuite et le retrait casserait sa chaine -> refus propre.
0BE1CB                   	;-----------------------------------------------------------
0BE1CB                   	uninstall:
0BE1CB 0C 60 E2 0B       		mv	x,msg_un
0BE1CF 0D 13 00 00       		mv	y,btm_un-msg_un
0BE1D3 30 CC D6 00       		mv	(cl),0
0BE1D7 09 04             		mv	il,4
0BE1D9 05 E4 FF 0F       		callf	fcs_call
0BE1DD                   	;  chercher notre device dans la chaine, en gardant le predecesseur
0BE1DD 0D A2 FC 0B       		mv	y,d_link		; y = emplacement du pointeur vers l'en-tete courant
0BE1E1                   	un_find:
0BE1E1 94 05             		mv	x,[y]
0BE1E3 6C 04             		inc	x
0BE1E5 18 65             		jrz	un_notfound		; -1 : fin de chaine, non trouve
0BE1E7 7C 04             		dec	x
0BE1E9 30 A4 0A          		mv	(10),x			; (10) = en-tete courant
0BE1EC 30 A5 0D          		mv	(13),y			; (13) = predecesseur (emplacement du pointeur)
0BE1EF 09 08             		mv	il,8
0BE1F1 45 41             		add	x,il			; x = en-tete + 8 = nom de device
0BE1F3 0D F5 E2 0B       		mv	y,drv_str
0BE1F7 09 04             		mv	il,4
0BE1F9 05 5C E1 0B       		callf	stricmp
0BE1FD 30 84 0A          		mv	x,(10)
0BE200 30 85 0D          		mv	y,(13)
0BE203 18 04             		jrz	un_found
0BE205 FD 54             		mv	y,x			; avancer : predecesseur = en-tete courant
0BE207 13 28             		jr	un_find
0BE209                   	un_found:
0BE209                   	;  x = notre en-tete ; (13) = predecesseur
0BE209                   	;  securite : le vecteur clavier pointe-t-il encore vers NOTRE int_entry ?
0BE209 0A 52 00          		mv	ba,int_entry-iocs_header
0BE20C 45 42             		add	x,ba			; x = notre int_entry (dans la copie)
0BE20E 8D CC FC 0B       		mv	y,[keyvct]
0BE212 4D 54             		sub	y,x
0BE214 1A 2C             		jrnz	un_notsafe		; non -> un autre pilote a hooke apres nous
0BE216                   	;  restaurer le vecteur clavier depuis la copie (save_vct)
0BE216 30 84 0A          		mv	x,(10)
0BE219 0A 79 04          		mv	ba,save_vct-iocs_header
0BE21C 45 42             		add	x,ba			; x = save_vct (dans la copie)
0BE21E 94 04             		mv	x,[x]			; x = vecteur clavier d'origine
0BE220 AC CC FC 0B       		mv	[keyvct],x
0BE224                   	;  delier de la chaine : [predecesseur] = notre lien suivant
0BE224 30 84 0A          		mv	x,(10)
0BE227 94 04             		mv	x,[x]			; x = notre lien suivant (3 premiers octets de l'en-tete)
0BE229 30 85 0D          		mv	y,(13)
0BE22C B4 05             		mv	[y],x
0BE22E                   	;  Le pilote n'est plus dans la chaine des devices, mais son bloc reste en
0BE22E                   	;  memoire avec l'attribut 'Protected' du systeme de fichiers (que KILL refuse).
0BE22E                   	;  Le flag Protected de BASIC n'est PAS le bit 0Ch teste par REGISTER (verifie
0BE22E                   	;  sur emulateur : effacer 0Ch ne suffit pas). On laisse donc l'utilisateur
0BE22E                   	;  lever la protection puis liberer, via les commandes BASIC affichees ci-apres
0BE22E                   	;  (la ROM met alors proprement a jour le repertoire et recompacte) :
0BE22E                   	;      SET  "S1:REGIST3.SYS"," "   (oter la protection)
0BE22E                   	;      KILL "S1:REGIST3.SYS"       (liberer la memoire)
0BE22E                   	;  succes
0BE22E 0C 73 E2 0B       		mv	x,msg_ok
0BE232 0D 51 00 00       		mv	y,btm_ok-msg_ok
0BE236 30 CC D6 00       		mv	(cl),0
0BE23A 09 04             		mv	il,4
0BE23C 05 E4 FF 0F       		callf	fcs_call
0BE240 9F                		rc
0BE241 07                		retf
0BE242                   	un_notsafe:
0BE242 0C C4 E2 0B       		mv	x,msg_ns
0BE246 0D 1C 00 00       		mv	y,btm_ns-msg_ns
0BE24A 12 08             		jr	un_err
0BE24C                   	un_notfound:
0BE24C 0C E0 E2 0B       		mv	x,msg_nf
0BE250 0D 15 00 00       		mv	y,btm_nf-msg_nf
0BE254                   	un_err:
0BE254 30 CC D6 00       		mv	(cl),0
0BE258 09 04             		mv	il,4
0BE25A 05 E4 FF 0F       		callf	fcs_call
0BE25E 9F                		rc				; carry CLAIR (carry arme -> Syntax error BASIC au retour)
0BE25F 07                		retf
