000000                   	;===========================================================================
000000                   	;	REGISTER3.ASM - Register checker (modele DRIVER_TEMPLATE) for PC-E500/1480U
000000                   	;	d'apres REGISTER.ASM Ver 1.2, (c)1990,1992 E. Kako (JM2WGN)
000000                   	;
000000                   	;	Reecriture pour xasm2026-4. Le code machine emis est STRICTEMENT
000000                   	;	IDENTIQUE a celui de REGISTER.ASM : seules changent la lisibilite et
000000                   	;	les verifications faites a l'assemblage. Rien n'a ete reordonne, aucune
000000                   	;	instruction n'a ete remplacee.
000000                   	;
000000                   	;---------------------------------------------------------------------------
000000                   	;	COMMENT CE PROGRAMME FONCTIONNE
000000                   	;
000000                   	;	Il installe un pilote de peripherique ("REG:") dans la RAM systeme,
000000                   	;	puis rend la main. Une fois installe, SHIFT+CTRL affiche l'etat des
000000                   	;	registres du CPU par-dessus l'ecran courant.
000000                   	;
000000                   	;	Le pilote est ASSEMBLE ici a l'adresse 0BE000h, mais il est COPIE a
000000                   	;	une adresse determinee a l'execution. Toute instruction du pilote qui
000000                   	;	contient une adresse absolue doit donc etre corrigee apres la copie.
000000                   	;
000000                   	;	C'est le role de la table de relocation en fin de fichier : chaque
000000                   	;	etiquette pN designe une telle instruction, et l'installeur remplace
000000                   	;	les trois octets d'operande situes en pN+1 par l'adresse recalculee.
000000                   	;
000000                   	;	>>> PIEGE A CONNAITRE : ajouter dans le pilote une instruction portant
000000                   	;	>>> une adresse absolue OBLIGE a lui donner une etiquette pN et a
000000                   	;	>>> l'inscrire dans modify_table. L'oublier ne provoque aucune erreur
000000                   	;	>>> d'assemblage : le pilote s'installe et se plante a l'execution.
000000                   	;	>>> Une verification en fin de fichier compte les entrees de la table.
000000                   	;===========================================================================
000000                   	bl:	equ	0d4h
000000                   	bh:	equ	0d5h
000000                   	cl:	equ	0d6h
000000                   	ch:	equ	0d7h
000000                   	dl:	equ	0d8h
000000                   	dh:	equ	0d9h
000000                   	;
000000                   	s2_top:	equ	0bfc0fh		;top  of "S2:"
000000                   	s2_siz:	equ	0bfc12h		;size of "S2:"
000000                   	s1_top:	equ	0bfc15h		;top  of "S1:"
000000                   	s1_siz:	equ	0bfc18h		;size of "S1:"
000000                   	s1_btm:	equ	0bfcdeh		;bottom of "S1:"
000000                   	d_link:	equ	0bfca2h		;device link pointer
000000                   	baswrk:	equ	0bfd0eh		;BASIC WORK Address
000000                   	keyvct:	equ	0bfccch		;key interrupt vector
000000                   	;
000000                   	fcs_call:  equ	0fffe4h
000000                   	iocs_call: equ	0fffe8h
000000                   	;
000000                   	;--- Registres materiels ---------------------------------------------------
000000                   	ko_lo:	equ	0f0h		;sortie de balayage clavier, poids faible
000000                   	ko_hi:	equ	0f1h		;sortie de balayage clavier, poids fort
000000                   	ki_in:	equ	0f2h		;entree clavier
000000                   	imr_p:	equ	0fbh		;masque d'interruption (IMR)
000000                   	bp_p:	equ	0ech		;registre de base BP
000000                   	keym:	equ	04h		;bit KEY du masque d'interruption
000000                   	;
000000                   	;--- Controleur LCD --------------------------------------------------------
000000                   	lcd_cl:	equ	0a004h		;commande, moitie gauche
000000                   	lcd_dl:	equ	0a006h		;donnee,   moitie gauche
000000                   	lcd_cr:	equ	0a008h		;commande, moitie droite
000000                   	lcd_dr:	equ	0a00ah		;donnee,   moitie droite
000000                   	;
000000                   	;--- Emplacements BASIC ----------------------------------------------------
000000                   	text_ad: equ	0cbh		;adresse du bloc TEXT.BAS
000000                   	data_ad: equ	0ceh		;adresse du bloc DATA.BAS
000000                   	menu_vc: equ	0ffffdh		;vecteur de retour au MENU
000000                   	;
000000                   	;--- Marqueurs de bloc memoire ---------------------------------------------
000000                   	blk_id:	equ	0fbh		;identifiant de bloc de fichier
000000                   	;
000000                   	;--- Macros ----------------------------------------------------------------
000000                   	;
000000                   	; Depose un caractere dans le tampon d'ecran pointe par Y.
000000                   	;
000000                   	; Selectionne une colonne du clavier et laisse le resultat lisible en (ki_in).
000000                   	; Le NOP est un delai de stabilisation : ne pas le retirer.
000000                   	;
000000                   	;
0BE000                   		org	0be000h
0BE000                   	;
0BE000                   		pre_on
0BE000                   	;
0BE000                   	;-----------------------------------------------------------
0BE000                   	;       DEVICE-DRIVER INSTALLER
0BE000                   	;-----------------------------------------------------------
0BE000                   	;-----------------------------------------------------------
0BE000                   	;       DEVICE-DRIVER INSTALLER  (modele du template : ajout en fin)
0BE000                   	;-----------------------------------------------------------
0BE000                   	start:
0BE000                   	;  (0) lire l'argument de CALL : la chaine "-u" (ou "-U") lance la
0BE000                   	;      desinstallation, sinon on installe. L'argument doit etre entre
0BE000                   	;      GUILLEMETS (syntaxe BASIC), comme pour UUENCODE :
0BE000                   	;          CALL &BE000          -> installe
0BE000                   	;          CALL &BE000 "-u"     -> desinstalle
0BE000                   	;      La ligne de commande (avec ses guillemets) est en tete de la pile U ;
0BE000                   	;      le scan saute le guillemet ouvrant et cherche "-u".
0BE000 3C                		popu	x			; x = pointeur de ligne (empile par CALL)
0BE001 30 CC 00 00       		mv	(0),0			; (0) = 0 : installer ; sinon : desinstaller
0BE005 90 24             	sc_arg:	mv	a,[x++]
0BE007 60 00             		cmp	a,0
0BE009 18 1B             		jrz	sc_done
0BE00B 60 0D             		cmp	a,0dh
0BE00D 18 17             		jrz	sc_done
0BE00F 60 2D             		cmp	a,'-'
0BE011 1B 0E             		jrnz	sc_arg
0BE013 90 04             		mv	a,[x]
0BE015 60 75             		cmp	a,'u'
0BE017 18 06             		jrz	sc_setu
0BE019 60 55             		cmp	a,'U'
0BE01B 18 02             		jrz	sc_setu
0BE01D 13 1A             		jr	sc_arg
0BE01F                   	sc_setu:
0BE01F 08 01             		mv	a,1
0BE021 30 A0 00          		mv	(0),a
0BE024 13 21             		jr	sc_arg
0BE026                   	sc_done:
0BE026                   	;      RESTITUER a BASIC le pointeur de ligne AVANCE au-dela de l'argument
0BE026                   	;      (protocole UUENCODE : popu a l'entree, pushu du pointeur avance a la
0BE026                   	;      sortie). Sans ce pushu, BASIC ne retrouve pas ou reprendre -> 'Syntax
0BE026                   	;      error' au retour d'un CALL suivi d'un argument.
0BE026 7C 04             		dec	x			; revenir sur le terminateur de l'argument
0BE028 2C                		pushu	x
0BE029 30 80 00          		mv	a,(0)
0BE02C 60 00             		cmp	a,0
0BE02E 18 03             		jrz	sc_install
0BE030 02 C3 E1          		jp	uninstall
0BE033                   	sc_install:
0BE033                   	;  (1) banniere
0BE033 0C 6F E1 0B       		mv	x,msg0
0BE037 0D 16 00 00       		mv	y,btm0-msg0
0BE03B 30 CC D6 00       		mv	(cl),0
0BE03F 09 04             		mv	il,4
0BE041 05 E4 FF 0F       		callf	fcs_call
0BE045                   	;  sauver le vecteur clavier et IMR (le pilote les restaure)
0BE045 8C CC FC 0B       		mv	x,[keyvct]
0BE049 AC 7B E7 0B       		mv	[save_vct],x
0BE04D 30 80 FB          		mv	a,(imr_p)
0BE050 A8 7E E7 0B       		mv	[save_imr],a
0BE054                   	;  (2) compacter S1: (regrouper l'espace libre en fin de zone)
0BE054 30 CC D6 06       		mv	(cl),6
0BE058 30 CC D7 00       		mv	(ch),0
0BE05C 0B 47 00          		mv	i,47h
0BE05F 05 E8 FF 0F       		callf	iocs_call
0BE063                   	;  (3) parcourir jusqu'a la FIN des blocs ; detecter un doublon par le nom
0BE063 8C 15 FC 0B       		mv	x,[s1_top]
0BE067 95 84 12          		mv	y,[x+12h]
0BE06A 45 45             		add	x,y
0BE06C 90 04             	walk:	mv	a,[x]
0BE06E 60 FB             		cmp	a,blk_id
0BE070 1A 15             		jrnz	walk_end
0BE072 0D E0 E2 0B       		mv	y,block_top
0BE076 09 0C             		mv	il,12
0BE078 2C                		pushu	x
0BE079 05 54 E1 0B       		callf	stricmp
0BE07D 3C                		popu	x
0BE07E 18 B6             		jrz	exit2
0BE080 95 84 11          		mv	y,[x+11h]
0BE083 45 45             		add	x,y
0BE085 13 1B             		jr	walk
0BE087                   	walk_end:
0BE087 30 A4 0A          		mv	(10),x			; destination = fin des blocs (ajout en fin)
0BE08A                   	;  (4) controle memoire : libre = bas_de_S1 - fin_des_blocs >= taille
0BE08A 8D DE FC 0B       		mv	y,[s1_btm]
0BE08E 7C 05             		dec	y
0BE090 4D 54             		sub	y,x
0BE092 30 A5 10          		mv	(16),y
0BE095 0D D5 0C 00       		mv	y,block_bottom-block_top
0BE099 30 D7 05 10       		cmpp	(16),y
0BE09D 1C A1             		jrc	exit3
0BE09F                   	;  (5) sauver le handler device #11 d'origine (pour le chainage de 'RG3:')
0BE09F 0C A2 FC 0B       		mv	x,d_link
0BE0A3 08 00             		mv	a,0
0BE0A5 A8 0F E3 0B       		mv	[iocs_found],a
0BE0A9 FD 54             	srch:	mv	y,x
0BE0AB 94 04             		mv	x,[x]
0BE0AD 6C 04             		inc	x
0BE0AF 18 16             		jrz	srch_end
0BE0B1 7C 04             		dec	x
0BE0B3 90 84 03          		mv	a,[x+3]
0BE0B6 60 0B             		cmp	a,11
0BE0B8 1B 11             		jrnz	srch
0BE0BA 94 84 05          		mv	x,[x+5]
0BE0BD AC 10 E3 0B       		mv	[iocs_eleven],x
0BE0C1 08 01             		mv	a,1
0BE0C3 A8 0F E3 0B       		mv	[iocs_found],a
0BE0C7                   	srch_end:
0BE0C7                   	;  (6) chainer le nouveau device en tete de la liste IOCS
0BE0C7 8C A2 FC 0B       		mv	x,[d_link]
0BE0CB AC 02 E3 0B       		mv	[header],x
0BE0CF 30 84 0A          		mv	x,(10)
0BE0D2 09 22             		mv	il,iocs_header-block_top
0BE0D4 45 41             		add	x,il
0BE0D6 AC A2 FC 0B       		mv	[d_link],x
0BE0DA                   	;  (7) relocation (mecanisme de REGISTER : site pN, l'installateur lit [pN+1])
0BE0DA 0C B5 EF 0B       		mv	x,modify_table
0BE0DE 95 24             	init_3:	mv	y,[x++]
0BE0E0 6C 05             		inc	y
0BE0E2 18 15             		jrz	modify_end
0BE0E4 2C                		pushu	x
0BE0E5 94 05             		mv	x,[y]
0BE0E7 2D                		pushu	y
0BE0E8 0D E0 E2 0B       		mv	y,block_top
0BE0EC 4D 45             		sub	x,y
0BE0EE 30 85 0A          		mv	y,(10)
0BE0F1 45 45             		add	x,y
0BE0F3 3D                		popu	y
0BE0F4 B4 05             		mv	[y],x
0BE0F6 3C                		popu	x
0BE0F7 13 1B             		jr	init_3
0BE0F9                   	modify_end:
0BE0F9                   	;  (8) copier le pilote en fin de chaine, puis ecrire le terminateur $ff
0BE0F9 0B D5 0C          		mv	i,block_bottom-block_top
0BE0FC 30 85 0A          		mv	y,(10)
0BE0FF 0C E0 E2 0B       		mv	x,block_top
0BE103 90 24             	init_5:	mv	a,[x++]
0BE105 B0 25             		mv	[y++],a
0BE107 7C 03             		dec	i
0BE109 1B 08             		jrnz	init_5
0BE10B 08 FF             		mv	a,0ffh
0BE10D B0 05             		mv	[y],a
0BE10F                   	;  (9) accrocher le vecteur clavier au handler du pilote (adresse relocalisee)
0BE10F 2F                		pushu	imr
0BE110 0C 74 00 00       		mv	x,int_entry-block_top
0BE114 30 85 0A          		mv	y,(10)
0BE117 45 45             		add	x,y
0BE119 AC CC FC 0B       		mv	[keyvct],x
0BE11D 38                		popu	a
0BE11E 78 04             		or	a,keym
0BE120 28                		pushu	a
0BE121 3F                		popu	imr
0BE122                   	;  succes : aucun fichier decale -> aucun recalage BASIC
0BE122 0C 85 E1 0B       		mv	x,msg1
0BE126 0D 0C 00 00       		mv	y,btm1-msg1
0BE12A 30 CC D6 00       		mv	(cl),0
0BE12E 09 04             		mv	il,4
0BE130 05 E4 FF 0F       		callf	fcs_call
0BE134 9F                		rc
0BE135 07                		retf
0BE136                   	;  erreurs : message + retour (carry), sans toucher a BASIC
0BE136 0C 91 E1 0B       	exit2:	mv	x,msg2
0BE13A 0D 17 00 00       		mv	y,btm2-msg2
0BE13E 12 08             		jr	exit_err
0BE140 0C A8 E1 0B       	exit3:	mv	x,msg3
0BE144 0D 1B 00 00       		mv	y,btm3-msg3
0BE148                   	exit_err:
0BE148 30 CC D6 00       		mv	(cl),0
0BE14C 09 04             		mv	il,4
0BE14E 05 E4 FF 0F       		callf	fcs_call
0BE152 97                		sc
0BE153 07                		retf
0BE154                   	;  helper : comparaison de chaine sur IL octets
0BE154                   	stricmp:
0BE154 30 E0 24 00       		mv	(0),[x++]
0BE158 90 25             		mv	a,[y++]
0BE15A 30 61 00 00       		cmp	(0),0
0BE15E 18 0A             		jrz	stricmp1
0BE160 30 63 00          		cmp	(0),a
0BE163 1A 09             		jrnz	stricmp2
0BE165 7C 01             		dec	il
0BE167 1B 15             		jrnz	stricmp
0BE169 07                		retf
0BE16A                   	stricmp1:
0BE16A 30 63 00          		cmp	(0),a
0BE16D 07                		retf
0BE16E                   	stricmp2:
0BE16E 07                		retf
0BE16F                   	;  messages
0BE16F 52 45 47 49 53 54 	msg0:	db	'REGISTER3 (template)',13,10
0BE175 45 52 33 20 28 74 	
0BE17B 65 6D 70 6C 61 74 	
0BE181 65 29 0D 0A       	
0BE185                   	btm0:
0BE185 49 6E 73 74 61 6C 	msg1:	db	'Installed.',13,10
0BE18B 6C 65 64 2E 0D 0A 	
0BE191                   	btm1:
0BE191 45 72 72 6F 72 3A 	msg2:	db	'Error: already exist.',13,10
0BE197 20 61 6C 72 65 61 	
0BE19D 64 79 20 65 78 69 	
0BE1A3 73 74 2E 0D 0A    	
0BE1A8                   	btm2:
0BE1A8 45 72 72 6F 72 3A 	msg3:	db	'Error: not enough memory.',13,10
