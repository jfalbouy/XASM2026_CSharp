0BE26C 20 52 47 33 3A 0D 	
0BE272 0A                	
0BE273                   	btm_un:
0BE273 55 6E 69 6E 73 74 	msg_ok:	db	'Uninstalled. To free memory :',13,10
0BE279 61 6C 6C 65 64 2E 	
0BE27F 20 54 6F 20 66 72 	
0BE285 65 65 20 6D 65 6D 	
0BE28B 6F 72 79 20 3A 0D 	
0BE291 0A                	
0BE292 53 45 54 20 20 22 		db	'SET  "S1:'
0BE298 53 31 3A          	
0BE29B 52 45 47 49 53 54 		db	'REGIST3'
0BE2A1 33                	
0BE2A2 2E                		db	'.'
0BE2A3 53 59 53          		db	'SYS'
0BE2A6 22 2C 22 20 22 0D 		db	'"," "',13,10
0BE2AC 0A                	
0BE2AD 4B 49 4C 4C 20 22 		db	'KILL "S1:'
