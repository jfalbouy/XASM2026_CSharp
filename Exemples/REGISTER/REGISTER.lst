0BE000                   	start:
0BE000 0C 2C E2 0B       		mv	x,msg0				;DISPLAY *TITLE* MESSAGE
0BE004 0D 19 00 00       		mv	y,btm0-msg0			;Longueur du texte à afficher
0BE008 30 CC D6 00       		mv	(cl),0				;Writing a block of the file
0BE00C 09 04             		mv	il,4				;x est l'adresse de la chaine
0BE00E 05 E4 FF 0F       		callf	fcs_call		;affichage
0BE012                   	;
0BE012 8C CC FC 0B       		mv	x,[keyvct]			;lecture du vecteur d'interruption du clavier
0BE016 AC 3D E7 0B       		mv	[save_vct],x		;sauvegarde du vecteur d'origine
0BE01A 30 80 FB          		mv	a,(0fbh)			;lecture de IMR
0BE01D A8 40 E7 0B       		mv	[save_imr],a		;sauvegarde de la valeur
0BE021                   	;
0BE021 30 CC D6 06       		mv	(cl),6				;compress the space in each memory block
0BE025 30 CC D7 00       		mv	(ch),0				;"S1:"
0BE029 0B 47 00          		mv	i,47h				;lancement de la procédure
0BE02C 05 E8 FF 0F       		callf	iocs_call		;compress memory
0BE030                   	;
0BE030 8C 15 FC 0B       		mv	x,[s1_top]			;top of "S1:"
0BE034 95 84 12          		mv	y,[x+12h]			;data block or lead address, pointe sur FB ou FF
0BE037 45 45             		add	x,y					;pointer sur le début du block
0BE039 30 A4 0A          		mv	(10),x				;sauvegarde de la valeur
0BE03C                   	;
0BE03C 90 04             	init_1:	mv	a,[x]			;SEARCH  end of 'device driver'
0BE03E 60 FB             		cmp	a,0fbh				;lecture de l'identification du nom de block
0BE040 1A 2C             		jrnz	block_end		;saut si fin de lecture des blocks
0BE042 0D A2 E2 0B       		mv	y,block_top			;se positionner sur le début du header du nouveau driver
0BE046 09 0C             		mv	il,12				;nombre de caractères à lire
0BE048 2C                		pushu	x				;sauvegarde de l'adresse du header en cours
0BE049 05 11 E2 0B       		callf	stricmp			;comparer celui installé vs celui à installer	
0BE04D 3C                		popu	x				;récupérer l'adresse du header
0BE04E 18 FA             		jrz	exit2				;"ERROR: ALREADY EXIST!!"
0BE050 90 84 0C          		mv	a,[x+12]			;lecture de l'attribut du driver: $25 (Protected)
0BE053 64 0C             		test	a,0ch			;check ATTR (Device & Protect)
0BE055 18 07             		jrz	set_start			;saut si c'est le cas
0BE057 95 84 11          		mv	y,[x+11h]			;lire la longueur du block jusqu'au prochain bloc
0BE05A 45 45             		add	x,y					;se positionner sur le début du prochain bloc
0BE05C 13 22             		jr	init_1				;boucler sur la lecteur des drivers blocks
0BE05E                   	;
0BE05E                   	set_start:					
0BE05E 30 A4 0A          		mv	(10),x				;sauvegarde de l'adresse du bloc du nouveau header
0BE061 90 04             	init_2:	mv	a,[x]			;SEARCH  end of 'memory block'
0BE063 60 FB             		cmp	a,0fbh				;la fin des blocs est indiquée par $FF
0BE065 1A 07             		jrnz	block_end		;saut si on a atteint le dernier bloc
0BE067 95 84 11          		mv	y,[x+11h]			;lire la longueur du block jusqu'au prochain bloc
0BE06A 45 45             		add	x,y					;se positionner sur le début du prochain bloc
0BE06C 13 0D             		jr	init_2				;boucler sur la lecteur des drivers blocks
0BE06E                   	;
0BE06E                   	block_end:
0BE06E 30 A4 0D          		mv	(13),x				;sauvegarde de l'adresse du dernier bloc
0BE071 8D DE FC 0B       		mv	y,[s1_btm]			;end of "S1:" + 1
0BE075 7C 05             		dec	y					;se positionner sur l'adresse de fin de "S1:"
0BE077 4D 54             		sub	y,x					;longueur du bloc
0BE079 30 A5 10          		mv	(16),y				;sauvegarde de l'adresse
0BE07C 0D D5 0C 00       		mv	y,block_bottom - block_top	;longueur du nouveau driver
0BE080 30 D7 05 10       		cmpp	(16),y			;sauvegarde de l'adresse
0BE084 1C CE             		jrc	exit3				;"ERROR: NOT enough memory!!"
0BE086                   	;
0BE086 0C A2 FC 0B       		mv	x,d_link			;device link pointer
0BE08A 08 00             		mv	a,0					
0BE08C A8 D1 E2 0B       		mv	[iocs_found],a		;sauvegarde du flag
0BE090 FD 54             	srch:	mv	y,x				;SEARCH original  iocs No.11
0BE092 94 04             		mv	x,[x]				;si $FF alors fin des drivers, inc x = 0
0BE094 6C 04             		inc	x
0BE096 18 16             		jrz	srch_end			;si zéro alors fin des drivers
0BE098 7C 04             		dec	x					;revenir à la valeur de départ
0BE09A 90 84 03          		mv	a,[x+3]				;lire le device number
0BE09D 60 0B             		cmp	a,11				;DEVICE NUMBER is No.11
0BE09F 1B 11             		jrnz	srch			;boucler tant que non atteint
0BE0A1 94 84 05          		mv	x,[x+5]				;lecture de l'adresse de IOCS correspondant
0BE0A4 AC D2 E2 0B       		mv	[iocs_eleven],x		;sauvegarde de cette adresse
0BE0A8 08 01             		mv	a,1					;flag = 1 car trouvé le bon device number
0BE0AA A8 D1 E2 0B       		mv	[iocs_found],a		;sauvegarde du flag
0BE0AE                   	srch_end:
0BE0AE                   	;
0BE0AE 8C A2 FC 0B       		mv	x,[d_link]			;device driver pointer
0BE0B2 AC C4 E2 0B       		mv	[header],x			;sauvegarde de l'ancienne adresse
0BE0B6 30 84 0A          		mv	x,(10)				;lecture de l'adresse du 1° header
0BE0B9 09 22             		mv	il,022h				;
0BE0BB 45 41             		add	x,il
0BE0BD AC A2 FC 0B       		mv	[d_link],x			; Put into device link
0BE0C1                   	;
0BE0C1                   	;Réallocation des adresses avant copie du nouveau driver
0BE0C1 0C 77 EF 0B       		mv	x,modify_table		;se positionner sur la table des vecteurs
0BE0C5 95 24             	init_3:	mv	y,[x++]			;lire une adresse dans la table	
0BE0C7 6C 05             		inc	y					;-1 indique la fin de la table sinon adresse réelle à modifier
0BE0C9 18 15             		jrz	modify_end			;saut si fin de table
0BE0CB 2C                		pushu	x				;sauvegarde de l'indice prochain de la table
0BE0CC 94 05             		mv	x,[y]				;lire l'adresse à modifier
0BE0CE 2D                		pushu	y				;sauvegarde de l'adresse lue dans la table
0BE0CF 0D A2 E2 0B       		mv	y,block_top			;se positionner sur le début du nouveau header driver
0BE0D3 4D 45             		sub	x,y					;nombre d'octets de décalage
0BE0D5 30 85 0A          		mv	y,(10)				;récupérer l'adresse de début du programme	
0BE0D8 45 45             		add	x,y					;calcul de la nouvelle adresse fonction de son implantation
0BE0DA 3D                		popu	y				;
0BE0DB B4 05             		mv	[y],x				;implantation de l'adresse recalculée
0BE0DD 3C                		popu	x				;se positionner sur l'indice suivant
0BE0DE 13 1B             		jr	init_3				;boucler tant que non fin de table
0BE0E0                   	;
0BE0E0                   	modify_end:
0BE0E0 30 84 0D          		mv	x,(13)				;adresse du dernier block header
0BE0E3 30 85 0A          		mv	y,(10)				;adresse du premier IOCS header
0BE0E6 4D 45             		sub	x,y					;longueur du bloc à déplacer
0BE0E8 30 A4 10          		mv	(16),x				;sauvegarde de la valeur	
0BE0EB 30 84 0D          		mv	x,(13)				;adresse du dernier block header
0BE0EE FD 54             		mv	y,x					;affectation dans y
0BE0F0 0A D5 0C          		mv	ba,block_bottom - block_top		;taille du driver à installer
0BE0F3 45 52             		add	y,ba				;calcul de la nouvelle adresse
0BE0F5 6C 04             		inc	x					;se positionner en +1
0BE0F7 6C 05             		inc	y					;se positionner en +1
0BE0F9                   	;
0BE0F9 90 34             	init_6:	mv	a,[--x]			;move memory block
0BE0FB B0 35             		mv	[--y],a				;
0BE0FD 30 80 10          		mv	a,(16)				;lecture du compteur poids fort
0BE100 48 01             		sub	a,1					;décrémentation du compteur
0BE102 30 A0 10          		mv	(16),a				;sauvegarde du compteur
0BE105 1F 0E             		jrnc	init_6			;boucler tant que pas tout lu
0BE107 30 80 11          		mv	a,(17)				;lecture du compteur poids moyen
0BE10A 48 01             		sub	a,1					;décrémentation du compteur
0BE10C 30 A0 11          		mv	(17),a				;sauvegarde du compteur
0BE10F 1F 18             		jrnc	init_6			;boucler tant que pas tout lu
0BE111 30 80 12          		mv	a,(18)				;lecture du compteur poids faible
0BE114 48 01             		sub	a,1					;décrémentation du compteur
0BE116 30 A0 12          		mv	(18),a				;sauvegarde du compteur
0BE119 1F 22             		jrnc	init_6			;boucler tant que pas tout lu
0BE11B                   	;
0BE11B 0B D5 0C          		mv	i,block_bottom - block_top		;taille du code à copier
0BE11E 30 85 0A          		mv	y,(10)				;adresse du premier IOCS header
0BE121 0C A2 E2 0B       		mv	x,block_top			;adresse du header du nouveau driver
0BE125 90 24             	init_5:	mv	a,[x++]			;transfer device driver
0BE127 B0 25             		mv	[y++],a				;copie du code du nouveau driver
0BE129 7C 03             		dec	i					;décrémentation du compteur
0BE12B 1B 08             		jrnz	init_5			;boucler tant que pas tout lu
0BE12D                   	;
0BE12D                   	exit:
0BE12D 2F                		pushu	imr				;sauvegarde du registre du masque d'interruption
0BE12E 0C 74 00 00       		mv	x,int_entry - block_top		;taille pour atteindre l'adresse du nouveau vecteur d'interruption clavier
0BE132 30 85 0A          		mv	y,(10)				;adresse du premier IOCS header
