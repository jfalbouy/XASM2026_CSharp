000000                   	key_BS:		equ	$08
000000                   	key_cce:	equ $0c
000000                   	key_right:	equ $1c
000000                   	key_left:	equ	$1d
000000                   	key_up:		equ $1e
000000                   	;
000000                   	;- Mémoire programme ---
