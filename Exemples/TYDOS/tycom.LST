000000                   	dh:			equ	$d9
000000                   	dx:			equ	$d8
000000                   	si:			equ	$da
000000                   	di:			equ	$dd
000000                   	;
000000                   	scr:		equ $fd
000000                   	;-----------------------
000000                   	;
000000                   	;- Touches -------------
000000                   	key_ctrlc:	equ $03
