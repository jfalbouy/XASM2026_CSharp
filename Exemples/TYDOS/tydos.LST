0BF907                   	;           													* 
0BF907                   	; IL = 1, run_il		Lecture du fichier TYCOM.SYS            *
0BF907                   	; IL = 2, run_il2		Lecture buffer fichier		            *
0BF907                   	; IL = 3, run_il3		Exécution de TYCOM.SYS                  *
