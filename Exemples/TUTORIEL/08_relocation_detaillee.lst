000000                   	; ==========================================================================
000000                   	;  08_relocation_detaillee.asm - LA RELOCATION A62, DEMONTREE ET TESTABLE
000000                   	;
000000                   	;  La relocation est le mecanisme le plus subtil de XASM2026-4. Ce programme la
000000                   	;  demontre en la faisant TOURNER sur le Sharp (contrairement aux autres exemples
000000                   	;  du dossier). Il :
000000                   	;    1. copie un petit CORPS relogeable a une AUTRE adresse (demo_buffer) ;
000000                   	;    2. SABOTE le message d'origine (pour prouver que la copie ne le lit plus) ;
000000                   	;    3. applique la TABLE DE RELOCATION generee par 'rel' pour corriger la copie ;
000000                   	;    4. execute la copie relocalisee.
000000                   	;
000000                   	;  Resultat a l'ecran :
000000                   	;    - "RELOC. REUSSIE"  -> la copie lit son message A SA NOUVELLE ADRESSE : OK.
000000                   	;    - "ECHEC RELOC."    -> (n'arrive pas) la copie aurait lu l'original sabote.
000000                   	;
000000                   	;  Deployer :   xasm2026-4 08_relocation_detaillee.asm -O RELODEMO.OBJ -B 08_relocation_detaillee.uu
000000                   	;  Puis sur le Sharp :  LOADM "x:RELODEMO.OBJ"  puis  CALL &BF000
000000                   	;
000000                   	;  INSPECTER la relocation avec PEEK (apres le CALL) : le champ d'adresse du
000000                   	;  'mv x' de la COPIE est en 0BF091h. Avant le CALL il vaudrait l'adresse a la
000000                   	;  base ; apres, il a ete corrige vers la copie :
000000                   	;     PRINT HEX$ PEEK &BF091; HEX$ PEEK &BF092; HEX$ PEEK &BF093
000000                   	;  affiche  A3 F0 0B  (soit 0BF0A3h = le message DANS la copie).
000000                   	; ==========================================================================
000000                   	
0BF000                   		org	0BF000H
0BF000                   		pre_on				; adressage RAM interne absolu
0BF000                   	
0BF000                   	; --- constantes systeme ---
0BF000                   	fcs_call:	equ	0FFFE4H		; appel FCS (affichage)
0BF000                   	cl:		equ	0D6H		; handle : 0 = ecran
0BF000                   	
0BF000                   	; --- macro A62 : 'bsr X' = 'rel call X' (rappel ; non utilisee ici) ---
0BF000                   	
0BF000                   	; ==========================================================================
0BF000                   	;  PROGRAMME (lance par CALL &BF000)
0BF000                   	; ==========================================================================
0BF000                   	start:
0BF000 3C                		popu	x			; pointeur de ligne BASIC
0BF001 2C                		pushu	x			; ... restitue -> retour propre (pas de Syntax error)
0BF002                   	
0BF002                   	;  (1) COPIER le corps relogeable a demo_buffer (une autre adresse).
0BF002                   	;      Le corps est assemble a 'corps' ; on le copie tel quel, ses adresses
0BF002                   	;      absolues pointent donc encore vers 'corps' -> il faut les corriger.
0BF002 0B 23 00          		mv	i,fin_corps-corps
0BF005 0D 90 F0 0B       		mv	y,demo_buffer
0BF009 0C 5D F0 0B       		mv	x,corps
0BF00D 90 24             	cp_lp:	mv	a,[x++]
0BF00F B0 25             		mv	[y++],a
0BF011 7C 03             		dec	i
0BF013 1B 08             		jrnz	cp_lp
0BF015                   	
0BF015                   	;  (2) SABOTER l'original : ecraser le message d'origine par un message d'echec
0BF015                   	;      (meme longueur). Ainsi, si la copie relisait l'original (relocation ratee),
0BF015                   	;      on verrait "ECHEC RELOC.". La copie, elle, garde le bon message.
0BF015 0B 10 00          		mv	i,btm_ok-msg_ok
0BF018 0D 70 F0 0B       		mv	y,msg_ok
0BF01C 0C 80 F0 0B       		mv	x,msg_echec
0BF020 90 24             	sb_lp:	mv	a,[x++]
0BF022 B0 25             		mv	[y++],a
0BF024 7C 03             		dec	i
0BF026 1B 08             		jrnz	sb_lp
0BF028                   	
0BF028                   	;  (3) RELOCALISER la copie a l'aide de la table generee par 'rel'.
0BF028                   	;      Le point de depart du parcours compense le fait que les deltas de la
0BF028                   	;      table sont comptes depuis l'ORG (0BF000h), alors que la copie demarre
0BF028                   	;      a demo_buffer :   depart = demo_buffer - (corps - ORG).
0BF028                   	;      Pour chaque site : nouvelle_valeur = valeur - corps + demo_buffer.
0BF028 0C 90 F0 0B       		mv	x,demo_buffer
0BF02C 0A 5D 00          		mv	ba,corps-0BF000H	; offset de 'corps' depuis l'ORG (constante)
0BF02F 4D 42             		sub	x,ba
0BF031 FD 54             		mv	y,x			; y = pointeur de parcours (walker)
0BF033 0C D0 F0 0B       		mv	x,table_reloc		; x = pointeur de lecture de la table
0BF037 90 24             	rl_lp:	mv	a,[x++]			; lire un octet de table
0BF039 60 FF             		cmp	a,0FFH
0BF03B 18 1A             		jrz	rl_fin			; 0FFh -> fin de table
0BF03D 70 7F             		and	a,7FH			; delta (on ignore le bit de largeur : on corrige 3 octets)
0BF03F 45 50             		add	y,a			; walker += delta -> pointe le champ d'adresse dans la copie
0BF041 2C                		pushu	x			; sauver le pointeur de table
0BF042 94 05             		mv	x,[y]			; x = adresse gravee (3 octets)
0BF044 2D                		pushu	y
0BF045 0D 5D F0 0B       		mv	y,corps
0BF049 4D 45             		sub	x,y			; - base d'assemblage (corps)
0BF04B 0D 90 F0 0B       		mv	y,demo_buffer
0BF04F 45 45             		add	x,y			; + adresse de destination (demo_buffer)
0BF051 3D                		popu	y			; restaurer le walker
0BF052 B4 05             		mv	[y],x			; reecrire l'adresse corrigee
0BF054 3C                		popu	x			; restaurer le pointeur de table
0BF055 13 20             		jr	rl_lp
0BF057                   	rl_fin:
0BF057                   	
0BF057                   	;  (4) EXECUTER la copie relocalisee. Son 'mv x,msg_ok' a ete corrige pour
0BF057                   	;      pointer le message DANS LA COPIE : elle affiche donc "RELOC. REUSSIE".
0BF057 05 90 F0 0B       		callf	demo_buffer
0BF05B                   	
0BF05B 9F                		rc				; carry clair -> retour propre a BASIC
0BF05C 07                		retf
0BF05D                   	
0BF05D                   	; ==========================================================================
0BF05D                   	;  LE CORPS RELOGEABLE  (copie en demo_buffer, puis relocalise)
0BF05D                   	;  Il ne contient qu'UNE adresse absolue a reloger : 'mv x,msg_ok'.
0BF05D                   	;  ('callf fcs_call' vise la ROM, adresse fixe : PAS relogee.)
0BF05D                   	; ==========================================================================
0BF05D                   	corps:
0BF05D 0C 70 F0 0B       		rel	mv x,msg_ok		; <-- SITE de relocation (champ 3 octets)
0BF061 0D 10 00 00       		mv	y,btm_ok-msg_ok
0BF065 30 CC D6 00       		mv	(cl),0
0BF069 09 04             		mv	il,4
0BF06B 05 E4 FF 0F       		callf	fcs_call
0BF06F 07                		retf
0BF070 52 45 4C 4F 43 2E 	msg_ok:	db	'RELOC. REUSSIE',13,10
0BF076 20 52 45 55 53 53 	
0BF07C 49 45 0D 0A       	
0BF080                   	btm_ok:
0BF080                   	fin_corps:
0BF080                   	
0BF080                   	; --------------------------------------------------------------------------
0BF080                   	;  Donnees de l'installateur (NON copiees, apres fin_corps).
0BF080                   	; --------------------------------------------------------------------------
0BF080 45 43 48 45 43 20 	msg_echec:	db	'ECHEC RELOC.  ',13,10	; MEME longueur que msg_ok
0BF086 52 45 4C 4F 43 2E 	
0BF08C 20 20 0D 0A       	
0BF090                   	
0BF090 00 00 00 00 00 00 	demo_buffer:	ds	64		; zone ou l'on copie le corps
0BF096 00 00 00 00 00 00 	
0BF09C 00 00 00 00 00 00 	
0BF0A2 00 00 00 00 00 00 	
0BF0A8 00 00 00 00 00 00 	
0BF0AE 00 00 00 00 00 00 	
0BF0B4 00 00 00 00 00 00 	
0BF0BA 00 00 00 00 00 00 	
0BF0C0 00 00 00 00 00 00 	
0BF0C6 00 00 00 00 00 00 	
0BF0CC 00 00 00 00       	
0BF0D0                   	
0BF0D0                   	;  'table_reloc' est place juste avant END : c'est donc l'adresse ou la table
0BF0D0                   	;  de relocation generee sera ajoutee. Le programme la lit a cet endroit.
0BF0D0                   	table_reloc:
0BF0D0                   		end

  No fatal error.  Code: 0BF000h - 0BF0D1h [      210 byte(s)]
