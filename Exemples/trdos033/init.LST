0BF400                   	;			Parcours ligne de commande
0BF400                   	;
0BF400                   	;--------------------------------------------------
0BF400 3C                	start: 	popu x						;récupérer adresse ligne de commande
0BF401 2C                			pushu x						;sauvegarder pour retour de la routine
0BF402 90 04             	st1:	mv a,[x]					;lire le caractère en cours
0BF404 60 3A             			cmp a,':'	
0BF406 18 1C             			jrz st2						;saut si trouvé ':'
0BF408 60 22             			cmp a, '""'					
0BF40A 19 0A             			jrz st1						;saut si trouvé "
0BF40C 60 0D             			cmp a,CR
0BF40E 1B 0E             			jrnz st1					;boucler tant que non fin de ligne
0BF410                   			;erreur dans la ligne de commande
