000000                   	bl:	equ	0d4h
000000                   	bh:	equ	0d5h
000000                   	cl:	equ	0d6h
000000                   	ch:	equ	0d7h
000000                   	dl:	equ	0d8h
000000                   	dh:	equ	0d9h
