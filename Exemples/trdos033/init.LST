0BF412 30 CC D6 00       			mv (cx),00h					;file handle
0BF416 0C 76 F4 0B       			mv x,data					;adresse de la chaine à afficher
0BF41A 0D 10 00 00       			mv y,16						;commpteur, 16 caractères pour le file name	
0BF41E 05 E4 FF 0F       			callf fcs_call				;5 bits / Drive name + 8 bits / file name + 3 bits / extension
0BF422 97                			sc
0BF423 07                			retf
0BF424                   			
