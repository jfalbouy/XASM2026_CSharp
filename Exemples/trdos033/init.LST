0BF425 0D 86 F4 0B       			mv y,endprg					;addresse de fin de programme
0BF429 09 06             			mv il,6						;écriture un bit dans le fichier
0BF42B 90 24             	st3:	mv a,[x++]					;lire un caractère de la ligne de commande
0BF42D 60 20             			cmp a,' '
0BF42F 19 06             			jrz st3						;boucler tant que SPACE
0BF431 60 22             			cmp a,'""'
0BF433 19 0A             			jrz st3						;boucler tant que "
0BF435 60 3A             			cmp a,':'
0BF437 18 0C             			jrz st4						;saut si lecture drive
0BF439 B0 25             			mv [y++],a					;copie du caractère dans le buffer
0BF43B 7C 01             			dec il						;décrémenter le compteur
0BF43D 1B 14             			jrnz st3					;boucler tant que non NUL
0BF43F 90 24             			mv a,[x++]					;lire ":" après DRIVE
0BF441 60 3A             			cmp a,':'
0BF443 1A 00             			jrnz st4
0BF445 B0 25             	st4:	mv [y++],a					;copie le caractère ':' dans le buffer
0BF447 08 00             			mv a,0
0BF449 B0 25             			mv [y++],a 					;copie du zéro terminal
0BF44B B4 37             			mv [--s],x					;empilement dans la pile système
0BF44D 90 24             	st5:	mv a,[x++]
0BF44F 60 22             			cmp a, '""'
0BF451 18 0A             			jrz st7						;boucler tant que "
0BF453 60 0D             			cmp a,CR
0BF455 18 04             			jrz st6						;saut si fin de ligne
0BF457 60 00             			cmp a,0
0BF459 1B 0E             			jrnz st5					;boucler tant que non NUL
0BF45B 7C 04             	st6:	dec x						;adresse de fin de chaine
0BF45D 2C                	st7:	pushu x						;sauvegarde l'addresse
0BF45E 0B 00 00          			mv i,0						;création du fichier
0BF461 0C 86 F4 0B       			mv x,endprg					;adresse du file name
0BF465 05 E8 FF 0F       			callf iocs_call			
0BF469 94 27             			mv x,[s++]					;dépiler l'adresse de la fin de chaine 
0BF46B 1D 5D             			jrc st11					;boucler en début de programme
0BF46D 0B 3F 00          			mv i,$3f					;formating LCD driver
0BF470 05 E8 FF 0F       			callf iocs_call
