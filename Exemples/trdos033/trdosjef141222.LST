0BE2A3                   	;
0BE2A3 0D 00             	ckm: db $0D, $00
0BE2A5                   	;-----------------------------------------------------------------------------------
0BE2A5                   	;
0BE2A5                   	;
0BE2A5                   	;--------------------------------------------------
0BE2A5                   	; Comparaison de deux chaines de caractères
0BE2A5                   	;
0BE2A5                   	; il : longueur de la chaine
0BE2A5                   	;  x : adresse de la chaine 1
0BE2A5                   	;  y : adresse de la chaine 2
0BE2A5                   	;--------------------------------------------------
0BE2A5                   	;
0BE2A5                   	stricmp:
0BE2A5 30 E0 24 00       			mv	(buffer),[x++]				;stockage du caractère en mémoire interne
0BE2A9 90 25             			mv	a,[y++]
0BE2AB 30 61 00 00       			cmp	(buffer),0					;vérification fin de chaine par zéro
0BE2AF 18 0A             			jrz	stricmp1					;saut si fin de chaine	
0BE2B1 30 63 00          			cmp	(buffer),a					;comparaison des caractères
0BE2B4 1A 08             			jrnz stricmp2					;retour si différent
0BE2B6 7C 01             			dec	il							;décrémenter le compteur
0BE2B8 1B 15             			jrnz stricmp					;boucler sur le traitement
0BE2BA 07                			retf
0BE2BB                   	stricmp1:
0BE2BB 30 63 00          			cmp	(buffer),a			;stocker le zéro terminal
0BE2BE                   	stricmp2:
0BE2BE 07                			retf
0BE2BF                   	;
0BE2BF                   	;--------------------------------------------------
0BE2BF                   	; Affichage d'une chaine de caractères
0BE2BF                   	;
0BE2BF                   	;  x : adresse de la chaine à afficher
0BE2BF                   	;  y : nombre de caractères
0BE2BF                   	;--------------------------------------------------
0BE2BF                   	;
0BE2BF 2C                	print:	pushu x							;stockage de l'adresse
0BE2C0 0D 00 00 00       			mv y,0							;compteur à zéro
0BE2C4 6C 05             	print1:	inc y							;incrémenter le compteur
0BE2C6 90 24             			mv a,[x++]						;lecture du caractère
0BE2C8 60 0A             			cmp a,$0a						;checke fin de chaine
0BE2CA 1B 08             			jrnz print1						;boucler sur tous les caractères
0BE2CC 3C                			popu x							;récupérer l'adresse de la chaine
0BE2CD 30 CD D6 00 00    			mvw (cx),0						;cl = file handle
0BE2D2 09 04             			mv il,4							;afficher la chaine
0BE2D4 05 E4 FF 0F       			callf fcs_call
0BE2D8 07                			retf
0BE2D9                   	;
0BE2D9                   	;--------------------------------------------------
0BE2D9                   	;				Format processing 
0BE2D9                   	;
0BE2D9                   	;Card is initialized in RAM file
0BE2D9                   	;Format is called out with INIT in BASIC program
0BE2D9                   	;--------------------------------------------------
0BE2D9                   	;
0BE2D9                   	init_lcd:
0BE2D9 09 3F             			mv il,$3f						;commande Format
0BE2DB 30 CD D6 00 00    			mvw (cx),0						;cl = file handle
0BE2E0 0C A3 E2 0B       			mv x,ckm						;adresse de la chaine CR + LF
0BE2E4 05 E8 FF 0F       			callf iocs_call					;Reset
0BE2E8 90 C7 07          			mv a,[s-7]						;empiler
0BE2EB 60 0C             			cmp a,$0c						;checke erreur
0BE2ED 1E 05             			jrnc lcd1						;saut si pas d'erreur
0BE2EF 30 CC 09 01       			mv (flagInstal),01				;flag = 1 si erreur
0BE2F3 07                			retf
0BE2F4 30 CC 09 00       	lcd1:	mv (flagInstal),00				;flag = 0 si non erreur
0BE2F8 07                			retf
