000000                   	;--- Constantes ---------------
000000                   	;-Mémoire interne --- 
000000                   	bl:			equ	0d4h
000000                   	bh:			equ	0d5h
000000                   	cl:			equ	0d6h
000000                   	ch:			equ	0d7h
000000                   	dl:			equ	0d8h
000000                   	dh:			equ	0d9h
000000                   	cx: 		equ 0d6h
000000                   	si:			equ	0dah
000000                   	bp: 		equ 0ech
000000                   	;
000000                   	buffer:		equ 0
000000                   	flagInstal:	equ 9
000000                   	blockAdr:	equ 10
000000                   	lstblocAdr:	equ 13
000000                   	freeSpace:	equ 16
000000                   	;--------------------
000000                   	;
000000                   	;-Utilisation --- 
000000                   	keyb: 		equ 0a0h				;key data check (CTRL+Z)
000000                   	;
000000                   	;- Mémoire externe --
000000                   	s2_top:		equ	0bfc0fh		;top  of "S2:"
000000                   	s2_siz:		equ	0bfc12h		;size of "S2:"
000000                   	s1_top:		equ	0bfc15h		;top  of "S1:"
000000                   	s1_siz:		equ	0bfc18h		;size of "S1:"
000000                   	s1_btm:		equ	0bfcdeh		;bottom of "S1:"
000000                   	d_link:		equ	0bfca2h		;device link pointer
000000                   	baswrk:		equ	0bfd0eh		;BASIC WORK Address
000000                   	keyvct:		equ	0bfccch		;key interrupt vector
000000                   	height:		equ 0bfc9eh
000000                   	defdrv:		equ 0bfc7dh
000000                   	fcs_call:	equ	0fffe4h
000000                   	iocs_call:	equ	0fffe8h
000000                   	usrwrk:		equ 0bfd1ah
000000                   	reset:		equ 0ffffdh		;jump to MENU
000000                   	;
000000                   	KOL:		equ 0f0h
000000                   	KOH:		equ 0f1h
000000                   	txtbas:		equ 0cbh
000000                   	datbas:		equ 0ceh
