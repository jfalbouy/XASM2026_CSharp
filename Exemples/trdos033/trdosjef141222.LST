000000                   	;-----------------------------
000000                   	;
000000                   	;
0BE000                   			org	0be000h
0BE000                   	;
0BE000                   			pre_on
0BE000                   	;
0BE000                   	;-----------------------------------------------------------
0BE000                   	;       DEVICE-DRIVER INSTALLER
0BE000                   	;-----------------------------------------------------------
0BE000                   	; Affichage du titre ---
0BE000                   	affTitle:
0BE000 05 D9 E2 0B       			callf init_lcd				;init LCD driver ~ cls
0BE004 0C E2 E1 0B       			mv	x,msg0					;DISPLAY *TITLE* MESSAGE
0BE008 05 BF E2 0B       			callf print					;affichage du message
0BE00C                   	;
0BE00C                   	; Recherche du drive name ---
0BE00C 09 00             			mv il,0						;création de fichier
0BE00E 0C 23 E3 0B       			mv x,dvname					;adresse de DOS:TRDOS:
0BE012 05 E8 FF 0F       			callf iocs_call				;appel de la fonction
0BE016 17 1B E1          			jpnc exit2					;saut si déjà installé
0BE019                   	;
0BE019                   	; Lecture de l'entrée de IOCS ---
0BE019 30 CC D6 00       			mv (cx),0					;CL = device number, CH = drive number
0BE01D 8C A2 FC 0B       			mv x,[d_link]				;lecture du IOCS header
0BE021 6C 04             			inc x
0BE023 7C 04             	link1:	dec x
0BE025 90 84 03          			mv a,[x+3]					;lecture du device number
0BE028 30 63 D6          			cmp (cx),a					;comparaison à la valeur recherchée
0BE02B 1E 03             			jrnc link2					;saut si inférieur à zéro
0BE02D 30 A0 D6          			mv (cx),a 					;sinon copie de la valeur lue
0BE030 94 04             	link2:	mv x,[x]					;lecture du prochain IOCS header
0BE032 6C 04             			inc x						;incrémentation pour check fin de parcours
0BE034 1B 13             			jrnz link1					;boucler tant que la fin n'est pas atteinte
0BE036 30 6D D6          			inc (cx)					;incrémentation du device number
0BE039 30 D8 1E E3 0B D6 			mv [drvNumber],(cx)			;stockage de la valeur pour ce nouveau programme
0BE03F                   	;
0BE03F                   	;Condense la mémoire S1: ---
0BE03F 30 CD D6 06 00    			mvw	(cx),6					;compress the space in each memory block of "S1:"
0BE044 09 47             			mv	il,47h					;lancement de la procédure
0BE046 05 E8 FF 0F       			callf iocs_call				;compress memory
0BE04A                   	;
0BE04A                   	;Verifie l'emplacement d'installation
0BE04A 8C 15 FC 0B       			mv	x,[s1_top]				;top of "S1:"
0BE04E 95 84 12          			mv	y,[x+18]				;data block or lead address, pointe sur FB ou FF
0BE051 45 45             			add	x,y						;pointer sur le début du block
0BE053 30 A4 0A          			mv	(blockAdr),x			;sauvegarde de l'adresse du début du bloc
0BE056 90 04             	loop1:	mv	a,[x]					;SEARCH  end of 'device driver'
0BE058 60 FB             			cmp	a,0fbh					;lecture de l'identification du nom de block
0BE05A 1A 1E             			jrnz	chksize				;saut si fin de lecture des blocks
0BE05C 90 84 0C          			mv	a,[x+12]				;lecture de l'attribut du driver: $25 (Protected)
0BE05F 64 0C             			test	a,12				;check ATTR (Device & Protect)
0BE061 18 07             			jrz loop2
0BE063 95 84 11          			mv	y,[x+17]				;lire la longueur du block jusqu'au prochain bloc
0BE066 45 45             			add	x,y						;se positionner sur le début du prochain bloc
0BE068 13 14             			jr loop1
0BE06A 30 A4 0A          	loop2:	mv (blockAdr),x 
0BE06D 90 04             	loop3:	mv a,[x]
0BE06F 60 FB             			cmp	a,0fbh					;lecture de l'identification du nom de block
0BE071 1A 07             			jrnz	chksize				;saut si fin de lecture des blocks
0BE073 95 84 11          			mv y,[x+17]
0BE076 45 45             			add x,y
0BE078 13 0D             			jr loop3
0BE07A                   	;	
0BE07A 30 A4 0D          	chksize: mv	(lstblocAdr),x			;sauvegarde de l'adresse du dernier bloc
0BE07D 8D DE FC 0B       			mv	y,[s1_btm]				;end of "S1:" + 1
0BE081 7C 05             			dec y
0BE083 4D 54             			sub	y,x						;calcul de la mémoire disponible
0BE085 30 A5 10          			mv	(freeSpace),y			;sauvegarde de la taille de la mémoire restante
0BE088 0D 7F 04 00       			mv y,block_bottom-block_top
0BE08C 30 D7 05 10       			cmpp (freeSpace),y
0BE090 1C 7D             			jrc	exit1					;"ERROR: NOT enough memory!!"
0BE092                   	;
0BE092                   	;Réallocation des adresses avant copie du nouveau driver
0BE092 0C 78 E7 0B       			mv	x,modify_table			;se positionner sur la table des vecteurs
0BE096 95 24             	init_3:	mv	y,[x++]					;lire une adresse dans la table	
0BE098 6C 05             			inc	y						;-1 indique la fin de la table sinon adresse réelle à modifier
0BE09A 18 15             			jrz	modify_end				;saut si fin de table
0BE09C 2C                			pushu	x					;sauvegarde de l'indice prochain dans la table
0BE09D 94 05             			mv	x,[y]					;lire l'adresse à modifier
0BE09F 2D                			pushu y						;sauvegarde de l'adresse lue dans la table
0BE0A0 0D F9 E2 0B       			mv	y,block_top				;se positionner sur le début du nouveau header driver
0BE0A4 4D 45             			sub	x,y						;nombre d'octets de décalage
0BE0A6 30 85 0A          			mv	y,(blockAdr)			;récupérer l'adresse de début du programme	
0BE0A9 45 45             			add	x,y						;calcul de la nouvelle adresse fonction de son implantation
0BE0AB 3D                			popu y						;
0BE0AC B4 05             			mv	[y],x					;implantation de l'adresse recalculée
0BE0AE 3C                			popu x						;se positionner sur l'indice suivant
0BE0AF 13 1B             			jr	init_3					;boucler tant que non fin de table
0BE0B1                   	;
0BE0B1                   	modify_end:
0BE0B1 8C A2 FC 0B       			mv x,[d_link]
0BE0B5 AC 20 E3 0B       			mv [adrs],x
0BE0B9 30 84 0D          			mv	x,(lstblocAdr)			;adresse du dernier block header
0BE0BC 30 85 0A          			mv	y,(blockAdr)			;adresse du premier IOCS header
0BE0BF 4D 45             			sub	x,y						;longueur du bloc à déplacer
0BE0C1 30 A4 DA          			mv	(si),x					;sauvegarde de la taille
0BE0C4 FD 45             			mv	x,y						;adresse source
0BE0C6 0B 7F 04          			mv	i,block_bottom - block_top	;taille du driver
0BE0C9 45 53             			add	y,i						;adresse de destination
0BE0CB 30 CD D6 06 00    			mvw	(cx),6					;transfert de bloc
0BE0D0 09 43             			mv	il,43h					;appel de la fonction
0BE0D2 05 E8 FF 0F       			callf	iocs_call			;x et y sont incrémentés de 1
0BE0D6 30 DC DA 7F 04 00 			mvp	(si),block_bottom-block_top	;taille du driver
0BE0DC 30 85 0A          			mv	y,(blockAdr)				;adresse source du IOCS header
0BE0DF 0C F9 E2 0B       			mv	x,block_top				;adresse du header du nouveau bloc
0BE0E3 30 CD D6 06 00    			mvw	(cx),6					;transfert du bloc driver
0BE0E8 09 43             			mv il,43h					;appel de la fonction
0BE0EA 05 E8 FF 0F       			callf	iocs_call			;appel de la fonction
0BE0EE 30 84 0A          			mv	x,(blockAdr)			;adresse source du IOCS header
0BE0F1 09 22             			mv	il,22h
0BE0F3 45 41             			add	x,il					;adresse source du IOCS header
0BE0F5 AC A2 FC 0B       			mv	[d_link],x				;modification de l'adresse
0BE0F9 05 D9 E2 0B       			callf init_lcd
0BE0FD                   	;		
0BE0FD 30 61 09 01       			cmp (flagInstal),1
0BE101 18 06             			jrz exit
0BE103                   	;		
0BE103 0C 04 E2 0B       			mv x,msg1					;programme installé
0BE107 12 28             			jr exit4
0BE109                   	;		
0BE109 0C 4A E2 0B       	exit:	mv x,msg1+70				;ms2 = BE24A ?			
0BE10D 12 22             			jr exit4
0BE10F                   	;		
0BE10F 30 61 09 01       	exit1:	cmp (flagInstal),1
0BE113 18 06             			jrz exit2
0BE115                   	;		
0BE115 0C 10 E2 0B       			mv x,msg3					;not enough memory
0BE119 12 16             			jr exit4	
0BE11B                   	;		
0BE11B 0C 59 E2 0B       	exit2:	mv x,msg1+85
0BE11F 12 10             			jr exit4
0BE121                   	;		
0BE121 30 61 09 01       			cmp (flagInstal),1
0BE125 18 06             			jrz exit3
0BE127                   	;		
0BE127 0C 24 E2 0B       			mv x,msg2					;BE224, programme déjà installé
0BE12B 12 04             			jr exit4
0BE12D                   	;		
0BE12D 0C 6D E2 0B       	exit3:	mv x,msg1+105				;BE26D
0BE131 05 BF E2 0B       	exit4:	callf print					;BE2BF
0BE135                   	;
0BE135                   	remake_slot:
0BE135 8C 0E FD 0B       			mv	x,[baswrk]				;BASIC WORK Address
0BE139 90 84 72          			mv	a,[x+114]
0BE13C 60 00             			cmp	a,0						;BTEXT$ is "S1:" ????
0BE13E 1A 30             			jrnz	remake_data
0BE140                   	;
0BE140                   	remake_text:
0BE140 0D 73 00 00       			mv	y,115
0BE144 45 54             			add	y,x						;BTEXT$ Address
0BE146 2D                			pushu	y
0BE147 8C 15 FC 0B       			mv	x,[s1_top]				;top of "S1:"
0BE14B 95 84 12          			mv	y,[x+18]
0BE14E 45 45             			add	x,y
0BE150 3D                			popu y
0BE151 90 04             	text1:	mv	a,[x]					;SEARCH  block 'TEXT.BAS'
0BE153 60 FB             			cmp	a,0fbh
0BE155 1A 56             			jrnz txtError
0BE157 09 0B             			mv	il,11
0BE159 2D                			pushu	y
0BE15A 2C                			pushu	x
0BE15B 6C 04             			inc	x
0BE15D 05 A5 E2 0B       			callf	stricmp				;BE2A5
0BE161 3C                			popu	x
0BE162 18 08             			jrz	text2
0BE164 95 84 11          			mv	y,[x+17]
0BE167 45 45             			add	x,y						;next block
0BE169 3D                			popu y
0BE16A 13 1B             			jr	text1
0BE16C 3D                	text2:	popu y
0BE16D 30 A4 CB          			mv	(txtbas),x				;set "TEXT.BAS"  Address
0BE170                   	;
0BE170                   	remake_data:
0BE170 8C 0E FD 0B       			mv	x,[baswrk]				;BASIC WORK Address
0BE174 90 84 7E          			mv	a,[x+126]
0BE177 60 00             			cmp	a,0						;BDATA$ is "S2:" ????
0BE179 1A 30             			jrnz remake_end				;BE1AB
0BE17B                   	;
0BE17B 0D 7F 00 00       			mv	y,127					;BDATA$ Address
0BE17F 45 54             			add	y,x
0BE181 2D                			pushu	y
0BE182 8C 15 FC 0B       			mv	x,[s1_top]				;top of "S1:"
0BE186 95 84 12          			mv	y,[x+18]
0BE189 45 45             			add	x,y
0BE18B 3D                			popu y
0BE18C 90 04             	data1:	mv	a,[x]					;SEARCH  block 'DATA.BAS'
0BE18E 60 FB             			cmp	a,0fbh
0BE190 1A 1B             			jrnz	txtError			;BE1AD
0BE192 09 0B             			mv	il,11
0BE194 2D                			pushu	y
0BE195 2C                			pushu	x
0BE196 6C 04             			inc	x
0BE198 05 A5 E2 0B       			callf	stricmp				;BE2A5
0BE19C 3C                			popu	x
0BE19D 18 08             			jrz	data2					;BE1A7
0BE19F 95 84 11          			mv	y,[x+17]
0BE1A2 45 45             			add	x,y						;next block
0BE1A4 3D                			popu	y
0BE1A5 13 1B             			jr	data1
0BE1A7 3D                	data2:	popu	y
0BE1A8 30 A4 CE          			mv	(datbas),x				;set "DATA.BAS"  Address
0BE1AB                   	remake_end:
0BE1AB 9F                			rc
0BE1AC 07                			retf
0BE1AD                   	;
0BE1AD                   	txtError:	
0BE1AD 30 61 09 01       			cmp (flagInstal),01
0BE1B1 18 06             			jrz kw2
0BE1B3 0C 34 E2 0B       			mv x,msg4				;BE1BD, push any key
0BE1B7 12 04             			jr kw3
0BE1B9 0C D9 E2 0B       	kw2:	mv x,init_lcd				
0BE1BD 05 BF E2 0B       	kw3:	callf print				;BE2BF
0BE1C1 2F                			pushu	imr
0BE1C2                   	;
0BE1C2                   	keywait:	
0BE1C2 30 CC F0 FF       			mv	(KOL),$ff			;KEY WAIT   until any key
0BE1C6 30 71 F1 F8       			and	(KOH),$f8			;111110000b
0BE1CA 00                			nop
0BE1CB 00                			nop
0BE1CC 30 80 F2          			mv	a,($f2)				;11110010b
0BE1CF 60 00             			cmp	a,$00				;no key ??
0BE1D1 19 11             			jrz	keywait
0BE1D3 30 CC F0 00       			mv	(KOL),$00
0BE1D7 30 71 F1 F8       			and	(KOH),$f8			;11111000b
0BE1DB 3F                			popu	imr
0BE1DC                   	;
0BE1DC 8C FD FF 0F       			mv	x,[reset]			;jmp to MENU
0BE1E0 11 04             			jp	x
