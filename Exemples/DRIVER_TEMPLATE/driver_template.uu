440 PRINT "DATA_FILE='";FNAME$;"'"
450 B$="":INPUT "OK? (Y/N) =";B$
460 IF B$="Y" THEN 480 ELSE IF B$="N" THEN END
470 GOTO 440
480 CALL &BFE00
