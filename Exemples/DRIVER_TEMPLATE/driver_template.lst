000000                   	; ==========================================================================
000000                   	;  driver_template.asm - squelette de pilote resident pour SHARP PC-E500(S)
000000                   	;
000000                   	;  Voir Documentation/Modele_Pilotes_Resident_PC-E500S.md pour l'architecture.
000000                   	;
000000                   	;  Modele d'installation : AJOUT EN FIN de la chaine des blocs de S1: (pas de
000000                   	;  decalage des fichiers existants -> aucun recalage des pointeurs BASIC, donc
000000                   	;  pas de corruption possible de BASIC). Plus simple et plus sur que l'insertion
000000                   	;  avec decalage employee par REGISTER.
000000                   	;
000000                   	;  A ADAPTER : le nom (DRIVER  SYS), le numero de device (number), la chaine de
000000                   	;  noms ('DRV:'), et le CORPS (a partir de iocs_entry). Toute adresse absolue
000000                   	;  interne au pilote DOIT etre emise par 'reldp' (voir la discipline).
000000                   	;
000000                   	;  VALIDE sur emulateur : le pilote minimal s'installe (apparait sous DRIVER.SYS).
000000                   	;  En cas d'echec (doublon, memoire), l'installateur rend la main proprement
000000                   	;  (message + carry), sans toucher a BASIC.
000000                   	; ==========================================================================
000000                   	
0BE000                   		org	0be000h			; adresse de chargement de l'installateur
0BE000                   		pre_on				; INDISPENSABLE : auto-prebyte de la RAM interne.
0BE000                   						; Sans lui, "mv (n),x", "cmpp (n),y"... visent
0BE000                   						; (BP+n) au lieu de la RAM interne absolue (n),
0BE000                   						; et le controle memoire lit une valeur parasite.
0BE000                   	
0BE000                   	; --- constantes systeme (voir Exemples/INCLUDE/pce500.inc) -----------------
0BE000                   	blk_id:		equ	0fbh		; signature d'un bloc de fichier
0BE000                   	d_link:		equ	0bfca2h		; racine de la chaine des devices
0BE000                   	s1_top:		equ	0bfc15h		; haut de S1:
0BE000                   	s1_btm:		equ	0bfcdeh		; bas de S1: + 1
0BE000                   	cl:		equ	0d6h
0BE000                   	ch:		equ	0d7h
0BE000                   	fcs_call:	equ	0fffe4h		; appel FCS
0BE000                   	iocs_call:	equ	0fffe8h		; appel IOCS
0BE000                   	
0BE000                   	; --- discipline de relocation ---------------------------------------------
0BE000                   	;  reldp cible  : emet un pointeur relogeable DANS le pilote et le compte.
0BE000                   	;  relref site  : declare, dans la table, le site (adresse du pointeur de 3
0BE000                   	;                 octets) et le compte. L'assertion _nrel = _ntbl echoue si
0BE000                   	;                 l'un des deux est oublie -> l'oubli devient une erreur
0BE000                   	;                 d'assemblage (la ou REGISTER2 ne le detectait pas).
0BE000                   	_nrel:	set	0
0BE000                   	_ntbl:	set	0
0BE000                   	
0BE000                   	; ==========================================================================
0BE000                   	;  INSTALLATEUR  (lance par CALL &BE000)
0BE000                   	; ==========================================================================
0BE000                   	start:
0BE000                   	;  (1) banniere
0BE000 0C F8 E0 0B       		mv	x,msg0
0BE004 0D 11 00 00       		mv	y,btm0-msg0
0BE008 30 CC D6 00       		mv	(cl),0
0BE00C 09 04             		mv	il,4
0BE00E 05 E4 FF 0F       		callf	fcs_call
0BE012                   	
0BE012                   	;  (2) compacter S1: (regrouper l'espace libre en fin de zone)
0BE012 30 CC D6 06       		mv	(cl),6
0BE016 30 CC D7 00       		mv	(ch),0
0BE01A 0B 47 00          		mv	i,47h
0BE01D 05 E8 FF 0F       		callf	iocs_call
0BE021                   	
0BE021                   	;  (3) parcourir les blocs : detecter un doublon, trouver la FIN (point d'ajout)
0BE021 8C 15 FC 0B       		mv	x,[s1_top]
0BE025 95 84 12          		mv	y,[x+12h]		; lead address -> premier bloc
0BE028 45 45             		add	x,y
0BE02A 90 04             	walk:	mv	a,[x]
0BE02C 60 FB             		cmp	a,blk_id		; encore un bloc ?
0BE02E 1A 15             		jrnz	walk_end
0BE030 0D 47 E1 0B       		mv	y,block_top		; comparer le nom au notre
0BE034 09 0C             		mv	il,12
0BE036 2C                		pushu	x
0BE037 05 DD E0 0B       		callf	stricmp
0BE03B 3C                		popu	x
0BE03C 18 81             		jrz	exit2			; deja installe
0BE03E 95 84 11          		mv	y,[x+11h]		; sinon bloc suivant
0BE041 45 45             		add	x,y
0BE043 13 1B             		jr	walk
0BE045                   	walk_end:
0BE045 30 A4 0A          		mv	(10),x			; (10) = fin des blocs = destination (ajout en fin)
0BE048                   	
0BE048                   	;  (4) controle memoire : libre = bas_de_S1 - fin_des_blocs >= taille du pilote
0BE048 8D DE FC 0B       		mv	y,[s1_btm]
0BE04C 7C 05             		dec	y
0BE04E 4D 54             		sub	y,x
0BE050 30 A5 10          		mv	(16),y
0BE053 0D 31 00 00       		mv	y,block_bottom-block_top
0BE057 30 D7 05 10       		cmpp	(16),y
0BE05B 1C 6C             		jrc	exit3
0BE05D                   	
0BE05D                   	;  (5) chainer le nouveau device en tete de la liste IOCS
0BE05D 8C A2 FC 0B       		mv	x,[d_link]		; ancienne tete
0BE061 AC 69 E1 0B       		mv	[header],x		; -> champ 'lien suivant' du nouvel en-tete
0BE065 30 84 0A          		mv	x,(10)
0BE068 09 22             		mv	il,iocs_header-block_top
0BE06A 45 41             		add	x,il
0BE06C AC A2 FC 0B       		mv	[d_link],x		; racine -> nouvel en-tete IOCS
0BE070                   	
0BE070                   	;  (6) relocation : corriger chaque pointeur du bloc SOURCE pour l'adresse de
0BE070                   	;      DESTINATION (10), AVANT la copie.
0BE070 0C 78 E1 0B       		mv	x,modify_table
0BE074 92 04             		mv	ba,[x]			; ba = nombre d'entrees
0BE076 0C 7A E1 0B       		mv	x,modify_table+2	; sauter le compte
0BE07A                   	reloc_lp:
0BE07A 95 24             		mv	y,[x++]			; site = adresse d'un pointeur 3 octets
0BE07C 2C                		pushu	x
0BE07D 2A                		pushu	ba
0BE07E 94 05             		mv	x,[y]			; valeur assemblee du pointeur
0BE080 2D                		pushu	y
0BE081 0D 47 E1 0B       		mv	y,block_top
0BE085 4D 45             		sub	x,y			; - base d'assemblage
0BE087 30 85 0A          		mv	y,(10)
0BE08A 45 45             		add	x,y			; + base de destination
0BE08C 3D                		popu	y
0BE08D B4 05             		mv	[y],x			; reecrire le pointeur relocalise
0BE08F 3A                		popu	ba
0BE090 3C                		popu	x
0BE091 7C 02             		dec	ba
0BE093 1B 1B             		jrnz	reloc_lp
0BE095                   	
0BE095                   	;  (7) copier le pilote a la fin des blocs, puis ecrire le terminateur $ff
0BE095 0B 31 00          		mv	i,block_bottom-block_top
0BE098 30 85 0A          		mv	y,(10)
0BE09B 0C 47 E1 0B       		mv	x,block_top
0BE09F                   	copy_lp:
0BE09F 90 24             		mv	a,[x++]
0BE0A1 B0 25             		mv	[y++],a
0BE0A3 7C 03             		dec	i
0BE0A5 1B 08             		jrnz	copy_lp
0BE0A7 08 FF             		mv	a,0ffh			; nouveau terminateur de la chaine des blocs
0BE0A9 B0 05             		mv	[y],a
0BE0AB                   	
0BE0AB                   	;  (8) succes : afficher 'Installed.' et rendre la main. Aucun fichier n'a ete
0BE0AB                   	;      decale, donc AUCUN recalage des pointeurs BASIC (pas de risque pour BASIC).
0BE0AB 0C 09 E1 0B       		mv	x,msg1
0BE0AF 0D 0C 00 00       		mv	y,btm1-msg1
0BE0B3 30 CC D6 00       		mv	(cl),0
0BE0B7 09 04             		mv	il,4
0BE0B9 05 E4 FF 0F       		callf	fcs_call
0BE0BD 9F                		rc
0BE0BE 07                		retf
0BE0BF                   	
0BE0BF                   	;  --- erreurs : afficher le message et rendre la main (carry), sans toucher a BASIC ---
0BE0BF 0C 15 E1 0B       	exit2:	mv	x,msg2
0BE0C3 0D 17 00 00       		mv	y,btm2-msg2
0BE0C7 12 08             		jr	exit_err
0BE0C9 0C 2C E1 0B       	exit3:	mv	x,msg3
0BE0CD 0D 1B 00 00       		mv	y,btm3-msg3
0BE0D1                   	exit_err:
0BE0D1 30 CC D6 00       		mv	(cl),0
0BE0D5 09 04             		mv	il,4
0BE0D7 05 E4 FF 0F       		callf	fcs_call
0BE0DB 97                		sc
0BE0DC 07                		retf
0BE0DD                   	
0BE0DD                   	; --- helper : comparaison de chaine sur IL octets -------------------------
0BE0DD                   	stricmp:
0BE0DD 30 E0 24 00       		mv	(0),[x++]
0BE0E1 90 25             		mv	a,[y++]
0BE0E3 30 61 00 00       		cmp	(0),0
0BE0E7 18 0A             		jrz	stricmp1
0BE0E9 30 63 00          		cmp	(0),a
0BE0EC 1A 09             		jrnz	stricmp2
0BE0EE 7C 01             		dec	il
0BE0F0 1B 15             		jrnz	stricmp
0BE0F2 07                		retf
0BE0F3                   	stricmp1:
0BE0F3 30 63 00          		cmp	(0),a
0BE0F6 07                		retf
0BE0F7                   	stricmp2:
0BE0F7 07                		retf
0BE0F8                   	
0BE0F8                   	; --- messages -------------------------------------------------------------
0BE0F8 44 52 49 56 45 52 	msg0:	db	'DRIVER template',13,10
0BE0FE 20 74 65 6D 70 6C 	
0BE104 61 74 65 0D 0A    	
0BE109                   	btm0:
0BE109 49 6E 73 74 61 6C 	msg1:	db	'Installed.',13,10
0BE10F 6C 65 64 2E 0D 0A 	
0BE115                   	btm1:
0BE115 45 72 72 6F 72 3A 	msg2:	db	'Error: already exist.',13,10
0BE11B 20 61 6C 72 65 61 	
0BE121 64 79 20 65 78 69 	
0BE127 73 74 2E 0D 0A    	
0BE12C                   	btm2:
0BE12C 45 72 72 6F 72 3A 	msg3:	db	'Error: not enough memory.',13,10
0BE132 20 6E 6F 74 20 65 	
0BE138 6E 6F 75 67 68 20 	
0BE13E 6D 65 6D 6F 72 79 	
0BE144 2E 0D 0A          	
0BE147                   	btm3:
0BE147                   	
0BE147                   	; ==========================================================================
0BE147                   	;  LE PILOTE RESIDENT  (copie en RAM par l'installateur)
0BE147                   	; ==========================================================================
0BE147                   	block_top:
0BE147                   	; -- en-tete de bloc memoire --
0BE147 FB 44 52 49 56 45 		db	blk_id,'DRIVER  SYS'	; signature + nom 8.3 (complete d'espaces)
0BE14D 52 20 20 53 59 53 	
0BE153 25                		db	25h			; attributs de bloc (device + protege)
0BE154 00 00 00 00       		dw	0,0			; date, heure
0BE158 31 00 00          		dp	block_bottom-block_top	; taille du bloc  (offset 011h : lien vers le bloc suivant)
0BE15B 00 00             		dw	0
0BE15D 31 00 00          		dp	block_bottom-block_top	; taille du fichier
0BE160 31 00 00          		dp	block_bottom-block_top
0BE163 00 00 00 00 00 00 		dp	0,0
0BE169                   	; -- en-tete IOCS (maillon de chaine) --
0BE169                   	iocs_header:
0BE169 00 00 00          	header:	dp	0			; lien suivant (rempli a l'installation)
0BE16C 14                	number:	db	20			; numero de device (a adapter)
0BE16D 63                	attr:	db	63h			; attribut de device
0BE16E                   	adrs:
0BE16E 76 E1 0B          		dp	iocs_entry
0BE171                   	_nrel:	set	_nrel+1
0BE171 44 52 56 3A 00    		db	'DRV:',0			; nom de device (a adapter)
0BE176                   	
0BE176                   	; -- CORPS (a remplacer par vos fonctions) --
0BE176                   	;    Stub minimal : renvoie 'commande non geree' (carry).
0BE176                   	;    Toute adresse absolue interne emise ici doit passer par 'reldp' et etre
0BE176                   	;    inscrite dans modify_table via 'relref'.
0BE176                   	iocs_entry:
0BE176 97                		sc
0BE177 07                		retf
0BE178                   	block_bottom:
0BE178                   	
0BE178                   	; ==========================================================================
0BE178                   	;  TABLE DE RELOCATION  +  VERIFICATIONS A L'ASSEMBLAGE
0BE178                   	; ==========================================================================
0BE178                   	modify_table:
0BE178 01 00             		dw	_nrel			; nombre d'entrees (lu par l'installateur)
0BE17A 6E E1 0B          		dp	adrs
0BE17D                   	_ntbl:	set	_ntbl+1
0BE17D                   	modify_end_tbl:
0BE17D                   	
0BE17D                   		assert	_nrel = _ntbl,'table de relocation incomplete (reldp vs relref)'
0BE17D                   		assert	adrs >= block_top,'site de relocation hors du pilote'
0BE17D                   		assert	adrs < block_bottom,'site de relocation hors du pilote'
0BE17D                   		assert	block_bottom > block_top,'pilote de taille nulle'
0BE17D                   		end

  No fatal error.  Code: 0BE000h - 0BE17Ch [      381 byte(s)]
