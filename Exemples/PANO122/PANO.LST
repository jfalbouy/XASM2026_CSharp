0BD000                   	c_ver:	equ	0		;	バージョンNo.
0BD000                   	c_org:	equ	c_ver+1		;	TAB/CR/EOFの表示
0BD000                   	c_sym:	equ	c_org+1		;	オートインデント、PFキー
