0BD000                   	c_twid:	equ	c_swid+1	;	タブ幅
0BD000                   	c_wwid:	equ	c_twid+1	;	改行挿入幅
0BD000                   	c_scps:	equ	c_wwid+1	;	スクラップの大きさ
0BD000                   	c_pref:	equ	c_scps+2	;	プレファレンスの設定
0BD000                   	c_lfil:	equ	c_pref+1	;	最後にsaveしたファイル名
0BD000                   	c_line:	equ	c_lfil+18	;	saveしたときの行番号
0BD000                   	c_fbuf:	equ	c_line+2	;	検索文字列
