0BF244 61 29 0D 0A       	
0BF248                   	btm_title:
0BF248 49 6E 73 74 61 6C 	msg_ins:	db	'Installed.',13,10
0BF24E 6C 65 64 2E 0D 0A 	
0BF254                   	btm_ins:
0BF254 45 72 72 6F 72 3A 	msg_exi:	db	'Error: already exist.',13,10
0BF25A 20 61 6C 72 65 61 	
0BF260 64 79 20 65 78 69 	
0BF266 73 74 2E 0D 0A    	
0BF26B                   	btm_exi:
0BF26B 45 72 72 6F 72 3A 	msg_mem:	db	'Error: not enough memory.',13,10
0BF271 20 6E 6F 74 20 65 	
0BF277 6E 6F 75 67 68 20 	
0BF27D 6D 65 6D 6F 72 79 	
0BF283 2E 0D 0A          	
0BF286                   	btm_mem:
0BF286 55 6E 69 6E 73 74 	msg_unin:	db	'Uninstalling '
0BF28C 61 6C 6C 69 6E 67 	
0BF292 20                	
0BF293 50 4C 32 3A       		db	'PL2:'			; <= nom de device (termine par ':')
0BF297 0D 0A             		db	13,10
0BF299                   	btm_unin:
0BF299 55 6E 69 6E 73 74 	msg_uok:	db	'Uninstalled. To free memory :',13,10
0BF29F 61 6C 6C 65 64 2E 	
0BF2A5 20 54 6F 20 66 72 	
0BF2AB 65 65 20 6D 65 6D 	
