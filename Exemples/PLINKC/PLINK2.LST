0BF2E1                   		pre_off				; le CORPS a ses propres prebytes explicites (pre $30...)
0BF2E1                   	; ==========================================================================
0BF2E1                   	;  LE PILOTE RESIDENT  (copie en RAM par l'installateur)
0BF2E1                   	; ==========================================================================
0BF2E1                   	;----------------------------------------------------------------------
0BF2E1                   	;		En-tete du fichier d'en-tete de l'appareil
0BF2E1                   	;----------------------------------------------------------------------
0BF2E1                   	block_top:
