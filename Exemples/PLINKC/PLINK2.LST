000000                   	; ==========================================================================
000000                   	;  PLINK2.asm - Pocket Link Cache Device Driver, portage sur le modele REGISTER3
000000                   	;
000000                   	;  Base : plinkc.native.asm (D. Mizobata 1.62, d'apres PLINK de N. Kon), dont le
000000                   	;  CORPS et la ZONE DE TRAVAIL sont repris VERBATIM (byte-identiques).
000000                   	;
000000                   	;  Nouveautes par rapport a PLINKC (comme REGISTER3 vis-a-vis de REGISTER2) :
000000                   	;    - Installation par 'CALL &BF000', desinstallation par 'CALL &BF000 "-u"'.
000000                   	;    - Installateur AJOUT-EN-FIN : le pilote est place APRES les blocs existants,
000000                   	;      sans les decaler -> aucun recalage des pointeurs BASIC (linkbas), donc plus
000000                   	;      de reset volontaire (bomb) ni de risque de corruption de BASIC.
000000                   	;    - Noms definis UNE SEULE FOIS (macros drvbase/drvext/drvdev).
000000                   	;    - La TABLE DE RELOCATION d'origine de PLINKC (60 sites, format delta) est
000000                   	;      REUTILISEE verbatim ; un seul octet est ajuste car le nom de device 'PL2:'
000000                   	;      fait 2 octets de plus que 'L:' (le delta site0->site1 passe de 3Dh a 3Fh).
000000                   	;    - Le pilote ne detourne la SIO que transitoirement (il la restaure a chaque
000000                   	;      appel, jump00) : au repos il ne tient AUCUN vecteur -> la desinstallation
000000                   	;      se limite au deliage de la chaine des devices.
000000                   	; ==========================================================================
000000                   	
0BF000                   		org	$bf000
0BF000                   		pre_on				; INDISPENSABLE : adressage RAM interne absolu.
0BF000                   	
0BF000                   	; --- constantes (reprises de plinkc.native.asm) ----------------------------
0BF000                   	fcs:			equ	$fffe4
0BF000                   	iocs:			equ	$fffe8
0BF000                   	iocs_fook:		equ	$bfca2
0BF000                   	sio_rcv_vct:	equ	$bfcd5
0BF000                   	sio_param:		equ	$bfd33
0BF000                   	base:			equ	$ec
0BF000                   	bx:				equ	$d4
0BF000                   	cx:				equ	$d6
0BF000                   	cl:				equ	$d6
0BF000                   	ch:				equ	$d7
0BF000                   	dx:				equ	$d8
0BF000                   	key_strobe_2:	equ	$f1
0BF000                   	sio_ctrl_reg:	equ	$f7
0BF000                   	sio_stat_reg:	equ	$f8
0BF000                   	sio_rx_reg:		equ	$f9
0BF000                   	sio_tx_reg:		equ	$fa
0BF000                   	intr_mask_reg:	equ	$fb
0BF000                   	system_stat_reg:equ	$ff
0BF000                   	
0BF000                   	btext:	equ	$cb
0BF000                   	bdata:	equ	$ce
0BF000                   	bpmax:	equ	$ca
0BF000                   	iwork:	equ	$e6
0BF000                   	keyvec:	equ	$bfc41
0BF000                   	s1top:	equ	$bfc15
0BF000                   	s1end:	equ	$bfcde
0BF000                   	cdrv:	equ	$bfc7d
0BF000                   	rev:	equ	$bfca1
0BF000                   	iroot:	equ	$bfca2
0BF000                   	bworkp:	equ	$bfd0e
0BF000                   	
0BF000                   	sectsiz:	equ	128
0BF000                   	cache_sect:	equ	sectsiz+1
0BF000                   	cache_next:	equ	cache_sect+2
0BF000                   	cache_size:	equ	cache_next+3
0BF000                   	n_fcache:	equ	7		;	Nombre de secteurs dans le cache FAT
0BF000                   	n_dcache:	equ	1		;	Nombre de secteurs dans le cache de donnees
0BF000                   	dtop:		equ	44
0BF000                   	timeout:	equ	40000		; Delai d'attente (environ 1 seconde)
0BF000                   	blk_id:	equ	0fbh			; signature d'un bloc de fichier (ajout)
0BF000                   	
0BF000                   	; --- noms du pilote, definis UNE SEULE FOIS --------------------------------
0BF000                   	;  Nom de FICHIER (bloc) : 'name83' au format 8.3 de l'en-tete (8 car. completes
0BF000                   	;  d'espaces, sans point), 'namedot' au format des messages (base.ext).
0BF000                   	;  Nom de DEVICE (chaine IOCS) : en-tete + recherche de desinstallation.
0BF000                   	
0BF000                   	; ==========================================================================
0BF000                   	;  POINT D'ENTREE : install par 'CALL &BF000', desinstall par 'CALL &BF000 "-u"'
0BF000                   	; ==========================================================================
0BF000                   	start:
0BF000                   	;  Lire l'argument de CALL (entre GUILLEMETS, syntaxe BASIC). Le pointeur de
0BF000                   	;  ligne empile sur la pile U est RESTITUE avance a la sortie (protocole
0BF000                   	;  UUENCODE) pour que BASIC reprenne sans 'Syntax error'.
0BF000 3C                		popu	x
0BF001 30 CC 00 00       		mv	(0),0			; (0) = 0 : installer ; sinon : desinstaller
0BF005 90 24             	sc_arg:	mv	a,[x++]
0BF007 60 00             		cmp	a,0
0BF009 18 1B             		jrz	sc_done
0BF00B 60 0D             		cmp	a,0dh
0BF00D 18 17             		jrz	sc_done
0BF00F 60 2D             		cmp	a,'-'
0BF011 1B 0E             		jrnz	sc_arg
0BF013 90 04             		mv	a,[x]
0BF015 60 75             		cmp	a,'u'
0BF017 18 06             		jrz	sc_setu
0BF019 60 55             		cmp	a,'U'
0BF01B 18 02             		jrz	sc_setu
0BF01D 13 1A             		jr	sc_arg
0BF01F                   	sc_setu:
0BF01F 08 01             		mv	a,1
0BF021 30 A0 00          		mv	(0),a
0BF024 13 21             		jr	sc_arg
0BF026                   	sc_done:
0BF026 7C 04             		dec	x
0BF028 2C                		pushu	x
0BF029 30 80 00          		mv	a,(0)
0BF02C 60 00             		cmp	a,0
0BF02E 18 03             		jrz	install
0BF030 02 5C F1          		jp	uninstall
0BF033                   	
0BF033                   	; ==========================================================================
0BF033                   	;  INSTALLATEUR  (CALL &BF000) - modele AJOUT-EN-FIN
0BF033                   	; ==========================================================================
0BF033                   	install:
0BF033                   	;  (1) banniere
0BF033 0C 26 F2 0B       		mv	x,msg_title
0BF037 0D 22 00 00       		mv	y,btm_title-msg_title
0BF03B 30 CC D6 00       		mv	(cl),0
0BF03F 09 04             		mv	il,4
0BF041 05 E4 FF 0F       		callf	fcs
0BF045                   	
0BF045                   	;  (2) sauver l'ancienne tete de la chaine des devices dans notre 'lien suivant'
0BF045 8C A2 FC 0B       		mv	x,[iroot]
0BF049 AC 23 F3 0B       		mv	[ihead],x
0BF04D                   	
0BF04D                   	;  (3) trouver un numero de device libre (>= 10) et l'inscrire dans l'en-tete
0BF04D 30 CC D6 09       		mv	(cl),10-1		; (cl)=(cx)=0D6h : numero de device candidat
0BF051                   	free_dev:
0BF051 30 6D D6          		inc	(cl)
0BF054 09 01             		mv	il,1
0BF056 05 E8 FF 0F       		callf	iocs			; il=1 : le numero (cx) existe-t-il ?
0BF05A 1F 0B             		jrnc	free_dev		; NC : occupe -> essayer le suivant
0BF05C 30 80 D6          		mv	a,(cl)
0BF05F A8 26 F3 0B       		mv	[devno],a		; C : libre -> l'adopter
0BF063                   	
0BF063                   	;  (4) compacter S1: (regrouper l'espace libre en fin de zone)
0BF063 30 CC D6 06       		mv	(cl),6
0BF067 30 CC D7 00       		mv	(ch),0
0BF06B 0B 47 00          		mv	i,47h
0BF06E 05 E8 FF 0F       		callf	iocs
0BF072                   	
0BF072                   	;  (5) parcourir les blocs : detecter un doublon, trouver la FIN (point d'ajout)
0BF072 8C 15 FC 0B       		mv	x,[s1top]
0BF076 95 84 12          		mv	y,[x+12h]		; lead address -> premier bloc
0BF079 45 45             		add	x,y
0BF07B 90 04             	walk:	mv	a,[x]
0BF07D 60 FB             		cmp	a,blk_id
0BF07F 1A 15             		jrnz	walk_end
0BF081 0D 01 F3 0B       		mv	y,block_top		; comparer le nom (12 octets) au notre
0BF085 09 0C             		mv	il,12
0BF087 2C                		pushu	x
0BF088 05 CC F1 0B       		callf	stricmp
0BF08C 3C                		popu	x
0BF08D 18 AF             		jrz	err_exist		; deja installe
0BF08F 95 84 11          		mv	y,[x+11h]
0BF092 45 45             		add	x,y
0BF094 13 1B             		jr	walk
0BF096                   	walk_end:
0BF096 30 A4 0A          		mv	(10),x			; (10) = fin des blocs = destination
0BF099                   	
0BF099                   	;  (6) le CODE ne doit pas franchir la page de 64 Ko (appels internes 16 bits)
0BF099 0B E6 03          		mv	i,prgend-block_top
0BF09C 30 82 0A          		mv	ba,(10)
0BF09F 44 23             		add	ba,i
0BF0A1 1C A5             		jrc	err_mem			; debordement 16 bits -> refus
0BF0A3                   	
0BF0A3                   	;  (7) controle memoire : [s1end]-1 - fin_des_blocs >= taille du bloc (blen)
0BF0A3 8D DE FC 0B       		mv	y,[s1end]
0BF0A7 7C 05             		dec	y
0BF0A9 4D 54             		sub	y,x
0BF0AB 30 A5 10          		mv	(16),y
0BF0AE 0D 22 09 00       		mv	y,blen
0BF0B2 30 D7 05 10       		cmpp	(16),y
0BF0B6 1C 90             		jrc	err_mem
0BF0B8                   	
0BF0B8                   	;  (8) copier le CODE du pilote a la fin des blocs (la zone de travail suit,
0BF0B8                   	;      reservee mais non copiee)
0BF0B8 0B E6 03          		mv	i,prgend-block_top
0BF0BB 30 85 0A          		mv	y,(10)
0BF0BE 0C 01 F3 0B       		mv	x,block_top
0BF0C2                   	copy_lp:
0BF0C2 90 24             		mv	a,[x++]
0BF0C4 B0 25             		mv	[y++],a
0BF0C6 7C 03             		dec	i
0BF0C8 1B 08             		jrnz	copy_lp
0BF0CA                   	
0BF0CA                   	;  (9) RELOCATION : appliquer au pilote COPIE la table de deltas d'origine de
0BF0CA                   	;      PLINKC. Chaque octet de la table avance un pointeur 'y' dans le pilote
0BF0CA                   	;      copie ; on corrige la valeur 3 octets pointee de (dest - block_top).
0BF0CA B6 37             		mv	[--s],u			; sauver le pointeur de pile U
0BF0CC 0E E7 F1 0B       		mv	u,reloc_table		; u -> table de deltas
0BF0D0 30 84 0A          		mv	x,(10)			; dest
0BF0D3 0A 27 00          		mv	ba,rel_dev0-block_top	; offset du 1er site (0x27) depuis block_top
0BF0D6 45 42             		add	x,ba
0BF0D8 0A 06 02          		mv	ba,0206h		; 1er delta de la table (constante d'origine)
0BF0DB 4D 42             		sub	x,ba
0BF0DD FD 54             		mv	y,x			; y = dest + (rel_dev0-block_top) - 0x206
0BF0DF 38                	rl:	popu	a			; a = octet de table (mv a,[u++])
0BF0E0 60 FF             		cmp	a,0ffh
0BF0E2 18 22             		jrz	rl_end
0BF0E4 70 7F             		and	a,7fh
0BF0E6 60 7E             		cmp	a,7eh
0BF0E8 1A 05             		jrnz	rl_short
0BF0EA 3A                		popu	ba			; delta long sur 2 octets
0BF0EB 45 52             		add	y,ba
0BF0ED 12 02             		jr	rl_corr
0BF0EF                   	rl_short:
0BF0EF 45 50             		add	y,a
0BF0F1                   	rl_corr:
0BF0F1 94 05             		mv	x,[y]			; valeur 3 octets a corriger
0BF0F3 B5 37             		pushs	y			; (la pile S : u sert de pointeur de table)
0BF0F5 0D 01 F3 0B       		mv	y,block_top
0BF0F9 4D 45             		sub	x,y			; - base d'assemblage
0BF0FB 30 85 0A          		mv	y,(10)
0BF0FE 45 45             		add	x,y			; + base de destination
0BF100 95 27             		pops	y
0BF102 B4 05             		mv	[y],x
0BF104 13 27             		jr	rl
0BF106                   	rl_end:
0BF106 96 27             		mv	u,[s++]			; restaurer le pointeur de pile U
0BF108                   	
0BF108                   	;  (10) chainer le nouveau device en tete de la liste IOCS
0BF108 30 84 0A          		mv	x,(10)
0BF10B 0A 22 00          		mv	ba,iocs_header-block_top
0BF10E 45 42             		add	x,ba
0BF110 AC A2 FC 0B       		mv	[iroot],x		; racine -> notre en-tete IOCS (copie)
0BF114                   	
0BF114                   	;  (11) terminateur de la chaine des blocs, apres le bloc complet (dest+blen)
0BF114 30 84 0A          		mv	x,(10)
0BF117 0A 22 09          		mv	ba,blen
0BF11A 45 42             		add	x,ba
0BF11C 08 FF             		mv	a,0ffh
0BF11E B0 04             		mv	[x],a
0BF120                   	
0BF120                   	;  (12) initialiser les parametres du device
0BF120 0C 2B F3 0B       		mv	x,dvname
0BF124 09 04             		mv	il,4
0BF126 05 E8 FF 0F       		callf	iocs
0BF12A                   	
0BF12A                   	;  (13) succes
0BF12A 0C 48 F2 0B       		mv	x,msg_ins
0BF12E 0D 0C 00 00       		mv	y,btm_ins-msg_ins
0BF132 30 CC D6 00       		mv	(cl),0
0BF136 09 04             		mv	il,4
0BF138 05 E4 FF 0F       		callf	fcs
0BF13C 9F                		rc
0BF13D 07                		retf
0BF13E                   	
0BF13E                   	;  --- erreurs : message + rendre la main (carry), sans toucher a BASIC ---
0BF13E                   	err_exist:
0BF13E 0C 54 F2 0B       		mv	x,msg_exi
0BF142 0D 17 00 00       		mv	y,btm_exi-msg_exi
0BF146 12 08             		jr	exit_err
0BF148                   	err_mem:
0BF148 0C 6B F2 0B       		mv	x,msg_mem
0BF14C 0D 1B 00 00       		mv	y,btm_mem-msg_mem
0BF150                   	exit_err:
0BF150 30 CC D6 00       		mv	(cl),0
0BF154 09 04             		mv	il,4
0BF156 05 E4 FF 0F       		callf	fcs
0BF15A 97                		sc
0BF15B 07                		retf
0BF15C                   	
0BF15C                   	; ==========================================================================
0BF15C                   	;  DESINSTALLATEUR  (CALL &BF000 "-u")
0BF15C                   	; ==========================================================================
0BF15C                   	;  Le pilote ne tient aucun vecteur au repos -> deliage seul. Le bloc reste en
0BF15C                   	;  memoire (protege) ; l'utilisateur le libere par SET puis KILL (la ROM met a
0BF15C                   	;  jour le repertoire et recompacte).
0BF15C                   	uninstall:
0BF15C 0C 86 F2 0B       		mv	x,msg_unin
0BF160 0D 13 00 00       		mv	y,btm_unin-msg_unin
0BF164 30 CC D6 00       		mv	(cl),0
0BF168 09 04             		mv	il,4
0BF16A 05 E4 FF 0F       		callf	fcs
0BF16E 0D A2 FC 0B       		mv	y,iroot			; y = emplacement du pointeur vers l'en-tete courant
0BF172                   	un_find:
0BF172 94 05             		mv	x,[y]
0BF174 6C 04             		inc	x
0BF176 18 40             		jrz	un_notfound		; -1 : fin de chaine
0BF178 7C 04             		dec	x
0BF17A 30 A4 0A          		mv	(10),x			; en-tete courant
0BF17D 30 A5 0D          		mv	(13),y			; predecesseur
0BF180 09 08             		mv	il,8
0BF182 45 41             		add	x,il			; x = en-tete + 8 = nom de device
0BF184 0D FD F2 0B       		mv	y,drv_str
0BF188 09 04             		mv	il,4
0BF18A 05 CC F1 0B       		callf	stricmp
0BF18E 30 84 0A          		mv	x,(10)
0BF191 30 85 0D          		mv	y,(13)
0BF194 18 04             		jrz	un_found
0BF196 FD 54             		mv	y,x
0BF198 13 28             		jr	un_find
0BF19A                   	un_found:
0BF19A                   	;  delier : [predecesseur] = notre lien suivant
0BF19A 30 84 0A          		mv	x,(10)
0BF19D 94 04             		mv	x,[x]
0BF19F 30 85 0D          		mv	y,(13)
0BF1A2 B4 05             		mv	[y],x
0BF1A4 0C 99 F2 0B       		mv	x,msg_uok
0BF1A8 0D 4F 00 00       		mv	y,btm_uok-msg_uok
0BF1AC 30 CC D6 00       		mv	(cl),0
0BF1B0 09 04             		mv	il,4
0BF1B2 05 E4 FF 0F       		callf	fcs
0BF1B6 9F                		rc
0BF1B7 07                		retf
0BF1B8                   	un_notfound:
0BF1B8 0C E8 F2 0B       		mv	x,msg_unf
0BF1BC 0D 15 00 00       		mv	y,btm_unf-msg_unf
0BF1C0 30 CC D6 00       		mv	(cl),0
0BF1C4 09 04             		mv	il,4
0BF1C6 05 E4 FF 0F       		callf	fcs
0BF1CA 97                		sc
0BF1CB 07                		retf
0BF1CC                   	
0BF1CC                   	; --- helper : comparaison de chaine sur IL octets --------------------------
0BF1CC                   	stricmp:
0BF1CC 30 E0 24 00       		mv	(0),[x++]
0BF1D0 90 25             		mv	a,[y++]
0BF1D2 30 61 00 00       		cmp	(0),0
0BF1D6 18 0A             		jrz	stricmp1
0BF1D8 30 63 00          		cmp	(0),a
0BF1DB 1A 09             		jrnz	stricmp2
0BF1DD 7C 01             		dec	il
0BF1DF 1B 15             		jrnz	stricmp
0BF1E1 07                		retf
0BF1E2                   	stricmp1:
0BF1E2 30 63 00          		cmp	(0),a
0BF1E5 07                		retf
0BF1E6                   	stricmp2:
0BF1E6 07                		retf
0BF1E7                   	
0BF1E7                   	; --- table de relocation (deltas d'origine de PLINKC ; octet 3 : 3Dh->3Fh) -
0BF1E7                   	reloc_table:
0BF1E7 FE 06 02 BF 1E B9 		db	0FEh,006h,002h,0BFh,01Eh,0B9h,08Ah,085h,087h,004h,005h,004h,009h,005h,086h,00Eh
0BF1ED 8A 85 87 04 05 04 	
0BF1F3 09 05 86 0E       	
0BF1F7 07 03 0B 89 B2 0A 		db	007h,003h,00Bh,089h,0B2h,00Ah,08Bh,086h,084h,006h,08Bh,08Bh,09Eh,089h,00Eh,0A2h
0BF1FD 8B 86 84 06 8B 8B 	
0BF203 9E 89 0E A2       	
0BF207 89 0E 1D 16 05 05 		db	089h,00Eh,01Dh,016h,005h,005h,008h,009h,003h,015h,00Ch,005h,005h,004h,009h,0E5h
0BF20D 08 09 03 15 0C 05 	
0BF213 05 04 09 E5       	
0BF217 98 8D 86 84 04 85 		db	098h,08Dh,086h,084h,004h,085h,084h,004h,09Fh,096h,084h,007h,0B7h,08Ch,0FFh
0BF21D 84 04 9F 96 84 07 	
0BF223 B7 8C FF          	
0BF226                   	
0BF226                   	; --- messages --------------------------------------------------------------
0BF226 50 4C 49 4E 4B 32 	msg_title:	db	'PLINK2 (PLINKC 1.62, D.Mizobata)',13,10
0BF22C 20 28 50 4C 49 4E 	
