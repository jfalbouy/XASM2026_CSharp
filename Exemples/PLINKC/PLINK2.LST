000000                   	; ==========================================================================
000000                   	;  PLINK2.asm - Pocket Link Cache Device Driver, portage sur le modele REGISTER3
000000                   	;
000000                   	;  Base : plinkc.native.asm (D. Mizobata 1.62, d'apres PLINK de N. Kon), dont le
000000                   	;  CORPS et la ZONE DE TRAVAIL sont repris VERBATIM (byte-identiques).
000000                   	;
000000                   	;  Nouveautes par rapport a PLINKC (comme REGISTER3 vis-a-vis de REGISTER2) :
000000                   	;    - Installation par 'CALL &BF000', desinstallation par 'CALL &BF000 "-u"'.
000000                   	;    - Installateur AJOUT-EN-FIN : le pilote est place APRES les blocs existants,
000000                   	;      sans les decaler -> aucun recalage des pointeurs BASIC (linkbas), donc plus
000000                   	;      de reset volontaire (bomb) ni de risque de corruption de BASIC.
000000                   	;    - Noms definis UNE SEULE FOIS (macros drvbase/drvext/drvdev).
000000                   	;    - La TABLE DE RELOCATION d'origine de PLINKC (60 sites, format delta) est
000000                   	;      REUTILISEE verbatim ; un seul octet est ajuste car le nom de device 'PL2:'
000000                   	;      fait 2 octets de plus que 'L:' (le delta site0->site1 passe de 3Dh a 3Fh).
000000                   	;    - Le pilote ne detourne la SIO que transitoirement (il la restaure a chaque
000000                   	;      appel, jump00) : au repos il ne tient AUCUN vecteur -> la desinstallation
000000                   	;      se limite au deliage de la chaine des devices.
000000                   	; ==========================================================================
000000                   	
0BF000                   		org	$bf000
0BF000                   		pre_on				; INDISPENSABLE : adressage RAM interne absolu.
0BF000                   	
0BF000                   	; --- constantes (reprises de plinkc.native.asm) ----------------------------
0BF000                   	fcs:			equ	$fffe4
0BF000                   	iocs:			equ	$fffe8
0BF000                   	iocs_fook:		equ	$bfca2
0BF000                   	sio_rcv_vct:	equ	$bfcd5
0BF000                   	sio_param:		equ	$bfd33
0BF000                   	base:			equ	$ec
0BF000                   	bx:				equ	$d4
0BF000                   	cx:				equ	$d6
0BF000                   	cl:				equ	$d6
0BF000                   	ch:				equ	$d7
0BF000                   	dx:				equ	$d8
0BF000                   	key_strobe_2:	equ	$f1
0BF000                   	sio_ctrl_reg:	equ	$f7
0BF000                   	sio_stat_reg:	equ	$f8
0BF000                   	sio_rx_reg:		equ	$f9
0BF000                   	sio_tx_reg:		equ	$fa
0BF000                   	intr_mask_reg:	equ	$fb
0BF000                   	system_stat_reg:equ	$ff
0BF000                   	
0BF000                   	btext:	equ	$cb
0BF000                   	bdata:	equ	$ce
0BF000                   	bpmax:	equ	$ca
0BF000                   	iwork:	equ	$e6
0BF000                   	keyvec:	equ	$bfc41
0BF000                   	s1top:	equ	$bfc15
0BF000                   	s1end:	equ	$bfcde
0BF000                   	cdrv:	equ	$bfc7d
0BF000                   	rev:	equ	$bfca1
0BF000                   	iroot:	equ	$bfca2
0BF000                   	bworkp:	equ	$bfd0e
0BF000                   	
0BF000                   	sectsiz:	equ	128
0BF000                   	cache_sect:	equ	sectsiz+1
0BF000                   	cache_next:	equ	cache_sect+2
0BF000                   	cache_size:	equ	cache_next+3
0BF000                   	n_fcache:	equ	7		;	Nombre de secteurs dans le cache FAT
0BF000                   	n_dcache:	equ	1		;	Nombre de secteurs dans le cache de donnees
0BF000                   	dtop:		equ	44
0BF000                   	timeout:	equ	40000		; Delai d'attente (environ 1 seconde)
0BF000                   	blk_id:	equ	0fbh			; signature d'un bloc de fichier (ajout)
0BF000                   	
0BF000                   	; --- noms du pilote, definis UNE SEULE FOIS --------------------------------
0BF000                   	;  Nom de FICHIER (bloc) : 'name83' au format 8.3 de l'en-tete (8 car. completes
0BF000                   	;  d'espaces, sans point), 'namedot' au format des messages (base.ext).
0BF000                   	;  Nom de DEVICE (chaine IOCS) : en-tete + recherche de desinstallation.
0BF000                   	
0BF000                   	; ==========================================================================
0BF000                   	;  POINT D'ENTREE : install par 'CALL &BF000', desinstall par 'CALL &BF000 "-u"'
0BF000                   	; ==========================================================================
0BF000                   	start:
0BF000                   	;  Lire l'argument de CALL (entre GUILLEMETS, syntaxe BASIC). Le pointeur de
0BF000                   	;  ligne empile sur la pile U est RESTITUE avance a la sortie (protocole
0BF000                   	;  UUENCODE) pour que BASIC reprenne sans 'Syntax error'.
0BF000 3C                		popu	x
0BF001 30 CC 00 00       		mv	(0),0			; (0) = 0 : installer ; sinon : desinstaller
0BF005 90 24             	sc_arg:	mv	a,[x++]
0BF007 60 00             		cmp	a,0
0BF009 18 23             		jrz	sc_done
0BF00B 60 0D             		cmp	a,0dh			; CR
0BF00D 18 1F             		jrz	sc_done
0BF00F 60 1A             		cmp	a,1ah			; fin de chaine BASIC (comme UUENCODE argskp)
0BF011 18 1B             		jrz	sc_done
0BF013 60 FF             		cmp	a,0ffh			; fin de chaine BASIC
0BF015 18 17             		jrz	sc_done
0BF017 60 2D             		cmp	a,'-'
0BF019 1B 16             		jrnz	sc_arg
0BF01B 90 04             		mv	a,[x]
0BF01D 60 75             		cmp	a,'u'
0BF01F 18 06             		jrz	sc_setu
0BF021 60 55             		cmp	a,'U'
0BF023 18 02             		jrz	sc_setu
0BF025 13 22             		jr	sc_arg
0BF027                   	sc_setu:
0BF027 08 01             		mv	a,1
0BF029 30 A0 00          		mv	(0),a
0BF02C 13 29             		jr	sc_arg
0BF02E                   	sc_done:
0BF02E 7C 04             		dec	x
0BF030 2C                		pushu	x
0BF031 30 80 00          		mv	a,(0)
0BF034 60 00             		cmp	a,0
0BF036 18 03             		jrz	install
0BF038 02 44 F1          		jp	uninstall
0BF03B                   	
0BF03B                   	; ==========================================================================
0BF03B                   	;  INSTALLATEUR  (CALL &BF000) - modele AJOUT-EN-FIN
0BF03B                   	; ==========================================================================
0BF03B                   	install:
0BF03B                   	;  (1) banniere
0BF03B 0C 0E F2 0B       		mv	x,msg_title
0BF03F 0D 22 00 00       		mv	y,btm_title-msg_title
0BF043 30 CC D6 00       		mv	(cl),0
0BF047 09 04             		mv	il,4
0BF049 05 E4 FF 0F       		callf	fcs
0BF04D                   	
0BF04D                   	;  (2) sauver l'ancienne tete de la chaine des devices dans notre 'lien suivant'
0BF04D 8C A2 FC 0B       		mv	x,[iroot]
0BF051 AC 0B F3 0B       		mv	[ihead],x
0BF055                   	
0BF055                   	;  (3) numero de device : code en dur dans l'en-tete (devno). La recherche
0BF055                   	;      dynamique via 'iocs il=1' (convention incertaine) est ecartee : elle
0BF055                   	;      risquait une boucle infinie (figement). 10 est libre sur un systeme courant.
0BF055                   	
0BF055                   	;  (4) compacter S1: (regrouper l'espace libre en fin de zone)
0BF055 30 CC D6 06       		mv	(cl),6
0BF059 30 CC D7 00       		mv	(ch),0
0BF05D 0B 47 00          		mv	i,47h
0BF060 05 E8 FF 0F       		callf	iocs
0BF064                   	
0BF064                   	;  (5) parcourir les blocs : detecter un doublon, trouver la FIN (point d'ajout)
0BF064 8C 15 FC 0B       		mv	x,[s1top]
0BF068 95 84 12          		mv	y,[x+12h]		; lead address -> premier bloc
0BF06B 45 45             		add	x,y
0BF06D 90 04             	walk:	mv	a,[x]
0BF06F 60 FB             		cmp	a,blk_id
0BF071 1A 15             		jrnz	walk_end
0BF073 0D E9 F2 0B       		mv	y,block_top		; comparer le nom (12 octets) au notre
0BF077 09 0C             		mv	il,12
0BF079 2C                		pushu	x
0BF07A 05 B4 F1 0B       		callf	stricmp
0BF07E 3C                		popu	x
0BF07F 18 A5             		jrz	err_exist		; deja installe
0BF081 95 84 11          		mv	y,[x+11h]
0BF084 45 45             		add	x,y
0BF086 13 1B             		jr	walk
0BF088                   	walk_end:
0BF088 30 A4 0A          		mv	(10),x			; (10) = fin des blocs = destination
0BF08B                   	
0BF08B                   	;  (6) le CODE ne doit pas franchir la page de 64 Ko (appels internes 16 bits)
0BF08B 0B E6 03          		mv	i,prgend-block_top
0BF08E 30 82 0A          		mv	ba,(10)
0BF091 44 23             		add	ba,i
0BF093 1C 9B             		jrc	err_mem			; debordement 16 bits -> refus
0BF095                   	
0BF095                   	;  (7) controle memoire : [s1end]-1 - fin_des_blocs >= taille du bloc (blen)
0BF095 8D DE FC 0B       		mv	y,[s1end]
0BF099 7C 05             		dec	y
0BF09B 4D 54             		sub	y,x
0BF09D 30 A5 10          		mv	(16),y
0BF0A0 0D 22 09 00       		mv	y,blen
0BF0A4 30 D7 05 10       		cmpp	(16),y
0BF0A8 1C 86             		jrc	err_mem
0BF0AA                   	
0BF0AA                   	;  (8) copier le CODE du pilote a la fin des blocs (la zone de travail suit,
0BF0AA                   	;      reservee mais non copiee)
0BF0AA 0B E6 03          		mv	i,prgend-block_top
0BF0AD 30 85 0A          		mv	y,(10)
0BF0B0 0C E9 F2 0B       		mv	x,block_top
0BF0B4                   	copy_lp:
0BF0B4 90 24             		mv	a,[x++]
0BF0B6 B0 25             		mv	[y++],a
0BF0B8 7C 03             		dec	i
0BF0BA 1B 08             		jrnz	copy_lp
0BF0BC                   	
0BF0BC                   	;  (9) RELOCATION : appliquer au pilote COPIE la table de deltas d'origine de
0BF0BC                   	;      PLINKC. Chaque octet de la table avance un pointeur 'y' dans le pilote
0BF0BC                   	;      copie ; on corrige la valeur 3 octets pointee de (dest - block_top).
0BF0BC B6 37             		mv	[--s],u			; sauver le pointeur de pile U
0BF0BE 0E CF F1 0B       		mv	u,reloc_table		; u -> table de deltas
0BF0C2 30 84 0A          		mv	x,(10)			; dest
0BF0C5 0A 27 00          		mv	ba,rel_dev0-block_top	; offset du 1er site (0x27) depuis block_top
0BF0C8 45 42             		add	x,ba
0BF0CA 0A 06 02          		mv	ba,0206h		; 1er delta de la table (constante d'origine)
0BF0CD 4D 42             		sub	x,ba
0BF0CF FD 54             		mv	y,x			; y = dest + (rel_dev0-block_top) - 0x206
0BF0D1 38                	rl:	popu	a			; a = octet de table (mv a,[u++])
0BF0D2 60 FF             		cmp	a,0ffh
0BF0D4 18 22             		jrz	rl_end
0BF0D6 70 7F             		and	a,7fh
0BF0D8 60 7E             		cmp	a,7eh
0BF0DA 1A 05             		jrnz	rl_short
0BF0DC 3A                		popu	ba			; delta long sur 2 octets
0BF0DD 45 52             		add	y,ba
0BF0DF 12 02             		jr	rl_corr
0BF0E1                   	rl_short:
0BF0E1 45 50             		add	y,a
0BF0E3                   	rl_corr:
0BF0E3 94 05             		mv	x,[y]			; valeur 3 octets a corriger
0BF0E5 B5 37             		mv	[--s],y			; sauver le pointeur de table (u sert deja de lecteur)
0BF0E7 0D E9 F2 0B       		mv	y,block_top
0BF0EB 4D 45             		sub	x,y			; - base d'assemblage
0BF0ED 30 85 0A          		mv	y,(10)
0BF0F0 45 45             		add	x,y			; + base de destination
0BF0F2 95 27             		mv	y,[s++]			; restaurer le pointeur de table
0BF0F4 B4 05             		mv	[y],x
0BF0F6 13 27             		jr	rl
0BF0F8                   	rl_end:
0BF0F8 96 27             		mv	u,[s++]			; restaurer le pointeur de pile U
0BF0FA                   	
0BF0FA                   	;  (10) chainer le nouveau device en tete de la liste IOCS
0BF0FA 30 84 0A          		mv	x,(10)
0BF0FD 0A 22 00          		mv	ba,iocs_header-block_top
0BF100 45 42             		add	x,ba
0BF102 AC A2 FC 0B       		mv	[iroot],x		; racine -> notre en-tete IOCS (copie)
0BF106                   	
0BF106                   	;  (11) terminateur de la chaine des blocs, apres le bloc complet (dest+blen)
0BF106 30 84 0A          		mv	x,(10)
0BF109 0A 22 09          		mv	ba,blen
0BF10C 45 42             		add	x,ba
0BF10E 08 FF             		mv	a,0ffh
0BF110 B0 04             		mv	[x],a
0BF112                   	
0BF112                   	;  (12) l'init des parametres par 'iocs il=4' (comme PLINKC) FIGE la machine sur
0BF112                   	;      l'emulateur (convention incertaine, 1er acces device). Ecartee : le device
0BF112                   	;      est deja chaine (comme REGISTER3), le pilote s'initialise a la 1re commande.
0BF112                   	
0BF112                   	;  (13) succes
0BF112 0C 30 F2 0B       		mv	x,msg_ins
0BF116 0D 0C 00 00       		mv	y,btm_ins-msg_ins
0BF11A 30 CC D6 00       		mv	(cl),0
0BF11E 09 04             		mv	il,4
0BF120 05 E4 FF 0F       		callf	fcs
0BF124 9F                		rc
0BF125 07                		retf
0BF126                   	
0BF126                   	;  --- erreurs : message + rendre la main (carry), sans toucher a BASIC ---
0BF126                   	err_exist:
0BF126 0C 3C F2 0B       		mv	x,msg_exi
0BF12A 0D 17 00 00       		mv	y,btm_exi-msg_exi
0BF12E 12 08             		jr	exit_err
0BF130                   	err_mem:
0BF130 0C 53 F2 0B       		mv	x,msg_mem
0BF134 0D 1B 00 00       		mv	y,btm_mem-msg_mem
0BF138                   	exit_err:
0BF138 30 CC D6 00       		mv	(cl),0
0BF13C 09 04             		mv	il,4
0BF13E 05 E4 FF 0F       		callf	fcs
0BF142 97                		sc
0BF143 07                		retf
0BF144                   	
0BF144                   	; ==========================================================================
0BF144                   	;  DESINSTALLATEUR  (CALL &BF000 "-u")
0BF144                   	; ==========================================================================
0BF144                   	;  Le pilote ne tient aucun vecteur au repos -> deliage seul. Le bloc reste en
0BF144                   	;  memoire (protege) ; l'utilisateur le libere par SET puis KILL (la ROM met a
0BF144                   	;  jour le repertoire et recompacte).
0BF144                   	uninstall:
0BF144 0C 6E F2 0B       		mv	x,msg_unin
0BF148 0D 13 00 00       		mv	y,btm_unin-msg_unin
0BF14C 30 CC D6 00       		mv	(cl),0
0BF150 09 04             		mv	il,4
0BF152 05 E4 FF 0F       		callf	fcs
0BF156 0D A2 FC 0B       		mv	y,iroot			; y = emplacement du pointeur vers l'en-tete courant
0BF15A                   	un_find:
0BF15A 94 05             		mv	x,[y]
0BF15C 6C 04             		inc	x
0BF15E 18 40             		jrz	un_notfound		; -1 : fin de chaine
0BF160 7C 04             		dec	x
0BF162 30 A4 0A          		mv	(10),x			; en-tete courant
0BF165 30 A5 0D          		mv	(13),y			; predecesseur
0BF168 09 08             		mv	il,8
0BF16A 45 41             		add	x,il			; x = en-tete + 8 = nom de device
0BF16C 0D E5 F2 0B       		mv	y,drv_str
0BF170 09 04             		mv	il,4
0BF172 05 B4 F1 0B       		callf	stricmp
0BF176 30 84 0A          		mv	x,(10)
0BF179 30 85 0D          		mv	y,(13)
0BF17C 18 04             		jrz	un_found
0BF17E FD 54             		mv	y,x
0BF180 13 28             		jr	un_find
0BF182                   	un_found:
0BF182                   	;  delier : [predecesseur] = notre lien suivant
0BF182 30 84 0A          		mv	x,(10)
0BF185 94 04             		mv	x,[x]
0BF187 30 85 0D          		mv	y,(13)
0BF18A B4 05             		mv	[y],x
0BF18C 0C 81 F2 0B       		mv	x,msg_uok
0BF190 0D 4F 00 00       		mv	y,btm_uok-msg_uok
0BF194 30 CC D6 00       		mv	(cl),0
0BF198 09 04             		mv	il,4
0BF19A 05 E4 FF 0F       		callf	fcs
0BF19E 9F                		rc
0BF19F 07                		retf
0BF1A0                   	un_notfound:
0BF1A0 0C D0 F2 0B       		mv	x,msg_unf
0BF1A4 0D 15 00 00       		mv	y,btm_unf-msg_unf
0BF1A8 30 CC D6 00       		mv	(cl),0
0BF1AC 09 04             		mv	il,4
0BF1AE 05 E4 FF 0F       		callf	fcs
0BF1B2 97                		sc
0BF1B3 07                		retf
0BF1B4                   	
0BF1B4                   	; --- helper : comparaison de chaine sur IL octets --------------------------
0BF1B4                   	stricmp:
0BF1B4 30 E0 24 00       		mv	(0),[x++]
0BF1B8 90 25             		mv	a,[y++]
0BF1BA 30 61 00 00       		cmp	(0),0
0BF1BE 18 0A             		jrz	stricmp1
0BF1C0 30 63 00          		cmp	(0),a
0BF1C3 1A 09             		jrnz	stricmp2
0BF1C5 7C 01             		dec	il
0BF1C7 1B 15             		jrnz	stricmp
0BF1C9 07                		retf
0BF1CA                   	stricmp1:
0BF1CA 30 63 00          		cmp	(0),a
0BF1CD 07                		retf
0BF1CE                   	stricmp2:
0BF1CE 07                		retf
0BF1CF                   	
0BF1CF                   	; --- table de relocation (deltas d'origine de PLINKC ; octet 3 : 3Dh->3Fh) -
0BF1CF                   	reloc_table:
0BF1CF FE 06 02 BF 1E B9 		db	0FEh,006h,002h,0BFh,01Eh,0B9h,08Ah,085h,087h,004h,005h,004h,009h,005h,086h,00Eh
0BF1D5 8A 85 87 04 05 04 	
0BF1DB 09 05 86 0E       	
0BF1DF 07 03 0B 89 B2 0A 		db	007h,003h,00Bh,089h,0B2h,00Ah,08Bh,086h,084h,006h,08Bh,08Bh,09Eh,089h,00Eh,0A2h
0BF1E5 8B 86 84 06 8B 8B 	
0BF1EB 9E 89 0E A2       	
0BF1EF 89 0E 1D 16 05 05 		db	089h,00Eh,01Dh,016h,005h,005h,008h,009h,003h,015h,00Ch,005h,005h,004h,009h,0E5h
0BF1F5 08 09 03 15 0C 05 	
0BF1FB 05 04 09 E5       	
0BF1FF 98 8D 86 84 04 85 		db	098h,08Dh,086h,084h,004h,085h,084h,004h,09Fh,096h,084h,007h,0B7h,08Ch,0FFh
0BF205 84 04 9F 96 84 07 	
0BF20B B7 8C FF          	
0BF20E                   	
0BF20E                   	; --- messages --------------------------------------------------------------
0BF20E 50 4C 49 4E 4B 32 	msg_title:	db	'PLINK2 (PLINKC 1.62, D.Mizobata)',13,10
0BF214 20 28 50 4C 49 4E 	
0BF21A 4B 43 20 31 2E 36 	
0BF220 32 2C 20 44 2E 4D 	
0BF226 69 7A 6F 62 61 74 	
0BF22C 61 29 0D 0A       	
0BF230                   	btm_title:
0BF230 49 6E 73 74 61 6C 	msg_ins:	db	'Installed.',13,10
0BF236 6C 65 64 2E 0D 0A 	
0BF23C                   	btm_ins:
0BF23C 45 72 72 6F 72 3A 	msg_exi:	db	'Error: already exist.',13,10
0BF242 20 61 6C 72 65 61 	
0BF248 64 79 20 65 78 69 	
0BF24E 73 74 2E 0D 0A    	
0BF253                   	btm_exi:
0BF253 45 72 72 6F 72 3A 	msg_mem:	db	'Error: not enough memory.',13,10
0BF259 20 6E 6F 74 20 65 	
0BF25F 6E 6F 75 67 68 20 	
0BF265 6D 65 6D 6F 72 79 	
0BF26B 2E 0D 0A          	
0BF26E                   	btm_mem:
0BF26E 55 6E 69 6E 73 74 	msg_unin:	db	'Uninstalling '
0BF274 61 6C 6C 69 6E 67 	
0BF27A 20                	
0BF27B 50 4C 32 3A       		db	'PL2:'			; <= nom de device (termine par ':')
0BF27F 0D 0A             		db	13,10
0BF281                   	btm_unin:
0BF281 55 6E 69 6E 73 74 	msg_uok:	db	'Uninstalled. To free memory :',13,10
0BF287 61 6C 6C 65 64 2E 	
0BF28D 20 54 6F 20 66 72 	
0BF293 65 65 20 6D 65 6D 	
0BF299 6F 72 79 20 3A 0D 	
0BF29F 0A                	
0BF2A0 53 45 54 20 20 22 		db	'SET  "S1:'
0BF2A6 53 31 3A          	
0BF2A9 50 4C 49 4E 4B 32 		db	'PLINK2'		; <= nom de fichier (<= 8 caracteres)
0BF2AF 2E                		db	'.'
0BF2B0 53 59 53          		db	'SYS'			; <= extension
0BF2B3 22 2C 22 20 22 0D 		db	'"," "',13,10
0BF2B9 0A                	
0BF2BA 4B 49 4C 4C 20 22 		db	'KILL "S1:'
0BF2C0 53 31 3A          	
0BF2C3 50 4C 49 4E 4B 32 		db	'PLINK2'		; <= nom de fichier (<= 8 caracteres)
0BF2C9 2E                		db	'.'
