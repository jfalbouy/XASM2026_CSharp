0BF2EB                   	
0BF2EB                   		pre_off				; le CORPS a ses propres prebytes explicites (pre $30...)
0BF2EB                   	; ==========================================================================
0BF2EB                   	;  LE PILOTE RESIDENT  (copie en RAM par l'installateur)
0BF2EB                   	; ==========================================================================
0BF2EB                   	;----------------------------------------------------------------------
0BF2EB                   	;		En-tete du fichier d'en-tete de l'appareil
0BF2EB                   	;----------------------------------------------------------------------
0BF2EB                   	block_top:
0BF2EB FB                		db	blk_id			; signature de bloc de fichier
0BF2EC                   	_n83:
