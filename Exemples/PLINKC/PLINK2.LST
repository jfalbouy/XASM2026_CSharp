0BF263 2E 0D 0A          	
0BF266                   	btm_mem:
0BF266 55 6E 69 6E 73 74 	msg_unin:	db	'Uninstalling '
0BF26C 61 6C 6C 69 6E 67 	
0BF272 20                	
0BF273 50 4C 32 3A       		db	'PL2:'			; <= nom de device (termine par ':')
