0BF206                   	; --- messages --------------------------------------------------------------
0BF206 50 4C 49 4E 4B 32 	msg_title:	db	'PLINK2 (PLINKC 1.62, D.Mizobata)',13,10
0BF20C 20 28 50 4C 49 4E 	
