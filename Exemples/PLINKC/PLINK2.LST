0BF279                   	btm_unin:
0BF279 55 6E 69 6E 73 74 	msg_uok:	db	'Uninstalled. To free memory :',13,10
0BF27F 61 6C 6C 65 64 2E 	
0BF285 20 54 6F 20 66 72 	
0BF28B 65 65 20 6D 65 6D 	
0BF291 6F 72 79 20 3A 0D 	
0BF297 0A                	
0BF298 53 45 54 20 20 22 		db	'SET  "S1:'
0BF29E 53 31 3A          	
0BF2A1 50 4C 49 4E 4B 32 		db	'PLINK2'		; <= nom de fichier (<= 8 caracteres)
0BF2A7 2E                		db	'.'
0BF2A8 53 59 53          		db	'SYS'			; <= extension
0BF2AB 22 2C 22 20 22 0D 		db	'"," "',13,10
