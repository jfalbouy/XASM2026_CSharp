0BF2E9                   		pre_off				; le CORPS a ses propres prebytes explicites (pre $30...)
0BF2E9                   	; ==========================================================================
0BF2E9                   	;  LE PILOTE RESIDENT  (copie en RAM par l'installateur)
0BF2E9                   	; ==========================================================================
0BF2E9                   	;----------------------------------------------------------------------
0BF2E9                   	;		En-tete du fichier d'en-tete de l'appareil
