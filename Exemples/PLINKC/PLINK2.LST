0BF2C7 2E                		db	'.'
0BF2C8 53 59 53          		db	'SYS'			; <= extension
0BF2CB 22 2C 22 20 22 0D 		db	'"," "',13,10
0BF2D1 0A                	
0BF2D2 4B 49 4C 4C 20 22 		db	'KILL "S1:'
