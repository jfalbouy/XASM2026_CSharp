000000                   	; ==========================================================================
000000                   	;  PLINK2.asm - Pocket Link Cache Device Driver, portage sur le modele REGISTER3
000000                   	;
000000                   	;  Base : plinkc.native.asm (D. Mizobata 1.62, d'apres PLINK de N. Kon), dont le
000000                   	;  CORPS et la ZONE DE TRAVAIL sont repris VERBATIM (byte-identiques).
000000                   	;
000000                   	;  Nouveautes par rapport a PLINKC (comme REGISTER3 vis-a-vis de REGISTER2) :
000000                   	;    - Installation par 'CALL &BF000', desinstallation par 'CALL &BF000 "-u"'.
000000                   	;    - Installateur AJOUT-EN-FIN : le pilote est place APRES les blocs existants,
000000                   	;      sans les decaler -> aucun recalage des pointeurs BASIC (linkbas), donc plus
000000                   	;      de reset volontaire (bomb) ni de risque de corruption de BASIC.
000000                   	;    - Noms definis UNE SEULE FOIS (macros drvbase/drvext/drvdev).
000000                   	;    - La TABLE DE RELOCATION d'origine de PLINKC (60 sites, format delta) est
000000                   	;      REUTILISEE verbatim ; un seul octet est ajuste car le nom de device 'PL2:'
000000                   	;      fait 2 octets de plus que 'L:' (le delta site0->site1 passe de 3Dh a 3Fh).
000000                   	;    - Le pilote ne detourne la SIO que transitoirement (il la restaure a chaque
000000                   	;      appel, jump00) : au repos il ne tient AUCUN vecteur -> la desinstallation
000000                   	;      se limite au deliage de la chaine des devices.
000000                   	; ==========================================================================
000000                   	
0BF000                   		org	$bf000
0BF000                   		pre_on				; INDISPENSABLE : adressage RAM interne absolu.
0BF000                   	
0BF000                   	; --- constantes (reprises de plinkc.native.asm) ----------------------------
0BF000                   	fcs:			equ	$fffe4
0BF000                   	iocs:			equ	$fffe8
0BF000                   	iocs_fook:		equ	$bfca2
0BF000                   	sio_rcv_vct:	equ	$bfcd5
0BF000                   	sio_param:		equ	$bfd33
0BF000                   	base:			equ	$ec
0BF000                   	bx:				equ	$d4
0BF000                   	cx:				equ	$d6
0BF000                   	cl:				equ	$d6
0BF000                   	ch:				equ	$d7
0BF000                   	dx:				equ	$d8
0BF000                   	key_strobe_2:	equ	$f1
0BF000                   	sio_ctrl_reg:	equ	$f7
0BF000                   	sio_stat_reg:	equ	$f8
0BF000                   	sio_rx_reg:		equ	$f9
0BF000                   	sio_tx_reg:		equ	$fa
0BF000                   	intr_mask_reg:	equ	$fb
0BF000                   	system_stat_reg:equ	$ff
0BF000                   	
0BF000                   	btext:	equ	$cb
0BF000                   	bdata:	equ	$ce
0BF000                   	bpmax:	equ	$ca
0BF000                   	iwork:	equ	$e6
0BF000                   	keyvec:	equ	$bfc41
0BF000                   	s1top:	equ	$bfc15
0BF000                   	s1end:	equ	$bfcde
0BF000                   	cdrv:	equ	$bfc7d
0BF000                   	rev:	equ	$bfca1
0BF000                   	iroot:	equ	$bfca2
0BF000                   	bworkp:	equ	$bfd0e
0BF000                   	
0BF000                   	sectsiz:	equ	128
0BF000                   	cache_sect:	equ	sectsiz+1
0BF000                   	cache_next:	equ	cache_sect+2
0BF000                   	cache_size:	equ	cache_next+3
0BF000                   	n_fcache:	equ	7		;	Nombre de secteurs dans le cache FAT
0BF000                   	n_dcache:	equ	1		;	Nombre de secteurs dans le cache de donnees
0BF000                   	dtop:		equ	44
0BF000                   	timeout:	equ	40000		; Delai d'attente (environ 1 seconde)
0BF000                   	blk_id:	equ	0fbh			; signature d'un bloc de fichier (ajout)
0BF000                   	
0BF000                   	; --- noms du pilote, definis UNE SEULE FOIS --------------------------------
0BF000                   	;  Nom de FICHIER (bloc) : 'name83' au format 8.3 de l'en-tete (8 car. completes
0BF000                   	;  d'espaces, sans point), 'namedot' au format des messages (base.ext).
0BF000                   	;  Nom de DEVICE (chaine IOCS) : en-tete + recherche de desinstallation.
0BF000                   	
0BF000                   	; ==========================================================================
0BF000                   	;  POINT D'ENTREE : install par 'CALL &BF000', desinstall par 'CALL &BF000 "-u"'
0BF000                   	; ==========================================================================
0BF000                   	start:
0BF000                   	;  Lire l'argument de CALL (entre GUILLEMETS, syntaxe BASIC). Le pointeur de
0BF000                   	;  ligne empile sur la pile U est RESTITUE avance a la sortie (protocole
0BF000                   	;  UUENCODE) pour que BASIC reprenne sans 'Syntax error'.
0BF000 3C                		popu	x
0BF001 30 CC 00 00       		mv	(0),0			; (0) = 0 : installer ; sinon : desinstaller
0BF005 90 24             	sc_arg:	mv	a,[x++]
0BF007 60 00             		cmp	a,0
0BF009 18 1B             		jrz	sc_done
0BF00B 60 0D             		cmp	a,0dh
0BF00D 18 17             		jrz	sc_done
0BF00F 60 2D             		cmp	a,'-'
0BF011 1B 0E             		jrnz	sc_arg
0BF013 90 04             		mv	a,[x]
0BF015 60 75             		cmp	a,'u'
0BF017 18 06             		jrz	sc_setu
0BF019 60 55             		cmp	a,'U'
0BF01B 18 02             		jrz	sc_setu
0BF01D 13 1A             		jr	sc_arg
0BF01F                   	sc_setu:
0BF01F 08 01             		mv	a,1
0BF021 30 A0 00          		mv	(0),a
0BF024 13 21             		jr	sc_arg
0BF026                   	sc_done:
0BF026 7C 04             		dec	x
0BF028 2C                		pushu	x
0BF029 30 80 00          		mv	a,(0)
0BF02C 60 00             		cmp	a,0
0BF02E 18 03             		jrz	install
0BF030 02 3C F1          		jp	uninstall
0BF033                   	
0BF033                   	; ==========================================================================
0BF033                   	;  INSTALLATEUR  (CALL &BF000) - modele AJOUT-EN-FIN
0BF033                   	; ==========================================================================
0BF033                   	install:
0BF033                   	;  (1) banniere
0BF033 0C 06 F2 0B       		mv	x,msg_title
0BF037 0D 22 00 00       		mv	y,btm_title-msg_title
0BF03B 30 CC D6 00       		mv	(cl),0
0BF03F 09 04             		mv	il,4
0BF041 05 E4 FF 0F       		callf	fcs
0BF045                   	
0BF045                   	;  (2) sauver l'ancienne tete de la chaine des devices dans notre 'lien suivant'
0BF045 8C A2 FC 0B       		mv	x,[iroot]
0BF049 AC 03 F3 0B       		mv	[ihead],x
0BF04D                   	
0BF04D                   	;  (3) numero de device : code en dur dans l'en-tete (devno). La recherche
0BF04D                   	;      dynamique via 'iocs il=1' (convention incertaine) est ecartee : elle
0BF04D                   	;      risquait une boucle infinie (figement). 10 est libre sur un systeme courant.
0BF04D                   	
0BF04D                   	;  (4) compacter S1: (regrouper l'espace libre en fin de zone)
0BF04D 30 CC D6 06       		mv	(cl),6
0BF051 30 CC D7 00       		mv	(ch),0
0BF055 0B 47 00          		mv	i,47h
0BF058 05 E8 FF 0F       		callf	iocs
0BF05C                   	
0BF05C                   	;  (5) parcourir les blocs : detecter un doublon, trouver la FIN (point d'ajout)
0BF05C 8C 15 FC 0B       		mv	x,[s1top]
0BF060 95 84 12          		mv	y,[x+12h]		; lead address -> premier bloc
0BF063 45 45             		add	x,y
0BF065 90 04             	walk:	mv	a,[x]
0BF067 60 FB             		cmp	a,blk_id
0BF069 1A 15             		jrnz	walk_end
0BF06B 0D E1 F2 0B       		mv	y,block_top		; comparer le nom (12 octets) au notre
0BF06F 09 0C             		mv	il,12
0BF071 2C                		pushu	x
0BF072 05 AC F1 0B       		callf	stricmp
0BF076 3C                		popu	x
0BF077 18 A5             		jrz	err_exist		; deja installe
0BF079 95 84 11          		mv	y,[x+11h]
0BF07C 45 45             		add	x,y
0BF07E 13 1B             		jr	walk
0BF080                   	walk_end:
0BF080 30 A4 0A          		mv	(10),x			; (10) = fin des blocs = destination
0BF083                   	
0BF083                   	;  (6) le CODE ne doit pas franchir la page de 64 Ko (appels internes 16 bits)
0BF083 0B E6 03          		mv	i,prgend-block_top
0BF086 30 82 0A          		mv	ba,(10)
0BF089 44 23             		add	ba,i
0BF08B 1C 9B             		jrc	err_mem			; debordement 16 bits -> refus
0BF08D                   	
0BF08D                   	;  (7) controle memoire : [s1end]-1 - fin_des_blocs >= taille du bloc (blen)
0BF08D 8D DE FC 0B       		mv	y,[s1end]
0BF091 7C 05             		dec	y
0BF093 4D 54             		sub	y,x
0BF095 30 A5 10          		mv	(16),y
0BF098 0D 22 09 00       		mv	y,blen
0BF09C 30 D7 05 10       		cmpp	(16),y
0BF0A0 1C 86             		jrc	err_mem
0BF0A2                   	
0BF0A2                   	;  (8) copier le CODE du pilote a la fin des blocs (la zone de travail suit,
0BF0A2                   	;      reservee mais non copiee)
0BF0A2 0B E6 03          		mv	i,prgend-block_top
0BF0A5 30 85 0A          		mv	y,(10)
0BF0A8 0C E1 F2 0B       		mv	x,block_top
0BF0AC                   	copy_lp:
0BF0AC 90 24             		mv	a,[x++]
0BF0AE B0 25             		mv	[y++],a
0BF0B0 7C 03             		dec	i
0BF0B2 1B 08             		jrnz	copy_lp
0BF0B4                   	
0BF0B4                   	;  (9) RELOCATION : appliquer au pilote COPIE la table de deltas d'origine de
0BF0B4                   	;      PLINKC. Chaque octet de la table avance un pointeur 'y' dans le pilote
0BF0B4                   	;      copie ; on corrige la valeur 3 octets pointee de (dest - block_top).
0BF0B4 B6 37             		mv	[--s],u			; sauver le pointeur de pile U
0BF0B6 0E C7 F1 0B       		mv	u,reloc_table		; u -> table de deltas
0BF0BA 30 84 0A          		mv	x,(10)			; dest
0BF0BD 0A 27 00          		mv	ba,rel_dev0-block_top	; offset du 1er site (0x27) depuis block_top
0BF0C0 45 42             		add	x,ba
0BF0C2 0A 06 02          		mv	ba,0206h		; 1er delta de la table (constante d'origine)
0BF0C5 4D 42             		sub	x,ba
0BF0C7 FD 54             		mv	y,x			; y = dest + (rel_dev0-block_top) - 0x206
0BF0C9 38                	rl:	popu	a			; a = octet de table (mv a,[u++])
0BF0CA 60 FF             		cmp	a,0ffh
0BF0CC 18 22             		jrz	rl_end
0BF0CE 70 7F             		and	a,7fh
0BF0D0 60 7E             		cmp	a,7eh
0BF0D2 1A 05             		jrnz	rl_short
0BF0D4 3A                		popu	ba			; delta long sur 2 octets
0BF0D5 45 52             		add	y,ba
0BF0D7 12 02             		jr	rl_corr
0BF0D9                   	rl_short:
0BF0D9 45 50             		add	y,a
0BF0DB                   	rl_corr:
0BF0DB 94 05             		mv	x,[y]			; valeur 3 octets a corriger
0BF0DD B5 37             		mv	[--s],y			; sauver le pointeur de table (u sert deja de lecteur)
0BF0DF 0D E1 F2 0B       		mv	y,block_top
0BF0E3 4D 45             		sub	x,y			; - base d'assemblage
0BF0E5 30 85 0A          		mv	y,(10)
0BF0E8 45 45             		add	x,y			; + base de destination
0BF0EA 95 27             		mv	y,[s++]			; restaurer le pointeur de table
0BF0EC B4 05             		mv	[y],x
0BF0EE 13 27             		jr	rl
0BF0F0                   	rl_end:
0BF0F0 96 27             		mv	u,[s++]			; restaurer le pointeur de pile U
0BF0F2                   	
0BF0F2                   	;  (10) chainer le nouveau device en tete de la liste IOCS
0BF0F2 30 84 0A          		mv	x,(10)
0BF0F5 0A 22 00          		mv	ba,iocs_header-block_top
0BF0F8 45 42             		add	x,ba
0BF0FA AC A2 FC 0B       		mv	[iroot],x		; racine -> notre en-tete IOCS (copie)
0BF0FE                   	
0BF0FE                   	;  (11) terminateur de la chaine des blocs, apres le bloc complet (dest+blen)
0BF0FE 30 84 0A          		mv	x,(10)
0BF101 0A 22 09          		mv	ba,blen
0BF104 45 42             		add	x,ba
0BF106 08 FF             		mv	a,0ffh
0BF108 B0 04             		mv	[x],a
0BF10A                   	
0BF10A                   	;  (12) l'init des parametres par 'iocs il=4' (comme PLINKC) FIGE la machine sur
0BF10A                   	;      l'emulateur (convention incertaine, 1er acces device). Ecartee : le device
0BF10A                   	;      est deja chaine (comme REGISTER3), le pilote s'initialise a la 1re commande.
0BF10A                   	
0BF10A                   	;  (13) succes
0BF10A 0C 28 F2 0B       		mv	x,msg_ins
0BF10E 0D 0C 00 00       		mv	y,btm_ins-msg_ins
0BF112 30 CC D6 00       		mv	(cl),0
0BF116 09 04             		mv	il,4
0BF118 05 E4 FF 0F       		callf	fcs
0BF11C 9F                		rc
0BF11D 07                		retf
0BF11E                   	
0BF11E                   	;  --- erreurs : message + rendre la main (carry), sans toucher a BASIC ---
0BF11E                   	err_exist:
0BF11E 0C 34 F2 0B       		mv	x,msg_exi
0BF122 0D 17 00 00       		mv	y,btm_exi-msg_exi
0BF126 12 08             		jr	exit_err
0BF128                   	err_mem:
0BF128 0C 4B F2 0B       		mv	x,msg_mem
0BF12C 0D 1B 00 00       		mv	y,btm_mem-msg_mem
0BF130                   	exit_err:
0BF130 30 CC D6 00       		mv	(cl),0
0BF134 09 04             		mv	il,4
0BF136 05 E4 FF 0F       		callf	fcs
0BF13A 97                		sc
0BF13B 07                		retf
0BF13C                   	
0BF13C                   	; ==========================================================================
0BF13C                   	;  DESINSTALLATEUR  (CALL &BF000 "-u")
0BF13C                   	; ==========================================================================
0BF13C                   	;  Le pilote ne tient aucun vecteur au repos -> deliage seul. Le bloc reste en
0BF13C                   	;  memoire (protege) ; l'utilisateur le libere par SET puis KILL (la ROM met a
0BF13C                   	;  jour le repertoire et recompacte).
0BF13C                   	uninstall:
0BF13C 0C 66 F2 0B       		mv	x,msg_unin
0BF140 0D 13 00 00       		mv	y,btm_unin-msg_unin
0BF144 30 CC D6 00       		mv	(cl),0
0BF148 09 04             		mv	il,4
0BF14A 05 E4 FF 0F       		callf	fcs
0BF14E 0D A2 FC 0B       		mv	y,iroot			; y = emplacement du pointeur vers l'en-tete courant
0BF152                   	un_find:
0BF152 94 05             		mv	x,[y]
0BF154 6C 04             		inc	x
0BF156 18 40             		jrz	un_notfound		; -1 : fin de chaine
0BF158 7C 04             		dec	x
0BF15A 30 A4 0A          		mv	(10),x			; en-tete courant
0BF15D 30 A5 0D          		mv	(13),y			; predecesseur
0BF160 09 08             		mv	il,8
0BF162 45 41             		add	x,il			; x = en-tete + 8 = nom de device
0BF164 0D DD F2 0B       		mv	y,drv_str
0BF168 09 04             		mv	il,4
0BF16A 05 AC F1 0B       		callf	stricmp
0BF16E 30 84 0A          		mv	x,(10)
0BF171 30 85 0D          		mv	y,(13)
0BF174 18 04             		jrz	un_found
0BF176 FD 54             		mv	y,x
0BF178 13 28             		jr	un_find
0BF17A                   	un_found:
0BF17A                   	;  delier : [predecesseur] = notre lien suivant
0BF17A 30 84 0A          		mv	x,(10)
0BF17D 94 04             		mv	x,[x]
0BF17F 30 85 0D          		mv	y,(13)
0BF182 B4 05             		mv	[y],x
0BF184 0C 79 F2 0B       		mv	x,msg_uok
0BF188 0D 4F 00 00       		mv	y,btm_uok-msg_uok
0BF18C 30 CC D6 00       		mv	(cl),0
0BF190 09 04             		mv	il,4
0BF192 05 E4 FF 0F       		callf	fcs
0BF196 9F                		rc
0BF197 07                		retf
0BF198                   	un_notfound:
0BF198 0C C8 F2 0B       		mv	x,msg_unf
0BF19C 0D 15 00 00       		mv	y,btm_unf-msg_unf
0BF1A0 30 CC D6 00       		mv	(cl),0
0BF1A4 09 04             		mv	il,4
0BF1A6 05 E4 FF 0F       		callf	fcs
0BF1AA 97                		sc
0BF1AB 07                		retf
0BF1AC                   	
0BF1AC                   	; --- helper : comparaison de chaine sur IL octets --------------------------
0BF1AC                   	stricmp:
0BF1AC 30 E0 24 00       		mv	(0),[x++]
0BF1B0 90 25             		mv	a,[y++]
0BF1B2 30 61 00 00       		cmp	(0),0
0BF1B6 18 0A             		jrz	stricmp1
0BF1B8 30 63 00          		cmp	(0),a
0BF1BB 1A 09             		jrnz	stricmp2
0BF1BD 7C 01             		dec	il
0BF1BF 1B 15             		jrnz	stricmp
0BF1C1 07                		retf
0BF1C2                   	stricmp1:
0BF1C2 30 63 00          		cmp	(0),a
0BF1C5 07                		retf
0BF1C6                   	stricmp2:
0BF1C6 07                		retf
0BF1C7                   	
0BF1C7                   	; --- table de relocation (deltas d'origine de PLINKC ; octet 3 : 3Dh->3Fh) -
0BF1C7                   	reloc_table:
0BF1C7 FE 06 02 BF 1E B9 		db	0FEh,006h,002h,0BFh,01Eh,0B9h,08Ah,085h,087h,004h,005h,004h,009h,005h,086h,00Eh
0BF1CD 8A 85 87 04 05 04 	
0BF1D3 09 05 86 0E       	
0BF1D7 07 03 0B 89 B2 0A 		db	007h,003h,00Bh,089h,0B2h,00Ah,08Bh,086h,084h,006h,08Bh,08Bh,09Eh,089h,00Eh,0A2h
0BF1DD 8B 86 84 06 8B 8B 	
0BF1E3 9E 89 0E A2       	
0BF1E7 89 0E 1D 16 05 05 		db	089h,00Eh,01Dh,016h,005h,005h,008h,009h,003h,015h,00Ch,005h,005h,004h,009h,0E5h
0BF1ED 08 09 03 15 0C 05 	
0BF1F3 05 04 09 E5       	
0BF1F7 98 8D 86 84 04 85 		db	098h,08Dh,086h,084h,004h,085h,084h,004h,09Fh,096h,084h,007h,0B7h,08Ch,0FFh
0BF1FD 84 04 9F 96 84 07 	
0BF203 B7 8C FF          	
