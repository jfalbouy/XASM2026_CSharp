0BF224 61 29 0D 0A       	
0BF228                   	btm_title:
0BF228 49 6E 73 74 61 6C 	msg_ins:	db	'Installed.',13,10
0BF22E 6C 65 64 2E 0D 0A 	
0BF234                   	btm_ins:
0BF234 45 72 72 6F 72 3A 	msg_exi:	db	'Error: already exist.',13,10
0BF23A 20 61 6C 72 65 61 	
0BF240 64 79 20 65 78 69 	
0BF246 73 74 2E 0D 0A    	
0BF24B                   	btm_exi:
0BF24B 45 72 72 6F 72 3A 	msg_mem:	db	'Error: not enough memory.',13,10
0BF251 20 6E 6F 74 20 65 	
